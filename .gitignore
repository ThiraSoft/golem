# Built binaries
/pocket-tts
/golem-cli
/golem-server
*.test

# Voice states. None ship with the repository: they belong to whoever published
# them, and the tests that want one skip when it is absent. pockettts/README.md
# says where to get one.
/testdata/voices/

# The reference recorders build against a local llama.cpp checkout.
/build/

# What the references record of the models themselves: activations, logits, and
# slabs of quantized weights. Those belong to whoever published the weights, not
# to this repository, and the scripts in ref/ write them back in one command
# each. Every test that reads them skips until they are there.
/testdata/gemma/layers/
/testdata/gemma/layers12/
/testdata/gemma/quants/
/testdata/gemma/window/
/testdata/gemma/vision/
/testdata/qwen/layers/
/testdata/qwen/long/
/testdata/qwen/layers_q4/
/testdata/layer0/
/testdata/pipeline/
/testdata/pipeline_en/

# The Mimi encoder fixtures, same rule as the others.
/testdata/encoder/

# Python bytecode from the reference scripts.
__pycache__/
