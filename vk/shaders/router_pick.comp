#version 450

// Eight experts of a hundred and twenty-eight, and what they weigh.
//
// By rank rather than by rounds: every lane holds one expert's logit and
// counts how many logits beat it, which is its place in the order. The eight
// lanes that count fewer than eight write themselves into that slot. A tie
// goes to the lower index — the count says so — so that two runs of the same
// model choose the same experts and a comparison against a recording means
// something. gemma/moe.go is the other copy.
//
// This kernel has been written three times and the first two were both the
// same mistake, which is worth leaving here. It ran the whole selection on one
// lane, with the chosen kept in a local array; a local array indexed by a
// variable does not live in registers, it lives in scratch, which is card
// memory, and eight passes over a hundred and twenty-eight numbers cost a
// hundred and ninety microseconds a block. Then it ran eight rounds of a
// tournament in shared memory, nine barriers each, and cost twenty-two. One
// pass and two barriers is what a hundred and twenty-eight numbers are worth.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly  buffer L  { float logits[]; };
layout(std430, binding = 1) readonly  buffer DS { float dscale[]; };  // one scalar per expert
layout(std430, binding = 2) writeonly buffer ID { int   ids[];    };
layout(std430, binding = 3) writeonly buffer CW { float cw[];     };  // weight times that scalar

layout(push_constant) uniform Push {
    uint n;
    uint experts;
    uint used;
    float eps;
    float scalar;
} p;

shared float sl[256];
shared int   chosen[32];
shared float se[32];

void main() {
    uint t = gl_LocalInvocationID.x;
    if (t < p.experts) sl[t] = logits[t];
    barrier();

    if (t < p.experts) {
        float mine = sl[t];
        uint rank = 0u;
        for (uint e = 0u; e < p.experts; e++) {
            if (sl[e] > mine || (sl[e] == mine && e < t)) rank++;
        }
        if (rank < p.used) {
            chosen[rank] = int(t);
            ids[rank] = int(t);
        }
    }
    barrier();

    // The softmax is over the chosen few alone, renormalized, and it is done
    // on eight lanes rather than one. The arithmetic would fit in a single
    // lane easily; the eight reads of the per-expert scale would not, because
    // they are eight scattered loads from card memory one after another, and
    // a lane waiting on eight of those in a row was the whole cost of this
    // kernel. The largest logit is subtracted first so that a large one does
    // not become an infinity on its way through the exponential.
    if (t < p.used) {
        se[t] = exp(sl[chosen[t]] - sl[chosen[0]]);
    }
    barrier();
    if (t < p.used) {
        float total = 0.0;
        for (uint k = 0u; k < p.used; k++) total += se[k];
        // llama.cpp applies the per-expert scale just before the routing
        // weight, so one multiplication does both.
        cw[t] = (se[t] / total) * dscale[chosen[t]];
    }
}
