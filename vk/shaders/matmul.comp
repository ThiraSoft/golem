#version 450
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_control_flow_attributes : enable

// y = W * X for one Q4_0 matrix against a batch of Q8_0 activations.
//
// shaders/matvec.comp is the same product for one column, and for a token that
// is the right shape: there is nothing to share, and the weights are read at
// the card's memory ceiling. It is the wrong shape for a prompt. Giving it
// eight columns instead of one takes the weight traffic down eightfold and
// leaves the kernel reading the activation fourteen times for every once it
// reads the weights — measured, that holds an eight-column pass at 144
// gigabytes a second where a four-column pass reaches 306.
//
// The number that governs it is how much arithmetic a thread does for each
// load it issues. One row by eight columns is eight products against nine
// loads. This kernel gives a thread TM rows by TN columns: TM*TN*8 products
// against TM*5 + TN*10 loads, which at four by four is two and a half times
// better and at eight by four is three and a half. llama.cpp's own Vulkan
// backend draws the same line — its mat-vec kernel stops at eight columns and
// a tiled product takes over above that, and on this architecture its mat-vec
// carries one row per thread exactly as ours does.
//
// So: a workgroup owns BM rows by COLUMNS columns of the answer. It walks the
// shared dimension in chunks of KSTEP blocks, staging both operands in shared
// memory, and each thread keeps its own TM by TN tile of the result in
// registers for the whole walk. Nothing is reduced across threads at the end,
// which is the other thing the mat-vec kernel spends: there, eight lanes split
// one row and fold their partial sums through shared memory.
//
// The weights are in the layout vk/mixture.go uploads: a row is all of its
// fp16 scales, then all of its nibbles. The activation is one column after
// another, its magnitudes then its scales then its corrections — the same
// buffers shaders/matvec.comp reads, so the two kernels could share a
// descriptor set and the caller pick between them by the width of the pass.
//
// **Nothing binds this yet, and here is what it measures.** On the Qwen3 4B's
// ffn_down, thirty-two columns a pass: 5.9 microseconds a column, against the
// eight-column mat-vec's 14 and the one-column mat-vec's 38. ffn_gate is 8.3.
// It got there in two steps, both of which are in the file now:
//
//   - **The operands are read sixteen bytes at a time.** The staging loops
//     used to issue one scalar load per uint, and that was the kernel's whole
//     cost: aliasing the bindings with uvec4 blocks took ffn_down from 9.4
//     microseconds a column to 7.0 and ffn_gate from 10.0 to 8.5, at an
//     unchanged tile. llama.cpp reads its own operands the same width.
//   - **The tile was then swept again**, because a kernel whose loads dominate
//     answers a sweep differently from one whose arithmetic does. The answer
//     moved from two rows by two columns over sixty-four rows and eight blocks
//     to **one by two over thirty-two rows and sixteen blocks**: fewer rows to
//     a workgroup, so twice as many workgroups, and a walk twice as long
//     between the barriers. That is another 7.0 to 5.9.
//
// What was ruled out on the way, so that it is not ruled out again:
//
//   - **Bank conflicts were real and are fixed.** A column of the activation
//     was KSTEP*8 uints, which at KSTEP four is thirty-two exactly — the bank
//     count — so every thread of a wave read one bank. Padding the strides by
//     one uint was worth 1.5x, from 24 to 36 gigabytes a second.
//   - **A bigger tile has never once won here.** Two by two beat four by four
//     before the wide loads and after them, and eight by four — llama.cpp's
//     own shape — is four times slower than one by two at every size measured.
//     On this card the product is not short of arithmetic to issue, it is
//     short of work in flight, and every row a thread takes on costs threads.
//   - **Removing half the kernel measures nothing.** Compiled without the
//     staging, the compute reads a loop-invariant shared array and the whole
//     walk is hoisted out; compiled without the compute, the staging is dead
//     and removed. Both report four hundred gigabytes a second and both are
//     lies.
//   - **BM and vk/matmul.go's matmulRows are one number in two places.** Left
//     disagreeing, the dispatch covers a fraction of the rows, the answer is
//     zero below it, and the benchmark reports the fraction as a speed-up.

#ifndef COLUMNS
#define COLUMNS 32
#endif

// The tile, as preprocessor arithmetic because the workgroup size has to be a
// literal. TM rows by TN columns to a thread, BM rows by COLUMNS to a group.
// Swept rather than reasoned to, twice — see the header. BM must equal
// vk/matmul.go's matmulRows.
#ifndef TM
#define TM     1
#endif
#ifndef TN
#define TN     2
#endif
#ifndef BM
#define BM     32
#endif
#ifndef KSTEP
#define KSTEP  16
#endif
#define COLTH  (COLUMNS / TN)
#define THREADS ((BM / TM) * COLTH)

const uint BN = COLUMNS;

// The strides of the staged operands, padded by one.
//
// Shared memory is thirty-two banks of four bytes, and two addresses a
// multiple of thirty-two apart are the same bank. A column of the activation
// is KSTEP*8 uints, which at KSTEP four is thirty-two exactly: every thread of
// a wave would read the same bank on every load, sixteen ways at once.
// Measured, that alone held this kernel at 24 gigabytes a second. One uint of
// padding makes the stride odd and spreads the wave over the banks.
#define SA_STRIDE (KSTEP * 4 + 1)
#define SB_STRIDE (KSTEP * 8 + 1)
#define SD_STRIDE (KSTEP + 1)

layout(local_size_x = THREADS) in;

layout(std430, binding = 0) readonly  buffer W  { uint  w[];   };
layout(std430, binding = 1) readonly  buffer AQ { uint  aq[];  };  // the activation, Q8_0

// The same two buffers seen sixteen bytes at a time.
//
// The staging loops below issue one scalar load per uint, which is what the
// kernel spends most of its time on; llama.cpp's own quantised product reads
// its operands a hundred and twenty-eight bits at a time and aliases the
// binding to do it. GLSL allows two blocks on one binding as long as the
// offsets line up, and both of ours do: a Q8_0 block of the activation is
// thirty-two bytes, and a row of weights is eighteen bytes a block, so the
// nibbles are sixteen-byte aligned whenever the block count is a multiple of
// eight. The kernel checks that at run time and keeps the scalar path for the
// shapes where it is not.
layout(std430, binding = 0) readonly  buffer W4  { uvec4 w4[];  };
layout(std430, binding = 1) readonly  buffer AQ4 { uvec4 aq4[]; };
layout(std430, binding = 2) readonly  buffer AS { float as_[]; };  // its scales, then its corrections
layout(std430, binding = 3) writeonly buffer Y  { float y[];   };

layout(push_constant) uniform Push {
    uint dim;   // outputs
    uint ffn;   // inputs
    uint used;  // one, and only here so that every kernel takes the same block
    uint act;   // the activation, which is spent before this kernel runs
} p;

// The staged operands. Ten kilobytes, which leaves a compute unit several
// workgroups.
shared uint  sa[BM * SA_STRIDE];        // the nibbles, four uints a block
shared float sad[BM * SD_STRIDE];       // the weight scales
shared uint  sb[COLUMNS * SB_STRIDE];   // the magnitudes, eight uints a block
shared float sbd[COLUMNS * SD_STRIDE];  // the activation scales
shared float sbc[COLUMNS * SD_STRIDE];  // its corrections, the scale times the sum, eight times over

void main() {
    uint t   = gl_LocalInvocationID.x;
    uint tr  = t / uint(COLTH);            // which TM rows this thread owns
    uint tc  = t % uint(COLTH);            // which TN columns
    uint row0 = gl_WorkGroupID.x * uint(BM);

    uint nb  = p.ffn >> 5;           // blocks of the shared dimension
    uint aw  = p.ffn >> 2;           // one column of the activation, in uints
    uint aw4 = aw >> 2;              // the same, in uvec4
    uint rowBytes = nb * 18u;
    // Sixteen-byte alignment of the nibbles, which is what lets the weights be
    // read as uvec4 as well.
    bool wide = (nb & 7u) == 0u;

    float acc[TM][TN];
    [[unroll]] for (uint r = 0u; r < TM; r++) {
        [[unroll]] for (uint c = 0u; c < TN; c++) acc[r][c] = 0.0;
    }

    for (uint kb = 0u; kb < nb; kb += uint(KSTEP)) {
        barrier();

        // The weights: BM rows by KSTEP blocks, nibbles then scale.
        if (wide) {
            // One load a block: the four uints of nibbles are one uvec4.
            for (uint idx = t; idx < BM * KSTEP; idx += uint(THREADS)) {
                uint r   = idx / KSTEP, k = idx & (KSTEP - 1u);
                uint row = row0 + r, b = kb + k;
                uvec4 q  = (row < p.dim && b < nb)
                        ? w4[(row * rowBytes + 2u * nb + 16u * b) >> 4]
                        : uvec4(0u);
                uint o = r * uint(SA_STRIDE) + k * 4u;
                sa[o] = q.x; sa[o + 1u] = q.y; sa[o + 2u] = q.z; sa[o + 3u] = q.w;
            }
        } else {
            for (uint idx = t; idx < BM * KSTEP * 4u; idx += uint(THREADS)) {
                uint rest = idx & (KSTEP * 4u - 1u);
                uint r    = idx / (KSTEP * 4u);
                uint k    = rest >> 2, u = rest & 3u;
                uint row  = row0 + r;
                uint b    = kb + k;
                sa[r * uint(SA_STRIDE) + k * 4u + u] = (row < p.dim && b < nb)
                        ? w[((row * rowBytes + 2u * nb + 16u * b) >> 2) + u]
                        : 0u;
            }
        }
        for (uint idx = t; idx < BM * KSTEP; idx += uint(THREADS)) {
            uint r   = idx / KSTEP, k = idx & (KSTEP - 1u);
            uint row = row0 + r, b = kb + k;
            if (row < p.dim && b < nb) {
                vec2 pair = unpackHalf2x16(w[(row * rowBytes + 2u * b) >> 2]);
                sad[r * uint(SD_STRIDE) + k] = pair[b & 1u];
            } else {
                sad[r * uint(SD_STRIDE) + k] = 0.0;
            }
        }

        // The activation: COLUMNS columns by KSTEP blocks.
        // Two loads a block: a Q8_0 block is thirty-two bytes and the columns
        // are contiguous, so every block is aligned whatever the shape.
        for (uint idx = t; idx < BN * KSTEP * 2u; idx += uint(THREADS)) {
            uint rest = idx & (KSTEP * 2u - 1u);
            uint c    = idx / (KSTEP * 2u);
            uint k    = rest >> 1, h = rest & 1u;
            uint b    = kb + k;
            uvec4 q   = (b < nb) ? aq4[c * aw4 + b * 2u + h] : uvec4(0u);
            uint o    = c * uint(SB_STRIDE) + k * 8u + h * 4u;
            sb[o] = q.x; sb[o + 1u] = q.y; sb[o + 2u] = q.z; sb[o + 3u] = q.w;
        }
        for (uint idx = t; idx < BN * KSTEP; idx += uint(THREADS)) {
            uint c = idx / KSTEP, k = idx & (KSTEP - 1u);
            uint b = kb + k;
            sbd[c * uint(SD_STRIDE) + k] = (b < nb) ? as_[c * 2u * nb + b] : 0.0;
            sbc[c * uint(SD_STRIDE) + k] = (b < nb) ? as_[c * 2u * nb + nb + b] : 0.0;
        }

        barrier();

        [[unroll]] for (uint k = 0u; k < KSTEP; k++) {
            // This thread's TM weight blocks, held while every column meets
            // them. That reuse is the whole point of the tile.
            uint  areg[TM][4];
            float ad[TM];
            [[unroll]] for (uint r = 0u; r < TM; r++) {
                uint row = tr * uint(TM) + r;
                ad[r] = sad[row * uint(SD_STRIDE) + k];
                [[unroll]] for (uint u = 0u; u < 4u; u++) {
                    areg[r][u] = sa[row * uint(SA_STRIDE) + k * 4u + u];
                }
            }

            [[unroll]] for (uint c = 0u; c < TN; c++) {
                uint col = tc * uint(TN) + c;
                uint breg[8];
                [[unroll]] for (uint u = 0u; u < 8u; u++) {
                    breg[u] = sb[col * uint(SB_STRIDE) + k * 8u + u];
                }
                float bd = sbd[col * uint(SD_STRIDE) + k], bc = sbc[col * uint(SD_STRIDE) + k];

                [[unroll]] for (uint r = 0u; r < TM; r++) {
                    int qsum = 0;
                    // Four products to an instruction. A Q4_0 word holds eight
                    // weights as nibbles, and a mask and a shift give four of
                    // them already sitting in the four bytes the dot product
                    // wants. The accumulator is integer and exact.
                    [[unroll]] for (uint u = 0u; u < 4u; u++) {
                        uint word = areg[r][u];
                        qsum = dotPacked4x8AccSatEXT(word & 0x0F0F0F0Fu,        int(breg[u]),      qsum);
                        qsum = dotPacked4x8AccSatEXT((word >> 4) & 0x0F0F0F0Fu, int(breg[u + 4u]), qsum);
                    }
                    // The nibble is the weight plus eight, and the correction
                    // the activation carries is eight times its scale times
                    // the sum of its quanta. ggml folds the two here, once a
                    // block, rather than carrying a second accumulator.
                    acc[r][c] += ad[r] * (float(qsum) * bd - bc);
                }
            }
        }
    }

    barrier();
    [[unroll]] for (uint r = 0u; r < TM; r++) {
        uint row = row0 + tr * TM + r;
        if (row >= p.dim) continue;
        [[unroll]] for (uint c = 0u; c < TN; c++) {
            y[(tc * TN + c) * p.dim + row] = acc[r][c];
        }
    }
}
