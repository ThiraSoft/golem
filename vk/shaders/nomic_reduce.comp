#version 450

// The second half of a product split along its shared dimension: each slice
// wrote its partial sums to its own stretch of the partial buffer, and this
// adds them in slice order, then the bias. In slice order, so that the answer
// does not depend on which slice finished first.

#define THREADS 256
layout(local_size_x = THREADS) in;

layout(std430, binding = 0) readonly  buffer PARTIAL { float partial[]; };
layout(std430, binding = 1) readonly  buffer PAR     { float par[];     };
layout(std430, binding = 2) writeonly buffer Y       { float y[];       };

layout(push_constant) uniform Push {
    uint count;    // rows times outputs, which is one slice's stretch
    uint outputs;
    uint slices;
    uint bias;     // where the bias starts in par, or ~0 for none
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.count) return;
    float v = 0.0;
    for (uint s = 0u; s < p.slices; s++) v += partial[s * p.count + i];
    y[i] = v + ((p.bias == ~0u) ? 0.0 : par[p.bias + i % p.outputs]);
}
