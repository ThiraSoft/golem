#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

// Whole rows in and out of the residual stream:
//
//   0  embed:  each position's row of the token embedding, fp16 in the
//              weights, widened into X
//   1  gather: the rows the host asked for out of X into OUT, so that what
//              crosses back is the few positions it scores and not the pass

#define THREADS 256
layout(local_size_x = THREADS) in;

layout(std430, binding = 0) readonly buffer W   { float16_t w[]; };
layout(std430, binding = 1) buffer X            { float x[];     };
layout(std430, binding = 2) readonly buffer IDX { uint idx[];    };
layout(std430, binding = 3) writeonly buffer OUT { float out_[]; };

layout(push_constant) uniform Push {
    uint count;  // rows times dim
    uint op;
    uint dim;
    uint base;   // embed: where the table starts in W; gather: where the rows start in IDX
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.count) return;
    uint t = i / p.dim, j = i % p.dim;
    if (p.op == 0u) {
        x[i] = float(w[p.base + idx[t] * p.dim + j]);
    } else {
        out_[i] = x[idx[p.base + t] * p.dim + j];
    }
}
