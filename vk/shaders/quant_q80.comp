#version 450
#extension GL_EXT_control_flow_attributes : enable

// The Q8_0 form of an activation that is already in floats, in the layout the
// quantized products read: a column's scales, then its corrections, and the
// magnitudes packed four to a word.
//
// shaders/norm.comp writes this beside a norm and shaders/swiglu_act.comp
// beside an activation, because both hold the values in registers when they
// are done with them. This one is for the activations nothing else was going
// to touch — the delta net's output, which reaches its projection as floats
// out of shaders/ssm_scan.comp and has no other reason to be walked again.
//
// A thread a block of thirty-two, which is what it quantizes.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly  buffer X  { float x[];   };
layout(std430, binding = 1) writeonly buffer AQ { uint  aq[];  };
layout(std430, binding = 2) writeonly buffer AS { float as_[]; };

layout(push_constant) uniform Push {
    uint n;       // values in one column, a multiple of thirty-two
    uint columns; // columns this pass carries
} p;

// floatToHalf is nn/half.go, bit for bit — a block's scale is a half, and the
// processor rounds it before it multiplies by it.
uint floatToHalf(float f) {
    uint bits     = floatBitsToUint(f);
    uint sign     = (bits >> 16) & 0x8000u;
    int  exponent = int((bits >> 23) & 0xFFu) - 127 + 15;
    uint mantissa = bits & 0x7FFFFFu;

    if ((bits & 0x7FFFFFFFu) == 0u) return sign;
    if (exponent >= 0x1F) {
        if ((bits & 0x7F800000u) == 0x7F800000u && mantissa != 0u) return sign | 0x7E00u;
        return sign | 0x7C00u;
    }
    if (exponent <= 0) {
        if (exponent < -10) return sign;
        mantissa = (mantissa | 0x800000u) >> (1 - exponent);
        uint round = (mantissa >> 12) & 1u;
        mantissa += 0x0FFFu + round;
        return sign | (mantissa >> 13);
    }
    uint round = (bits >> 12) & 1u;
    bits += 0x0FFFu + round;
    exponent = int((bits >> 23) & 0xFFu) - 127 + 15;
    mantissa = (bits >> 13) & 0x3FFu;
    if (exponent >= 0x1F) return sign | 0x7C00u;
    return sign | (uint(exponent) << 10) | mantissa;
}

float halfToFloat(uint u) { return unpackHalf2x16(u)[0]; }

int nearestInt(float f) {
    float sign = (f < 0.0) ? -1.0 : 1.0;
    return int(f + sign * 0.5);
}

void main() {
    uint nb = p.n >> 5;
    uint id = gl_GlobalInvocationID.x;
    if (id >= p.columns * nb) return;

    uint c    = id / nb;
    uint b    = id - c * nb;
    uint base = c * p.n + b * 32u;

    float peak = 0.0;
    [[unroll]] for (uint i = 0u; i < 32u; i++) peak = max(peak, abs(x[base + i]));

    float scale = 0.0;
    int   total = 0;
    uint  word[8];
    [[unroll]] for (uint u = 0u; u < 8u; u++) word[u] = 0u;

    if (peak > 0.0) {
        scale = halfToFloat(floatToHalf(peak / 127.0));
        float inverse = 127.0 / peak;
        [[unroll]] for (uint u = 0u; u < 8u; u++) {
            uint w = 0u;
            [[unroll]] for (uint m = 0u; m < 4u; m++) {
                int q = clamp(nearestInt(x[base + u * 4u + m] * inverse), -128, 127);
                total += q;
                w |= (uint(q) & 0xFFu) << (m * 8u);
            }
            word[u] = w;
        }
    }

    uint at = base >> 2;
    [[unroll]] for (uint u = 0u; u < 8u; u++) aq[at + u] = word[u];

    uint slot = c * 2u * nb + b;
    as_[slot]      = scale;
    as_[slot + nb] = 8.0 * scale * float(total);
}
