#version 450
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_integer_dot_product : require

// The first half of one expert: the fused gate-and-up projection, ggml's GELU,
// the elementwise product, and the Q8_0 quantization the second half wants.
//
// Gemma 4 stores gate and up as one matrix of twice the feed-forward width —
// the gate's rows first, the up's after — so the value at position i needs row
// i and row i+ffn. A workgroup takes thirty-two positions: half its teams
// compute the gate rows, half the up rows, and they meet in shared memory.
// That pairing is also what makes the quantization possible here rather than
// in a pass of its own, because a Q8_0 block is exactly those thirty-two
// values and the workgroup is holding all of them.
//
// The same kernel serves the shared branch of a mixture block, which is an
// ordinary gated feed forward: one expert, chosen by an identifier that is
// always zero, with the gate matrix and the up matrix concatenated on upload
// into the one matrix of twice the width this reads.
//
// COLUMNS is how many activations one pass answers. It is a compile-time
// constant, and shaders/matvec.comp says why: reading a weight once for eight
// columns instead of once for each is what makes a prompt eight times cheaper
// than eight tokens. The wide form is bound to the shared branch alone — an
// expert branch routes each position to its own eight matrices, so there is
// nothing to share between two of them.
//
// Eight threads to a row, striding the blocks.

#ifndef COLUMNS
#define COLUMNS 1
#endif

// LANES threads share an output row; sixty-four rows go to a workgroup, which
// is a block of thirty-two outputs of the gate and the same of the up. The two
// multiply to the workgroup. vk/matvecshape_test.go is the same question asked
// of the plain mat-vec.
// Sixteen, where every other kernel here says eight. Sixty-four rows and
// sixteen lanes is a workgroup of a thousand and twenty-four, which is the
// most a workgroup may be, and it measured 8.65 milliseconds a token against
// 8.49 on Qwen3-4B-Q4_K_M — this is the hottest kernel in the engine, a third
// of what a token spends, so two per cent of it is worth the line.
#ifndef LANES
#define LANES 16u
#endif

layout(local_size_x = 64 * LANES) in;

layout(std430, binding = 0) readonly  buffer W  { uint  w[];    };  // Q4_0, every expert
layout(std430, binding = 1) readonly  buffer XQ { uint  xq[];   };  // the input, Q8_0
layout(std430, binding = 2) readonly  buffer XS { float xs[];   };  // its scales, then its corrections
layout(std430, binding = 3) readonly  buffer ID { int   ids[];  };  // the chosen experts
layout(std430, binding = 4) readonly  buffer GT { float gelu[]; };  // ggml's table, 65536 entries
layout(std430, binding = 5) writeonly buffer AQ { uint  aq[];   };  // the activation, Q8_0
layout(std430, binding = 6) writeonly buffer AS { float as_[];  };  // its scales, then its corrections

layout(push_constant) uniform Push {
    uint dim;   // inputs to the projection
    uint ffn;   // outputs of it, per half
    uint used;  // how many experts this dispatch is for; one, for a shared branch
    uint act;   // 0: ggml's tabulated GELU; 1: SiLU, which is a swiglu's half
    uint col;   // the first column of the pass this dispatch answers
    uint split; // the tiled product's, and not read here
    uint cap;   // room in one expert's list of columns, where there is one
} p;

#define SRCCOL(k)  (p.col + (k))
#define OUTSLOT(k) e
#define ACTIVE(k)  true


shared float half_[64 * COLUMNS];
shared int   q32[32 * COLUMNS];

// floatToHalf is nn/half.go, bit for bit.
uint floatToHalf(float f) {
    uint bits     = floatBitsToUint(f);
    uint sign     = (bits >> 16) & 0x8000u;
    int  exponent = int((bits >> 23) & 0xFFu) - 127 + 15;
    uint mantissa = bits & 0x7FFFFFu;

    if ((bits & 0x7FFFFFFFu) == 0u) return sign;
    if (exponent >= 0x1F) {
        if ((bits & 0x7F800000u) == 0x7F800000u && mantissa != 0u) return sign | 0x7E00u;
        return sign | 0x7C00u;
    }
    if (exponent <= 0) {
        if (exponent < -10) return sign;
        mantissa = (mantissa | 0x800000u) >> (1 - exponent);
        uint round = (mantissa >> 12) & 1u;
        mantissa += 0x0FFFu + round;
        return sign | (mantissa >> 13);
    }
    uint round = (bits >> 12) & 1u;
    bits += 0x0FFFu + round;
    exponent = int((bits >> 23) & 0xFFu) - 127 + 15;
    mantissa = (bits >> 13) & 0x3FFu;
    if (exponent >= 0x1F) return sign | 0x7C00u;
    return sign | (uint(exponent) << 10) | mantissa;
}

float halfToFloat(uint u) {
    return unpackHalf2x16(u)[0];
}

int nearestInt(float f) {
    float sign = (f < 0.0) ? -1.0 : 1.0;
    return int(f + sign * 0.5);
}

#ifdef Q3K
// sbyte reads one signed byte of the weights, which is what a Q3_K group scale
// is once vk/split_q3k.go has unpacked it from six bits and taken thirty-two
// off. shaders/matvec.comp reads it the same way.
int sbyte(uint at) { return bitfieldExtract(int(w[at >> 2]), int((at & 3u) * 8u), 8); }
#endif

void lanePart(uint rowBase, uint lane, out float answer[COLUMNS]) {
    uint nb  = p.dim >> 5;
#ifdef Q3K
    // Q3_K is the one format here whose header is not two bytes a block:
    // sixteen signed scales and one fp16 to a superblock, then twelve bytes a
    // block of magnitudes on a word. vk/split_q3k.go writes it.
    uint nsb  = p.dim >> 8;
    uint magB = rowBase + 16u * nsb;
    uint nib  = rowBase + ((18u * nsb + 3u) & ~3u);
#else
    // Q4_0, Q4_K and Q8_0 all put their weights at the same offset: two bytes a
    // block of scales against sixteen a superblock of headers is the same count.
    uint nib = rowBase + 2u * nb;
#endif
    uint xw  = p.dim >> 2;   // one column of the input, in uints

    precise float s[COLUMNS];
    [[unroll]] for (uint k = 0u; k < COLUMNS; k++) s[k] = 0.0;

    for (uint b = lane; b < nb; b += LANES) {
#ifdef Q4K
        // vk/mixture.go's splitQ4_K left the superblock header at the front of
        // the row; shaders/matvec.comp reads it the same way and says why the
        // six bits are unpacked here rather than folded on the way over.
        uint hb = (rowBase + 16u * (b >> 3u)) >> 2u;
        vec2 dm = unpackHalf2x16(w[hb]);
        uint k0 = w[hb + 1u], k1 = w[hb + 2u], k2 = w[hb + 3u];
        uint sub = b & 7u;
        uint sc6, mn6;
        if (sub < 4u) {
            sc6 = bitfieldExtract(k0, int(8u * sub), 6);
            mn6 = bitfieldExtract(k1, int(8u * sub), 6);
        } else {
            uint jj = sub - 4u;
            sc6 = bitfieldExtract(k2, int(8u * jj), 4) | (bitfieldExtract(k0, int(8u * jj + 6u), 2) << 4u);
            mn6 = bitfieldExtract(k2, int(8u * jj + 4u), 4) | (bitfieldExtract(k1, int(8u * jj + 6u), 2) << 4u);
        }
        float ws = dm.x * float(sc6);
        float wm = dm.y * float(mn6);
#elif defined(Q3K)
        // Two scales a block of thirty-two, sixteen weights each, and neither
        // is a minimum: Q3_K is symmetric and its weights are recentred on
        // four. ws is the first sixteen's scale, wm the second sixteen's.
        uint sbi = b >> 3u;
        float dd = unpackHalf2x16(w[(magB + 2u * sbi) >> 2])[sbi & 1u];
        float ws = dd * float(sbyte(rowBase + 16u * sbi + 2u * (b & 7u)));
        float wm = dd * float(sbyte(rowBase + 16u * sbi + 2u * (b & 7u) + 1u));
#else
        vec2  pair = unpackHalf2x16(w[(rowBase + 2u * b) >> 2]);
        float ws   = pair[b & 1u];
#endif

#ifdef Q80
        // Thirty-two signed bytes to a block, against the activation's
        // thirty-two signed bytes: the packed dot takes them as they are. There
        // is no offset in a Q8_0 weight and so no second term — see splitQ6_K's
        // note in vk/mixture.go, which is the same observation from the other
        // side of a K-quant.
        uint at = (nib + 32u * b) >> 2;
        [[unroll]] for (uint k = 0u; k < COLUMNS; k++) {
            uint xc = SRCCOL(k) * xw + b * 8u;
            int acc = 0;
            [[unroll]] for (uint u = 0u; u < 8u; u++) {
                acc = dotPacked4x8AccSatEXT(int(w[at + u]), int(xq[xc + u]), acc);
            }
            s[k] += ws * float(acc) * xs[SRCCOL(k) * 2u * nb + b];
        }
#elif defined(Q3K)
        // Three loads a block: the low bit pairs of the first sixteen weights,
        // of the second sixteen, and the third bits of both. The spread is
        // shaders/matvec.comp's, four masked shifts at a time, because a
        // multiply carries between the shifted copies.
        uint at = (nib + 12u * b) >> 2;
        uint q0w = w[at], q1w = w[at + 1u], hw = w[at + 2u];
        uint ab = b * 8u;
        uint lo[4], hi[4];
        for (uint u = 0u; u < 4u; u++) {
            uint x0 = (q0w >> (8u * u)) & 0xFFu;
            uint x1 = (q1w >> (8u * u)) & 0xFFu;
            lo[u] = (x0 & 3u) | ((x0 & 12u) << 6u) | ((x0 & 48u) << 12u) | ((x0 & 192u) << 18u);
            hi[u] = (x1 & 3u) | ((x1 & 12u) << 6u) | ((x1 & 48u) << 12u) | ((x1 & 192u) << 18u);
            uint h0 = (hw >> (4u * u)) & 0xFu;
            uint h1 = (hw >> (16u + 4u * u)) & 0xFu;
            lo[u] |= ((h0 & 1u) | ((h0 & 2u) << 7u) | ((h0 & 4u) << 14u) | ((h0 & 8u) << 21u)) * 4u;
            hi[u] |= ((h1 & 1u) | ((h1 & 2u) << 7u) | ((h1 & 4u) << 14u) | ((h1 & 8u) << 21u)) * 4u;
        }
        [[unroll]] for (uint k = 0u; k < COLUMNS; k++) {
            uint xc = SRCCOL(k) * xw + ab;
            // Two halves, two scales, and the recentring by four paid as the
            // activation's own sum over each half — one more packed dot against
            // a vector of ones. The block's stored sum cannot serve: it covers
            // all thirty-two weights and the two halves carry different scales.
            int accLo = 0, accHi = 0, sumLo = 0, sumHi = 0;
            [[unroll]] for (uint u = 0u; u < 4u; u++) {
                int alo = int(xq[xc + u]), ahi = int(xq[xc + u + 4u]);
                accLo = dotPacked4x8AccSatEXT(lo[u], alo, accLo);
                accHi = dotPacked4x8AccSatEXT(hi[u], ahi, accHi);
                sumLo = dotPacked4x8AccSatEXT(0x01010101, alo, sumLo);
                sumHi = dotPacked4x8AccSatEXT(0x01010101, ahi, sumHi);
            }
            uint sc = SRCCOL(k) * 2u * nb;
            s[k] += (float(accLo - 4 * sumLo) * ws + float(accHi - 4 * sumHi) * wm) * xs[sc + b];
        }
#else
        uint at = (nib + 16u * b) >> 2;
        uint ab = b * 8u;
        uint lo[4], hi[4];
        for (uint u = 0u; u < 4u; u++) {
            uint word = w[at + u];
            lo[u] = word & 0x0F0F0F0Fu;
            hi[u] = (word >> 4) & 0x0F0F0F0Fu;
        }
        [[unroll]] for (uint k = 0u; k < COLUMNS; k++) {
            uint xc = SRCCOL(k) * xw + ab;
            int acc = 0;
            [[unroll]] for (uint u = 0u; u < 4u; u++) {
                acc = dotPacked4x8AccSatEXT(lo[u], int(xq[xc + u]),      acc);
                acc = dotPacked4x8AccSatEXT(hi[u], int(xq[xc + u + 4u]), acc);
            }
            uint sc = SRCCOL(k) * 2u * nb;
#ifdef Q4K
            // A Q4_K weight is q times a scale less a minimum, with no offset
            // of eight, so the second term carries the minimum and an eighth of
            // the stored sum rather than the scale and the whole of it.
            s[k] += ws * float(acc) * xs[sc + b] - wm * xs[sc + nb + b] * 0.125;
#else
            s[k] += ws * (float(acc) * xs[sc + b] - xs[sc + nb + b]);
#endif
        }
#endif
    }
    [[unroll]] for (uint k = 0u; k < COLUMNS; k++) answer[k] = s[k];
}

void main() {
    uint blocks = p.ffn >> 5;              // Q8_0 blocks of output, per expert
    uint e      = gl_WorkGroupID.x / blocks;
    uint blk    = gl_WorkGroupID.x % blocks;

    uint t    = gl_LocalInvocationID.x;
    uint r    = t / LANES;                 // which of the sixty-four rows
    uint lane = t % LANES;
    uint j    = r & 31u;

    uint nb       = p.dim >> 5;
#ifdef Q80
    uint rowBytes = nb * 34u;
#elif defined(Q3K)
    uint rowBytes = (((p.dim >> 8) * 114u) + 3u) & ~3u;
#else
    uint rowBytes = nb * 18u;
#endif
    uint row      = (r < 32u) ? (blk * 32u + j) : (p.ffn + blk * 32u + j);
    uint n = COLUMNS;
    // Which expert this workgroup answers. An expert branch routes every
    // column for itself, so the identifiers are a column's eight at a time and
    // p.col says whose — a pass of a few columns runs this kernel once for
    // each of them rather than reading the whole stack by expert. The shared
    // branch has one expert and it is always zero, and takes the short index
    // so that its own ids buffer need be no longer than that.
    uint idAt = (p.used > 1u) ? (SRCCOL(0) * p.used + e) : e;
    uint expert = uint(ids[idAt]) * 2u * p.ffn * rowBytes;

    for (uint base = 0u; base < n; base += COLUMNS) {
        float part[COLUMNS];
        lanePart(expert + row * rowBytes, lane, part);

        for (uint k = 0u; k < COLUMNS; k++) {
            float sval = subgroupClusteredAdd(part[k], LANES);
            if (lane == 0u) half_[k * 64u + r] = sval;
        }
        barrier();

        for (uint i = t; i < 32u * COLUMNS; i += 64u * LANES) {
            uint k = i / 32u, j2 = i % 32u;
            float g = half_[k * 64u + j2];
            float a;
            if (p.act == 1u) {
                a = g / (1.0 + exp(-g));
            } else if (g <= -10.0) {
                a = 0.0;
            } else if (g >= 10.0) {
                a = g;
            } else {
                a = gelu[floatToHalf(g)];
            }
            half_[k * 64u + j2] = a * half_[k * 64u + 32u + j2];
        }
        barrier();

        for (uint k = t; k < COLUMNS; k += 64u * LANES) {
            uint hb = k * 64u;
            uint qb = k * 32u;
            float peak = 0.0;
            for (uint i = 0u; i < 32u; i++) peak = max(peak, abs(half_[hb + i]));

            float scale = 0.0;
            int   total = 0;
            if (peak > 0.0) {
                scale = halfToFloat(floatToHalf(peak / 127.0));
                float inverse = 127.0 / peak;
                for (uint i = 0u; i < 32u; i++) {
                    precise float scaled = half_[hb + i] * inverse;
                    int n = clamp(nearestInt(scaled), -128, 127);
                    q32[qb + i] = n;
                    total += n;
                }
            } else {
                for (uint i = 0u; i < 32u; i++) q32[qb + i] = 0;
            }

            if (!ACTIVE(k)) continue;
            uint at = (SRCCOL(k) * p.used * p.ffn + OUTSLOT(k) * p.ffn + blk * 32u) >> 2;
            for (uint u = 0u; u < 8u; u++) {
                uint word = 0u;
                for (uint m = 0u; m < 4u; m++) {
                    word |= (uint(q32[qb + u * 4u + m]) & 0xFFu) << (m * 8u);
                }
                aq[at + u] = word;
            }
            uint slot = SRCCOL(k) * 2u * p.used * blocks + OUTSLOT(k) * blocks + blk;
            as_[slot] = scale;
            as_[p.used * blocks + slot] = 8.0 * scale * float(total);
        }
        barrier();
    }
}
