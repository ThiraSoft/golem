#version 450
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_integer_dot_product : require

// The first half of one expert: the fused gate-and-up projection, ggml's GELU,
// the elementwise product, and the Q8_0 quantization the second half wants.
//
// Gemma 4 stores gate and up as one matrix of twice the feed-forward width —
// the gate's rows first, the up's after — so the value at position i needs row
// i and row i+ffn. A workgroup takes thirty-two positions: half its teams
// compute the gate rows, half the up rows, and they meet in shared memory.
// That pairing is also what makes the quantization possible here rather than
// in a pass of its own, because a Q8_0 block is exactly those thirty-two
// values and the workgroup is holding all of them.
//
// The same kernel serves the shared branch of a mixture block, which is an
// ordinary gated feed forward: one expert, chosen by an identifier that is
// always zero, with the gate matrix and the up matrix concatenated on upload
// into the one matrix of twice the width this reads.
//
// COLUMNS is how many activations one pass answers. It is a compile-time
// constant, and shaders/matvec.comp says why: reading a weight once for eight
// columns instead of once for each is what makes a prompt eight times cheaper
// than eight tokens. The wide form is bound to the shared branch alone — an
// expert branch routes each position to its own eight matrices, so there is
// nothing to share between two of them.
//
// Eight threads to a row, striding the blocks.

#ifndef COLUMNS
#define COLUMNS 1
#endif

layout(local_size_x = 512) in;   // sixty-four rows, eight lanes each

layout(std430, binding = 0) readonly  buffer W  { uint  w[];    };  // Q4_0, every expert
layout(std430, binding = 1) readonly  buffer XQ { uint  xq[];   };  // the input, Q8_0
layout(std430, binding = 2) readonly  buffer XS { float xs[];   };  // its scales, then its corrections
layout(std430, binding = 3) readonly  buffer ID { int   ids[];  };  // the chosen experts
layout(std430, binding = 4) readonly  buffer GT { float gelu[]; };  // ggml's table, 65536 entries
layout(std430, binding = 5) writeonly buffer AQ { uint  aq[];   };  // the activation, Q8_0
layout(std430, binding = 6) writeonly buffer AS { float as_[];  };  // its scales, then its corrections

layout(push_constant) uniform Push {
    uint dim;   // inputs to the projection
    uint ffn;   // outputs of it, per half
    uint used;  // how many experts this dispatch is for; one, for a shared branch
    uint act;   // 0: ggml's tabulated GELU; 1: SiLU, which is a swiglu's half
    uint col;   // the first column of the pass this dispatch answers
    uint split; // the tiled product's, and not read here
    uint cap;   // room in one expert's list of columns, where there is one
} p;

#define SRCCOL(k)  (p.col + (k))
#define OUTSLOT(k) e
#define ACTIVE(k)  true

const uint LANES = 8u;

shared float half_[64 * COLUMNS];
shared int   q32[32 * COLUMNS];

// floatToHalf is nn/half.go, bit for bit.
uint floatToHalf(float f) {
    uint bits     = floatBitsToUint(f);
    uint sign     = (bits >> 16) & 0x8000u;
    int  exponent = int((bits >> 23) & 0xFFu) - 127 + 15;
    uint mantissa = bits & 0x7FFFFFu;

    if ((bits & 0x7FFFFFFFu) == 0u) return sign;
    if (exponent >= 0x1F) {
        if ((bits & 0x7F800000u) == 0x7F800000u && mantissa != 0u) return sign | 0x7E00u;
        return sign | 0x7C00u;
    }
    if (exponent <= 0) {
        if (exponent < -10) return sign;
        mantissa = (mantissa | 0x800000u) >> (1 - exponent);
        uint round = (mantissa >> 12) & 1u;
        mantissa += 0x0FFFu + round;
        return sign | (mantissa >> 13);
    }
    uint round = (bits >> 12) & 1u;
    bits += 0x0FFFu + round;
    exponent = int((bits >> 23) & 0xFFu) - 127 + 15;
    mantissa = (bits >> 13) & 0x3FFu;
    if (exponent >= 0x1F) return sign | 0x7C00u;
    return sign | (uint(exponent) << 10) | mantissa;
}

float halfToFloat(uint u) {
    return unpackHalf2x16(u)[0];
}

int nearestInt(float f) {
    float sign = (f < 0.0) ? -1.0 : 1.0;
    return int(f + sign * 0.5);
}

void lanePart(uint rowBase, uint lane, out float answer[COLUMNS]) {
    uint nb  = p.dim >> 5;
    uint nib = rowBase + 2u * nb;
    uint xw  = p.dim >> 2;   // one column of the input, in uints

    precise float s[COLUMNS];
    [[unroll]] for (uint k = 0u; k < COLUMNS; k++) s[k] = 0.0;

    for (uint b = lane; b < nb; b += LANES) {
        vec2  pair = unpackHalf2x16(w[(rowBase + 2u * b) >> 2]);
        float ws   = pair[b & 1u];

        uint at = (nib + 16u * b) >> 2;
        uint ab = b * 8u;
        uint lo[4], hi[4];
        for (uint u = 0u; u < 4u; u++) {
            uint word = w[at + u];
            lo[u] = word & 0x0F0F0F0Fu;
            hi[u] = (word >> 4) & 0x0F0F0F0Fu;
        }
        [[unroll]] for (uint k = 0u; k < COLUMNS; k++) {
            uint xc = SRCCOL(k) * xw + ab;
            int acc = 0;
            [[unroll]] for (uint u = 0u; u < 4u; u++) {
                acc = dotPacked4x8AccSatEXT(lo[u], int(xq[xc + u]),      acc);
                acc = dotPacked4x8AccSatEXT(hi[u], int(xq[xc + u + 4u]), acc);
            }
            uint sc = SRCCOL(k) * 2u * nb;
            s[k] += ws * (float(acc) * xs[sc + b] - xs[sc + nb + b]);
        }
    }
    [[unroll]] for (uint k = 0u; k < COLUMNS; k++) answer[k] = s[k];
}

void main() {
    uint blocks = p.ffn >> 5;              // Q8_0 blocks of output, per expert
    uint e      = gl_WorkGroupID.x / blocks;
    uint blk    = gl_WorkGroupID.x % blocks;

    uint t    = gl_LocalInvocationID.x;
    uint r    = t / LANES;                 // which of the sixty-four rows
    uint lane = t % LANES;
    uint j    = r & 31u;

    uint nb       = p.dim >> 5;
    uint rowBytes = nb * 18u;
    uint row      = (r < 32u) ? (blk * 32u + j) : (p.ffn + blk * 32u + j);
    uint n = COLUMNS;
    uint expert = uint(ids[e]) * 2u * p.ffn * rowBytes;

    for (uint base = 0u; base < n; base += COLUMNS) {
        float part[COLUMNS];
        lanePart(expert + row * rowBytes, lane, part);

        for (uint k = 0u; k < COLUMNS; k++) {
            float sval = subgroupClusteredAdd(part[k], LANES);
            if (lane == 0u) half_[k * 64u + r] = sval;
        }
        barrier();

        for (uint i = t; i < 32u * COLUMNS; i += 512u) {
            uint k = i / 32u, j2 = i % 32u;
            float g = half_[k * 64u + j2];
            float a;
            if (p.act == 1u) {
                a = g / (1.0 + exp(-g));
            } else if (g <= -10.0) {
                a = 0.0;
            } else if (g >= 10.0) {
                a = g;
            } else {
                a = gelu[floatToHalf(g)];
            }
            half_[k * 64u + j2] = a * half_[k * 64u + 32u + j2];
        }
        barrier();

        for (uint k = t; k < COLUMNS; k += 512u) {
            uint hb = k * 64u;
            uint qb = k * 32u;
            float peak = 0.0;
            for (uint i = 0u; i < 32u; i++) peak = max(peak, abs(half_[hb + i]));

            float scale = 0.0;
            int   total = 0;
            if (peak > 0.0) {
                scale = halfToFloat(floatToHalf(peak / 127.0));
                float inverse = 127.0 / peak;
                for (uint i = 0u; i < 32u; i++) {
                    precise float scaled = half_[hb + i] * inverse;
                    int n = clamp(nearestInt(scaled), -128, 127);
                    q32[qb + i] = n;
                    total += n;
                }
            } else {
                for (uint i = 0u; i < 32u; i++) q32[qb + i] = 0;
            }

            if (!ACTIVE(k)) continue;
            uint at = (SRCCOL(k) * p.used * p.ffn + OUTSLOT(k) * p.ffn + blk * 32u) >> 2;
            for (uint u = 0u; u < 8u; u++) {
                uint word = 0u;
                for (uint m = 0u; m < 4u; m++) {
                    word |= (uint(q32[qb + u * 4u + m]) & 0xFFu) << (m * 8u);
                }
                aq[at + u] = word;
            }
            uint slot = SRCCOL(k) * 2u * p.used * blocks + OUTSLOT(k) * blocks + blk;
            as_[slot] = scale;
            as_[p.used * blocks + slot] = 8.0 * scale * float(total);
        }
        barrier();
    }
}
