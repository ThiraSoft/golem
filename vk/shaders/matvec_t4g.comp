#version 450
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_control_flow_attributes : enable

// y = W * x for a T4G matrix against float activations.
//
// A sequence is 128 weights: two eight-bit step codes, one per sixty-four, and
// 520 bits of trellis path. Expanding a weight is a twelve-bit window at bit
// offset 4t, a multiply, an add and a byte sum — and no codebook to look up at
// all, which is the whole reason this format exists.
//
// The row is two planes, steps then codes: a 67-byte block would start on an
// odd boundary and this reads words.
//
// At four bits the window is always two bytes and never three: every offset is
// a multiple of four bits, so a twelve-bit field starting at 4t has one of two
// alignments inside a byte pair, and the last weight of a sequence starts at
// bit 508 and ends at 519 — the sequence's last byte, not one past it. At three
// and five bits an offset lands on any bit of a byte, so the window can need
// three bytes; see the KBITS==3 and KBITS==5 branches below.
//
// The three-bit tier is also tail-biting: its path closes on itself, so weight
// t's window is bits [3t, 3t+12) modulo 384 and the last three weights of a
// sequence read a window that runs off the end and returns to bit zero. That is
// what buys the priming window back — 48 bytes against 50 — and the wrap costs
// two subtractions on the last of a half-block's eight groups.
//
// Workgroup: 128 threads -> 16 output rows, 8 lanes per row, which is
// matvec_d4g.comp's shape. COLUMNS is how many activations one reading of the
// weights answers.

#ifndef COLUMNS
#define COLUMNS 1
#endif

// KBITS is the tier: three bits, four, or five for the logit head. Only the
// window's arithmetic changes — at four bits every offset is a multiple of four
// so a window has two alignments and spans two bytes, and at three and five it
// has all eight and can span three. The unroll is over eight weights, which is
// where three and five bits both come back to a whole number of bytes:
// 8·3 = 24, 8·5 = 40.
#ifndef KBITS
#define KBITS 4
#endif

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly  buffer W { uint  w[]; };
// Binding 1 is the step grid: 256 floats, one per code, a kibibyte uploaded
// once and shared by every matrix of every model on the card.
//
// A kibibyte rather than an exp2, and not for speed. Go builds the grid with
// math.Exp2 in double and rounds; this card's exp2 lands one unit in the last
// place away from that for some codes, and a decoder that is one ULP from the
// processor's is a decoder that disagrees about what the file says. It is
// invisible in a product — the gap was 3e-7 of the output — and it is exactly
// the kind of invisible this format cannot afford, so the two sides read the
// same 256 numbers instead of each computing them.
layout(std430, binding = 1) readonly  buffer T { float steps[]; };
layout(std430, binding = 2) readonly  buffer X { float x[]; };
layout(std430, binding = 3) writeonly buffer Y { float y[]; };

layout(push_constant) uniform Push {
    uint dim; // outputs
    uint ffn; // inputs
    uint col; // the first column of the pass this dispatch answers
} p;

const uint LANES = 8u;
const uint OUTS  = 16u;
const uint SEQ   = 128u; // weights in one path
const uint BLOCK = 64u;  // weights sharing one step
#if KBITS == 5
const uint SEQB  = 81u;  // 127·5 + 12 = 647 bits, rounded up
const uint HALFB = 40u;  // bytes the first sixty-four weights of a path occupy
#elif KBITS == 3
const uint SEQB  = 48u;  // 128·3 = 384 bits, tail-biting, no priming window
const uint HALFB = 24u;  // 3·64 = 192 bits, which is byte 24 exactly
#else
const uint SEQB  = 65u;  // 127·4 + 12 = 520 bits exactly
const uint HALFB = 32u;
#endif

uint byteAt(uint at) { return (w[at >> 2u] >> ((at & 3u) * 8u)) & 0xFFu; }

// The 1MAD code of nn/t4g.go. It has to be these constants and this arithmetic:
// a decoder is a pure function of the bits it reads, so a shader that hashes a
// state differently is a second format sharing a name. Written as a multiply
// and not a division for the reason compress/trellis.go gives.
float t4gValue(uint s) {
    uint v = 34038481u * s + 76625530u;
    uint sum = (v & 0xffu) + ((v >> 8) & 0xffu) + ((v >> 16) & 0xffu) + ((v >> 24) & 0xffu);
    return (float(sum) - 510.0) * 0.00676589971;
}

void main() {
    uint row = gl_WorkGroupID.x * OUTS + (gl_LocalInvocationID.x / LANES);
    uint lane = gl_LocalInvocationID.x % LANES;
    bool live = row < p.dim;
    if (!live) row = 0u;

    uint nb  = p.ffn / BLOCK;         // step codes a row
    uint ns  = p.ffn / SEQ;           // paths a row
    uint rowBase  = row * (nb + ns * SEQB);
    uint codeBase = rowBase + nb;

    float sum[COLUMNS];
    [[unroll]] for (uint c = 0u; c < COLUMNS; c++) sum[c] = 0.0;

    for (uint b = lane; live && b < nb; b += LANES) {
        float step = steps[byteAt(rowBase + b)];
        // Which path this block is the first or second half of. A half is a
        // whole number of bytes in both tiers, which is why the block is 64
        // and not something the step would have to straddle.
#if KBITS == 3
        // The start of the whole path, not of its half: a wrapped window
        // returns to bit zero of the sequence, so the half-block offset is
        // folded into the group's own offset below.
        uint seqAt = codeBase + (b >> 1u) * SEQB;
        uint halfAt = (b & 1u) * HALFB;
#else
        uint seqAt = codeBase + (b >> 1u) * SEQB + (b & 1u) * HALFB;
#endif
        uint xOffset = b * BLOCK;

#if KBITS == 5
        // Eight weights, forty bits, six bytes read. Every offset inside the
        // group is a compile-time constant because 8·5 is a whole byte count,
        // so the shifts fold away and nothing branches.
        [[unroll]] for (uint g = 0u; g < BLOCK / 8u; g++) {
            uint o = seqAt + g * 5u;
            uint w0 = byteAt(o), w1 = byteAt(o + 1u), w2 = byteAt(o + 2u);
            uint w3 = byteAt(o + 3u), w4 = byteAt(o + 4u), w5 = byteAt(o + 5u);
            uint lo = (w0 << 24u) | (w1 << 16u) | (w2 << 8u) | w3;
            uint hi = (w4 << 8u) | w5;
            [[unroll]] for (uint i = 0u; i < 8u; i++) {
                // Bit 5i of a 48-bit window held as lo:hi.
                uint at = i * 5u;
                uint v;
                if (at + 12u <= 32u) {
                    v = (lo >> (32u - at - 12u)) & 0xFFFu;
                } else if (at >= 32u) {
                    v = (hi >> (16u - (at - 32u) - 12u)) & 0xFFFu;
                } else {
                    uint take = 32u - at;                 // bits still in lo
                    v = ((lo << (12u - take)) | (hi >> (16u - (12u - take)))) & 0xFFFu;
                }
                float wv = t4gValue(v) * step;
                [[unroll]] for (uint c = 0u; c < COLUMNS; c++) {
                    sum[c] += wv * x[(p.col + c) * p.ffn + xOffset + g * 8u + i];
                }
            }
        }
#elif KBITS == 3
        // Eight weights, twenty-four bits, five bytes read. 8·3 is a whole byte
        // count, so the shifts fold away and nothing branches — the wide tier's
        // trick at a narrower rate.
        [[unroll]] for (uint g = 0u; g < BLOCK / 8u; g++) {
            // Byte offsets inside the 48-byte path, so the last group's fourth
            // and fifth bytes can wrap to the start of the same sequence
            // instead of reading the next one's. Only the last group of the
            // second half-block ever does — a group covers bits [8o, 8o+40),
            // and 40 past byte 45 is 400 — and `g` is a compile-time constant
            // in an unrolled loop, so seven groups of eight compile with no
            // test at all and the eighth with one.
            uint o = halfAt + g * 3u;
            uint o3 = o + 3u, o4 = o + 4u;
            if (g == BLOCK / 8u - 1u && o3 >= SEQB) { o3 -= SEQB; o4 -= SEQB; }
            uint w0 = byteAt(seqAt + o), w1 = byteAt(seqAt + o + 1u), w2 = byteAt(seqAt + o + 2u);
            uint w3 = byteAt(seqAt + o3), w4 = byteAt(seqAt + o4);
            uint lo = (w0 << 24u) | (w1 << 16u) | (w2 << 8u) | w3;
            uint hi = w4;
            [[unroll]] for (uint i = 0u; i < 8u; i++) {
                uint at = i * 3u;
                uint v;
                if (at + 12u <= 32u) {
                    v = (lo >> (32u - at - 12u)) & 0xFFFu;
                } else {
                    uint take = 32u - at;                // bits still in lo
                    v = ((lo << (12u - take)) | (hi >> (8u - (12u - take)))) & 0xFFFu;
                }
                float wv = t4gValue(v) * step;
                [[unroll]] for (uint c = 0u; c < COLUMNS; c++) {
                    sum[c] += wv * x[(p.col + c) * p.ffn + xOffset + g * 8u + i];
                }
            }
        }
#else
        // Two weights a byte pair: the even one is the pair's top twelve bits,
        // the odd one its bottom twelve.
        [[unroll]] for (uint m = 0u; m < BLOCK / 2u; m++) {
            uint pair = (byteAt(seqAt + m) << 8u) | byteAt(seqAt + m + 1u);
            float a = t4gValue(pair >> 4u) * step;
            float e = t4gValue(pair & 0xFFFu) * step;
            [[unroll]] for (uint c = 0u; c < COLUMNS; c++) {
                uint xc = (p.col + c) * p.ffn + xOffset + m * 2u;
                sum[c] += a * x[xc] + e * x[xc + 1u];
            }
        }
#endif
    }

    [[unroll]] for (uint c = 0u; c < COLUMNS; c++) {
        float total = subgroupClusteredAdd(sum[c], LANES);
        if (lane == 0u && live) y[(p.col + c) * p.dim + row] = total;
    }
}
