#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require

// The end of a mixture block: three post-norms, the sum of the two branches,
// and the residual that puts it back in the stream.
//
// The three norms are why a mixture block is not a dense one with more
// matrices. Each branch is normed on its own, their sum is normed again, and
// only then does it rejoin. gemma/moe.go says what happens when the outer one
// is missing: every waypoint inside the block agrees to a millionth and only
// the block's output is wrong.
//
// Three norms read as three passes and there are only two here, because the
// first two do not depend on each other: one walk over both branches sums both
// their squares. A pass over this vector is not arithmetic, it is a wait —
// eleven kilobytes at a memory latency an iteration, on the one compute unit a
// single workgroup gets — so the passes are what this kernel costs and the
// count of them is the only thing worth tuning.

layout(local_size_x = 1024) in;

layout(std430, binding = 0) readonly  buffer SH { float shared_[]; };  // the dense branch
layout(std430, binding = 1) readonly  buffer EX { float experts[]; };  // the expert branch
layout(std430, binding = 2) readonly  buffer RS { float resid[];   };
layout(std430, binding = 3) readonly  buffer G1 { float g1[];      };  // post_ffw_norm_1
layout(std430, binding = 4) readonly  buffer G2 { float g2[];      };  // post_ffw_norm_2
layout(std430, binding = 5) readonly  buffer G3 { float g3[];      };  // post_ffw_norm
layout(std430, binding = 6) writeonly buffer XS { float xs[];      };

layout(push_constant) uniform Push {
    uint  n;
    float eps;
    float outScale;   // the one scalar the file carries per block
    uint  layout_;    // 0: a mixture's three post-norms; 1: a dense block's one;
                      // 2: none at all, which is an ordinary pre-norm block
} p;

const uint MAXN  = 4096u;
const uint LANES = 1024u;

shared float u[MAXN];
shared float w[MAXN];
shared float pa[LANES];
shared float pb[LANES];

// reduce2 sums two values across the workgroup at once, which is what the two
// independent norms want and costs one tree rather than two.
void reduce2(float a, float b, out float sa, out float sb) {
    uint t = gl_LocalInvocationID.x;
    pa[t] = a;
    pb[t] = b;
    barrier();
    for (uint stride = LANES >> 1; stride > 0u; stride >>= 1) {
        if (t < stride) {
            pa[t] += pa[t + stride];
            pb[t] += pb[t + stride];
        }
        barrier();
    }
    sa = pa[0];
    sb = pb[0];
}

void main() {
    uint t    = gl_LocalInvocationID.x;
    uint base = gl_WorkGroupID.y * p.n;   // the column is the second axis

    // A dense block has one branch and one post-norm. Running it through the
    // path below would norm the normed vector a second time — which RMS norm
    // very nearly forgives, and "very nearly" is not what a reference test is
    // for — and would read an expert branch that was never written.
    if (p.layout_ == 2u) {
        // A pre-norm block: the feed forward rejoins the residual with nothing
        // between them. qwen/block.go is the other copy.
        for (uint i = t; i < p.n; i += LANES) {
            xs[base + i] = (resid[base + i] + shared_[base + i]) * p.outScale;
        }
        return;
    }

    if (p.layout_ != 0u) {
        float q = 0.0;
        for (uint i = t; i < p.n; i += LANES) {
            float a = shared_[base + i];
            u[i] = a;
            q += a * a;
        }
        barrier();
        float tq, ignored;
        reduce2(q, 0.0, tq, ignored);
        float s = 1.0 / sqrt(tq / float(p.n) + p.eps);
        barrier();
        for (uint i = t; i < p.n; i += LANES) {
            xs[base + i] = (resid[base + i] + u[i] * s * g3[i]) * p.outScale;
        }
        return;
    }

    float qu = 0.0, qw = 0.0;
    for (uint i = t; i < p.n; i += LANES) {
        float a = shared_[base + i], b = experts[base + i];
        u[i] = a;
        w[i] = b;
        qu += a * a;
        qw += b * b;
    }
    barrier();
    float tu, tw;
    reduce2(qu, qw, tu, tw);
    float su = 1.0 / sqrt(tu / float(p.n) + p.eps);
    float sw = 1.0 / sqrt(tw / float(p.n) + p.eps);
    barrier();

    float qc = 0.0;
    for (uint i = t; i < p.n; i += LANES) {
        float x = u[i] * su * g1[i] + w[i] * sw * g2[i];
        u[i] = x;
        qc += x * x;
    }
    barrier();
    float tc, unused;
    reduce2(qc, 0.0, tc, unused);
    float sc = 1.0 / sqrt(tc / float(p.n) + p.eps);
    barrier();

    for (uint i = t; i < p.n; i += LANES) {
        xs[base + i] = (resid[base + i] + u[i] * sc * g3[i]) * p.outScale;
    }
}
