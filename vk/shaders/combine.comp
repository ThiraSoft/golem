#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require

// The end of a mixture block: three post-norms, the sum of the two branches,
// and the residual that puts it back in the stream.
//
// Subgroup wave-level reductions replace the 10-step shared memory binary tree.

layout(local_size_x = 1024) in;

layout(std430, binding = 0) readonly  buffer SH { float shared_[]; };  // the dense branch
layout(std430, binding = 1) readonly  buffer EX { float experts[]; };  // the expert branch
layout(std430, binding = 2) readonly  buffer RS { float resid[];   };
layout(std430, binding = 3) readonly  buffer G1 { float g1[];      };  // post_ffw_norm_1
layout(std430, binding = 4) readonly  buffer G2 { float g2[];      };  // post_ffw_norm_2
layout(std430, binding = 5) readonly  buffer G3 { float g3[];      };  // post_ffw_norm
layout(std430, binding = 6) writeonly buffer XS { float xs[];      };

layout(push_constant) uniform Push {
    uint  n;
    float eps;
    float outScale;   // the one scalar the file carries per block
    uint  layout_;    // 0: a mixture's three post-norms; 1: a dense block's one;
                      // 2: none at all, which is an ordinary pre-norm block
} p;

const uint MAXN  = 4096u;
const uint LANES = 1024u;

shared float u[MAXN];
shared float w[MAXN];
shared float partialA[32];
shared float partialB[32];

// reduce2 sums two values across the workgroup using subgroup arithmetic
void reduce2(float a, float b, out float sa, out float sb) {
    float fa = subgroupAdd(a);
    float fb = subgroupAdd(b);
    if (subgroupElect()) {
        partialA[gl_SubgroupID] = fa;
        partialB[gl_SubgroupID] = fb;
    }
    barrier();
    float sumA = 0.0, sumB = 0.0;
    for (uint i = 0u; i < gl_NumSubgroups; i++) {
        sumA += partialA[i];
        sumB += partialB[i];
    }
    sa = sumA;
    sb = sumB;
}

void main() {
    uint t    = gl_LocalInvocationID.x;
    uint base = gl_WorkGroupID.y * p.n;

    if (p.layout_ == 2u) {
        for (uint i = t; i < p.n; i += LANES) {
            xs[base + i] = (resid[base + i] + shared_[base + i]) * p.outScale;
        }
        return;
    }

    if (p.layout_ != 0u) {
        float q = 0.0;
        for (uint i = t; i < p.n; i += LANES) {
            float a = shared_[base + i];
            u[i] = a;
            q += a * a;
        }
        float tq, ignored;
        reduce2(q, 0.0, tq, ignored);
        float s = 1.0 / sqrt(tq / float(p.n) + p.eps);
        barrier();
        for (uint i = t; i < p.n; i += LANES) {
            xs[base + i] = (resid[base + i] + u[i] * s * g3[i]) * p.outScale;
        }
        return;
    }

    float qu = 0.0, qw = 0.0;
    for (uint i = t; i < p.n; i += LANES) {
        float a = shared_[base + i], b = experts[base + i];
        u[i] = a;
        w[i] = b;
        qu += a * a;
        qw += b * b;
    }
    float tu, tw;
    reduce2(qu, qw, tu, tw);
    float su = 1.0 / sqrt(tu / float(p.n) + p.eps);
    float sw = 1.0 / sqrt(tw / float(p.n) + p.eps);
    barrier();

    float qc = 0.0;
    for (uint i = t; i < p.n; i += LANES) {
        float x = u[i] * su * g1[i] + w[i] * sw * g2[i];
        u[i] = x;
        qc += x * x;
    }
    float tc, unused;
    reduce2(qc, 0.0, tc, unused);
    float sc = 1.0 / sqrt(tc / float(p.n) + p.eps);
    barrier();

    for (uint i = t; i < p.n; i += LANES) {
        xs[base + i] = (resid[base + i] + u[i] * sc * g3[i]) * p.outScale;
    }
}
