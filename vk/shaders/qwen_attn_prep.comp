#version 450
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// Qwen3.5 attention, everything that happens before the scores: the query and
// key norms, the rotation, and the write into the cache.
//
// The query projection carries the output gate interleaved with the queries,
// one 256-wide pair per head — [q0|g0][q1|g1]… — which is how llama.cpp views
// the same tensor (models/qwen35.cpp). So a query head begins at h*512, not at
// h*256, and the gate for that head begins 256 further on.
//
// The keys and values are written into the cache here rather than by the
// scores kernel, because a workgroup barrier does not order two workgroups: a
// head that reads the cache for this position has to be in a later dispatch
// than the head that wrote it, not merely a later line of the same shader.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly  buffer QIn    { float qIn[];    }; // [heads*512], per head [q|gate]
layout(std430, binding = 1) readonly  buffer KIn    { float kIn[];    }; // [kvHeads*256]
layout(std430, binding = 2) readonly  buffer VIn    { float vIn[];    }; // [kvHeads*256]
layout(std430, binding = 3) readonly  buffer QNorm  { float qNorm[];  }; // [256]
layout(std430, binding = 4) readonly  buffer KNorm  { float kNorm[];  }; // [256]
layout(std430, binding = 5) writeonly buffer QOut   { float qOut[];   }; // [heads*256]
// The caches, two halves to a uint. Sixteen bits a number and not thirty-two,
// which is what vk/attention.go's caches have always been and what llama.cpp
// holds its own in. On Qwen3.8-27B it is the difference between a checkpoint
// that stays on the card and one whose logit head the driver exiles to system
// memory: four key-value heads, two hundred and fifty-six dimensions, four
// thousand and ninety-six positions and sixteen attention blocks is five
// hundred and twelve megabytes in floats and half of that here.
layout(std430, binding = 6)           buffer KCache { uint kCache[]; };
layout(std430, binding = 7)           buffer VCache { uint vCache[]; };
// The position lives in a buffer rather than a push constant, so that the whole
// pass can be recorded once and replayed: laying down the command buffer again
// for every token cost 2.4 milliseconds of a 36-millisecond token, on the CPU,
// with the card waiting.
layout(std430, binding = 8) readonly buffer Pos { uint posv[]; };
// The rotation's axes, one uvec4 a column: t, h, w, and the axis a vision
// encoder would turn by. It is a second buffer rather than a widening of Pos,
// because Pos is the cache index and the two are not the same number — an
// image gives several columns one t while Pos goes on rising.
layout(std430, binding = 9) readonly buffer MPos { uvec4 mposv[]; };

layout(push_constant) uniform Push {
    uint maxContext;
    uint heads;      // 24
    uint kvHeads;    // 4
    float ropeBase;
    float eps;
    uint ropeDims;   // 64
    uint sect0;      // the M-RoPE section widths; all zero means none
    uint sect1;
    uint sect2;
    uint sect3;
} p;

// One workgroup a head, one column of the pass on the second axis. Every
// column's keys and values are in the cache before any of them is read, which
// is what lets the scores kernel be a dispatch of its own.
#define COL (gl_WorkGroupID.y)

shared float partial[8];
shared float invRMS;

// Which of the four axes pair `pair` turns by, and the position it reads.
//
// This is ggml_mrope_cache_init under GGML_ROPE_TYPE_IMROPE: the pairs take
// the axes in turn — t, h, w, t, h, w — each section stopping once it has had
// its share. The frequency is not part of the choice: pair i turns at
// base^(-2i/ropeDims) whichever axis it reads, which is what makes equal axes
// give exactly the scalar rotation rather than nearly.
//
// Sections that sum to zero mean a checkpoint that declares none, and take the
// cache index the way this shader always did.
float mropeAt(uint pair, uint scalarPos) {
    uint sect = p.sect0 + p.sect1 + p.sect2 + p.sect3;
    if (sect == 0u) return float(scalarPos);
    uvec4 mp = mposv[COL];
    uint sector = pair % sect;
    if      (sector % 3u == 1u && sector < 3u * p.sect1) return float(mp.y);
    else if (sector % 3u == 2u && sector < 3u * p.sect2) return float(mp.z);
    else if (sector % 3u == 0u && sector < 3u * p.sect0) return float(mp.x);
    else                                                 return float(mp.w);
}

// rotated is one dimension of a key or a query after the norm and the rotation.
// It is a function because a thread now answers two of them: the cache holds
// pairs of halves, so the even threads write and each needs its odd
// neighbour's number as well as its own. Recomputing it is three reads and a
// rotation, against a shared array and a barrier for the alternative.
float rotated(uint j, uint base, float inv, uint pos, uint half_) {
    float normed = qIn[base + j] * inv * qNorm[j];
    if (j >= p.ropeDims) return normed;
    uint pair = j % half_;
    float angle = mropeAt(pair, pos) * pow(p.ropeBase, -float(pair * 2u) / float(p.ropeDims));
    float cosA = cos(angle);
    float sinA = sin(angle);
    uint otherJ = (j < half_) ? (j + half_) : (j - half_);
    float other = qIn[base + otherJ] * inv * qNorm[otherJ];
    return (j < half_) ? (normed * cosA - other * sinA) : (other * sinA + normed * cosA);
}

// rotatedK is the same for a key, which reads the other two buffers. GLSL has
// no way to hand a function the buffer it should read, so this is the one
// duplication the change costs.
float rotatedK(uint j, uint base, float inv, uint pos, uint half_) {
    float normed = kIn[base + j] * inv * kNorm[j];
    if (j >= p.ropeDims) return normed;
    uint pair = j % half_;
    float angle = mropeAt(pair, pos) * pow(p.ropeBase, -float(pair * 2u) / float(p.ropeDims));
    float cosA = cos(angle);
    float sinA = sin(angle);
    uint otherJ = (j < half_) ? (j + half_) : (j - half_);
    float other = kIn[base + otherJ] * inv * kNorm[otherJ];
    return (j < half_) ? (normed * cosA - other * sinA) : (other * sinA + normed * cosA);
}

// rmsOf folds the squares of a 256-wide head across the workgroup.
float rmsOf(float val, float eps) {
    float folded = subgroupAdd(val * val);
    if (subgroupElect()) partial[gl_SubgroupID] = folded;
    barrier();
    float total = 0.0;
    for (uint s = 0u; s < gl_NumSubgroups; s++) total += partial[s];
    barrier();
    return inversesqrt(total / 256.0 + eps);
}

void main() {
    uint head = gl_WorkGroupID.x;
    uint j = gl_LocalInvocationID.x;
    uint half_ = p.ropeDims / 2u;
    uint pos = posv[COL];

    if (head < p.heads) {
        uint base = COL * p.heads * 512u + head * 512u; // this head's [q|gate] pair
        float inv = rmsOf(qIn[base + j], p.eps);
        // The queries stay floats: they are read once, by the kernel after
        // this one, and never held.
        qOut[COL * p.heads * 256u + head * 256u + j] = rotated(j, base, inv, pos, half_);
    } else {
        uint kv = head - p.heads;
        uint kBase = COL * p.kvHeads * 256u + kv * 256u;
        float inv = rmsOf(kIn[kBase + j], p.eps);
        // rmsOf has folded across the whole workgroup, so every thread has the
        // scale; from here the even ones do the writing, a pair each.
        if ((j & 1u) == 0u) {
            uint at = ((kv * p.maxContext + pos) * 256u + j) >> 1;
            kCache[at] = packHalf2x16(vec2(rotatedK(j, kBase, inv, pos, half_),
                                           rotatedK(j + 1u, kBase, inv, pos, half_)));
            vCache[at] = packHalf2x16(vec2(vIn[kBase + j], vIn[kBase + j + 1u]));
        }
    }
}
