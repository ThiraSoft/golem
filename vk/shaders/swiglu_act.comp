#version 450
// Pointwise SwiGLU activation: act = SiLU(gate) * up

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly  buffer Gate { float gate[]; };
layout(std430, binding = 1) readonly  buffer Up   { float up[];   };
layout(std430, binding = 2) writeonly buffer Act  { float act[];  };

layout(push_constant) uniform Push {
    uint n; // 17408
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;

    float g = gate[i];
    float u = up[i];
    float siluG = g / (1.0 + exp(-g));
    act[i] = siluG * u;
}
