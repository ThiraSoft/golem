#version 450
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_control_flow_attributes : enable

// The gated delta net recurrence, and nothing else.
//
// A head's state is a hundred and twenty-eight by a hundred and twenty-eight,
// and the recurrence over a column j of it —
//
//     u_j    = sum_i S[j][i] * k_i
//     d_j    = beta * (v_j - u_j)
//     S[j][i] = g * S[j][i] + k_i * d_j
//     y_j    = sum_i S[j][i] * q_i
//
// — touches no other column. A hundred and twenty-eight independent
// recurrences a head, forty-eight heads: six thousand one hundred and
// forty-four of them, and this kernel used to run them in **forty-eight
// workgroups** on a sixty-four compute unit card.
//
// What chained them was not the recurrence. It was the three normalisations
// that used to sit in this loop: the L2 norms of q and k, which are over the
// head's whole hundred and twenty-eight channels, and the gated RMS norm of y,
// which is over its hundred and twenty-eight outputs. Each of those couples
// every column to every other, so the kernel had to own all of them, and it
// paid six barriers and a hundred and twenty-eight shared loads a thread a
// token for the privilege — three thousand barriers over a pass of five
// hundred and twelve.
//
// They are shaders/ssm_qknorm.comp and shaders/ssm_gate.comp now, which is
// llama.cpp's own division and the thing four rewrites of this kernel missed.
// Three of them moved the recurrence around inside the old shape and measured
// nothing, which is the correct answer: the shape was the cost.
//
// What is left is llama.cpp's gated_delta_net.comp, and its arithmetic is the
// point. A lane holds sixteen entries of one state column in registers for the
// whole pass and never touches shared memory; eight lanes make a column and
// join with one clustered add. Sixteen fused multiply-adds to a reduction, and
// two reductions a token — where a workgroup a state column, which is the
// shape tried on 2026-08-28 and reverted, gives four multiply-adds to a
// thirty-two lane reduction and spends its time shuffling.
//
// A workgroup is COLS_PER_WG state columns of one head. The eight lanes of a
// column read the same q and k, and so do the other columns' lanes, so a
// workgroup's whole read of q and k is one broadcast a token.

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly  buffer ConvOut  { float convOut[];  }; // v, at 4096
layout(std430, binding = 1) readonly  buffer QKNorm   { float qk[];       }; // q at 0, k at 2048
layout(std430, binding = 2) readonly  buffer Alpha    { float alpha[];    };
layout(std430, binding = 3) readonly  buffer DTBias   { float dtBias[];   };
layout(std430, binding = 4) readonly  buffer SSMA     { float ssmA[];     };
layout(std430, binding = 5) readonly  buffer Beta     { float beta[];     };
layout(std430, binding = 6)           buffer SSMState { float ssmState[]; };
layout(std430, binding = 7) writeonly buffer Out      { float out_[];     };
// Where the state is copied aside when a pass carries a draft. The copy is
// taken here rather than by a transfer before the pass because the token in
// column zero is committed and the one in the last column is not: the state
// that has to survive a refusal is the one between them, and nothing outside
// this loop can see that moment.
layout(std430, binding = 8) writeonly buffer Shadow   { float shadow[];   };

layout(push_constant) uniform Push {
    uint numHeads;   // 48
    uint stateSize;  // 128
    float eps;
    float scale;     // 1 / sqrt(128)
    uint columns;    // tokens carried by this pass
    uint snapAt;     // the column at whose start to copy the state aside; ~0 for none
    uint convDim;    // the stride between one column's channels and the next
    uint inner;      // the stride of the output
    uint rank;       // the stride of alpha and beta
} p;

const uint LANES = 8u;               // lanes to a state column
const uint COLS  = 64u / LANES;      // state columns to a workgroup
const uint PER   = 128u / LANES;     // entries of a column to a lane

void main() {
    uint h    = gl_WorkGroupID.x;
    uint t    = gl_LocalInvocationID.x;
    uint lane = t % LANES;
    uint sub  = t / LANES;
    uint j    = gl_WorkGroupID.y * COLS + sub;   // the state column this lane group owns
    uint qkHead = h % 16u;

    uint base = h * 16384u + j * 128u;

    // The column's entries live in registers for the whole walk: read once at
    // the head of the pass and written once at the foot, where the state used
    // to move three mebibytes a head each way a token.
    float s[PER];
    [[unroll]] for (uint r = 0u; r < PER; r++) s[r] = ssmState[base + r * LANES + lane];

    for (uint col = 0u; col < p.columns; col++) {
        if (col == p.snapAt) {
            [[unroll]] for (uint r = 0u; r < PER; r++) shadow[base + r * LANES + lane] = s[r];
        }

        uint cr = col * p.rank;
        float alphaVal = alpha[cr + h] + dtBias[h];
        float softplusVal = (alphaVal > 20.0) ? alphaVal : log(1.0 + exp(alphaVal));
        float decay = exp(softplusVal * ssmA[h]);
        float betaVal = 1.0 / (1.0 + exp(-beta[cr + h]));

        uint qkBase = col * 4096u + qkHead * 128u;
        float kr[PER], qr[PER];
        [[unroll]] for (uint r = 0u; r < PER; r++) {
            uint i = r * LANES + lane;
            qr[r] = qk[qkBase + i];
            kr[r] = qk[qkBase + 2048u + i];
        }

        float u = 0.0;
        [[unroll]] for (uint r = 0u; r < PER; r++) u += s[r] * kr[r];
        u = subgroupClusteredAdd(u, LANES) * decay;

        float delta = (convOut[col * p.convDim + 4096u + h * 128u + j] - u) * betaVal;

        float y = 0.0;
        [[unroll]] for (uint r = 0u; r < PER; r++) {
            s[r] = s[r] * decay + kr[r] * delta;
            y += s[r] * qr[r];
        }
        y = subgroupClusteredAdd(y, LANES);

        if (lane == 0u) out_[col * p.inner + h * 128u + j] = y * p.scale;
    }

    [[unroll]] for (uint r = 0u; r < PER; r++) ssmState[base + r * LANES + lane] = s[r];
}
