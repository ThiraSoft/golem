#version 450

// A rectangle of every channel of one tensor into another, with an optional
// nearest-neighbour doubling of the source. It is crop, paste, concatenation
// and Upsample(scale_factor=2, mode="nearest"): four operations of the poser
// that move floats and compute nothing.

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Arena { float a[]; };
layout(std430, binding = 1) readonly buffer Weights { float w[]; };
layout(std430, binding = 2) readonly buffer Pose { float pose[]; };

layout(push_constant) uniform Push {
    uint src, srcW, srcY, srcX, srcPlane;
    uint dst, dstW, dstY, dstX, dstPlane;
    uint h, w, up;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.h * p.w) return;
    uint c = gl_WorkGroupID.y;
    uint y = i / p.w, x = i % p.w;
    a[p.dst + c * p.dstPlane + (p.dstY + y) * p.dstW + p.dstX + x] =
        a[p.src + c * p.srcPlane + (p.srcY + y / p.up) * p.srcW + p.srcX + x / p.up];
}
