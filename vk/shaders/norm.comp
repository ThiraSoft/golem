#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require

// The RMS norm, and the residual add that usually precedes it.
//
// One vector's worth of arithmetic, which is nothing beside a matrix — and
// that is exactly why it is here. As long as one of these stayed on the CPU
// the block had to come back across the bus to have it done, and a submission
// costs sixty-three microseconds whatever is in it. This kernel exists so that
// nothing crosses.
//
// It is written with flags rather than as four shaders because it is the same
// six lines four times: the attention's input norm, the post-attention norm,
// the residual add with the feed-forward norm on top of it, and the expert
// branch's own norm. What differs between them is which of the optional parts
// they want, and each is one bit.
//
// A workgroup takes one column, and a prompt dispatches one per position. The
// norm of a position depends on that position alone, so there is nothing to
// share between them and nothing to say about the batch beyond the offset.
//
// **And it is forty times slower than llama.cpp's, which is the largest thing
// in golem's prompt that is not a matrix product.** Their Vulkan build under
// GGML_VK_PERF_LOGGER, on the 12B at two hundred and fifty-six columns, says
// RMS_NORM_MUL of 3840 by 256 costs 13.5 microseconds. This kernel costs 563
// on the same shape, and there are three of these to a block: the profile of
// the pass gives 30 milliseconds to the attention norm, 31 to the post-norm
// and residual and 28 to the combine, which is eighty-nine of four hundred and
// two. Deleting the attention norm's dispatch outright takes the benchmark
// from 378 milliseconds to 351, so the profile is not lying about it.
//
// What that cost is not, each ruled out by measurement:
//
//   - **Not the arithmetic.** The sum of squares run four times over costs
//     exactly what it costs run once.
//   - **Not the reduction.** Replaced by a bare multiply, no change.
//   - **Not the quantised half.** With QUANT off the kernel still costs 30
//     milliseconds of the 33; the Q8_0 loop is the other three.
//   - **Not the residual's second operand.** The ternary in raw() reads b[]
//     for the norms that have no b, which is a small dummy buffer, and a
//     driver that turned it into a select rather than a branch would be
//     reading out of bounds on every load. Read unconditionally from a[], no
//     change.
//   - **Not the walk's memory-level parallelism.** p.n is a push constant so
//     the driver cannot unroll the loop, and llama.cpp's own rms_norm.comp
//     instantiates itself per dimension class precisely to get the unrolling.
//     Unrolled here by eight into registers, no change.
//   - **Not the workgroup size.** A thousand and twenty-four threads with a
//     sixteen-kilobyte staging array against two hundred and fifty-six with
//     none: the same, and the staging is what the second one gives up.
//   - **Not the shape of the grid.** Two hundred and fifty-six workgroups on
//     the y axis and one on x, which some schedulers walk badly. Swapped, no
//     change.
//   - **Not the barriers.** Three hundred and thirty-six extra ones added to
//     the pass cost nothing measurable.
//
// What it is, in every configuration measured, is a kernel moving memory at
// five to seven gigabytes a second on a card that gives six hundred and forty
// — and one whose cost scales with the columns, so it is work and not an
// overhead. Two hundred and fifty-six workgroups may simply be too small a
// dispatch to have enough loads outstanding, but the unrolling that should
// have tested that did not move it either. This is the open question.

layout(local_size_x = 1024) in;

layout(std430, binding = 0) readonly  buffer A  { float a[];      };
layout(std430, binding = 1) readonly  buffer B  { float b[];      };
layout(std430, binding = 2) readonly  buffer G  { float gain[];   };
layout(std430, binding = 3) readonly  buffer S  { float vscale[]; };
layout(std430, binding = 4) writeonly buffer SM { float sum[];    };  // the residual, before the norm
layout(std430, binding = 5) writeonly buffer Y  { float y[];      };
layout(std430, binding = 6) writeonly buffer YQ { uint  yq[];     };  // its Q8_0 magnitudes
layout(std430, binding = 7) writeonly buffer YS { float ys[];     };  // scales, then corrections

layout(push_constant) uniform Push {
    uint  n;
    uint  flags;
    float eps;
    float scalar;   // multiplies after the norm; one when there is none
} p;

// The column this workgroup carries, and the offsets into the buffers that
// hold one entry per column.
#define COL   (gl_WorkGroupID.y)
#define BASE  (COL * p.n)

const uint ADD    = 1u;   // the input is a + b rather than a
const uint SUM    = 2u;   // write that sum out, which is the block's residual
const uint GAIN   = 4u;
const uint VSCALE = 8u;
const uint FLOAT  = 16u;  // write the normed vector as floats
const uint QUANT  = 32u;  // write its Q8_0 form

// MAXN is the widest vector this binary norms, and it is the staging array's
// size. A model whose hidden state is wider needs the binary built with a
// larger one: Qwen3.5's 5120 does not fit the default, and overrunning a
// shared array is not a fault, it is a wrong answer.
#ifndef MAXN
#define MAXN 4096u
#endif

shared float v[MAXN];
// One partial a wave, not one a thread.
//
// A thousand and twenty-four threads folded through shared memory is ten
// steps and ten barriers, and a barrier here syncs sixteen waves on one
// compute unit. A wave folds its own sum in registers with no barrier at all,
// and what is left is sixteen numbers every thread can add up for itself.
shared float partial[32];

int nearestInt(float f) {
    return (floatBitsToInt(f + 12582912.0) & 0x007fffff) - 0x00400000;
}

// floatToHalf is nn/half.go, bit for bit. The Q8_0 scale is the fp16 the
// reference stored, and GLSL's packHalf2x16 is not the same function.
uint floatToHalf(float f) {
    uint bits     = floatBitsToUint(f);
    uint sign     = (bits >> 16) & 0x8000u;
    int  exponent = int((bits >> 23) & 0xFFu) - 127 + 15;
    uint mantissa = bits & 0x7FFFFFu;

    if ((bits & 0x7FFFFFFFu) == 0u) return sign;
    if (exponent >= 0x1F) {
        if ((bits & 0x7F800000u) == 0x7F800000u && mantissa != 0u) return sign | 0x7E00u;
        return sign | 0x7C00u;
    }
    if (exponent <= 0) {
        if (exponent < -10) return sign;
        mantissa |= 0x800000u;
        uint shift = uint(14 - exponent);
        uint value = mantissa >> shift;
        uint rest  = mantissa & ((1u << shift) - 1u);
        uint mid   = 1u << (shift - 1u);
        if (rest > mid || (rest == mid && (value & 1u) == 1u)) value++;
        return sign | value;
    }
    uint value = (uint(exponent) << 10) | (mantissa >> 13);
    uint rest  = mantissa & 0x1FFFu;
    if (rest > 0x1000u || (rest == 0x1000u && (value & 1u) == 1u)) value++;
    return sign | value;
}

void main() {
    uint t    = gl_LocalInvocationID.x;
    uint base = BASE;

    // The squares are summed in the same walk that loads the vector: a pass
    // over this vector is a memory latency an iteration on the one compute
    // unit a single workgroup gets, and the count of passes is what the kernel
    // costs. The reference sums them in float64 and this sums them in float32
    // through a tree, which is nearer float64 than a straight loop would be.
    float s = 0.0;
    for (uint i = t; i < p.n; i += 1024u) {
        float x = ((p.flags & ADD) != 0u) ? (a[base + i] + b[base + i]) : a[base + i];
        v[i] = x;
        if ((p.flags & SUM) != 0u) sum[base + i] = x;
        s += x * x;
    }
    float folded = subgroupAdd(s);
    if (subgroupElect()) partial[gl_SubgroupID] = folded;
    barrier();
    float whole = 0.0;
    for (uint i = 0u; i < gl_NumSubgroups; i++) whole += partial[i];
    float scale = 1.0 / sqrt(whole / float(p.n) + p.eps);

    for (uint i = t; i < p.n; i += 1024u) {
        float x = v[i] * scale;
        if ((p.flags & GAIN) != 0u)   x *= gain[i];
        if ((p.flags & VSCALE) != 0u) x *= vscale[i];
        x *= p.scalar;
        v[i] = x;
        if ((p.flags & FLOAT) != 0u) y[base + i] = x;
    }
    barrier();

    if ((p.flags & QUANT) == 0u) return;

    // The Q8_0 form, a block of thirty-two to a thread. nn/batch.go is the
    // other copy of this: the scale divides 127 by the peak rather than
    // inverting itself, halves round to even, and the scale the product uses
    // is the fp16 the reference would have stored.
    uint blocks = p.n >> 5;
    uint qbase  = COL * (p.n >> 2);   // the Q8_0 magnitudes, in uints
    uint sbase  = COL * 2u * blocks;  // its scales, then its corrections
    for (uint blk = t; blk < blocks; blk += 1024u) {
        uint at = blk << 5;
        float peak = 0.0;
        for (uint i = 0u; i < 32u; i++) peak = max(peak, abs(v[at + i]));

        float qscale = 0.0;
        int   total  = 0;
        if (peak > 0.0) {
            qscale = unpackHalf2x16(floatToHalf(peak / 127.0)).x;
            float inverse = 127.0 / peak;
            for (uint u = 0u; u < 8u; u++) {
                uint word = 0u;
                for (uint j = 0u; j < 4u; j++) {
                    // precise: nearestInt's magic constant only rounds
                    // correctly when the product has already been rounded to
                    // float32, and the compiler would fuse the two.
                    precise float scaled = v[at + u * 4u + j] * inverse;
                    int q = clamp(nearestInt(scaled), -128, 127);
                    total += q;
                    word |= (uint(q) & 0xFFu) << (j * 8u);
                }
                yq[qbase + (at >> 2) + u] = word;
            }
        } else {
            for (uint u = 0u; u < 8u; u++) yq[qbase + (at >> 2) + u] = 0u;
        }
        ys[sbase + blk]          = qscale;
        ys[sbase + blocks + blk] = 8.0 * qscale * float(total);
    }
}
