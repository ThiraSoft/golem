#version 450
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_clustered : require

// y = W * x for a Q6_K matrix against a Q8_K activation.
//
// This is nn/dot_q6_k.go: the six-bit magnitudes stay packed, multiply the
// activation as small integers, and the recentring by thirty-two comes out
// once per group of sixteen as a scale times the group's sum. The arithmetic
// is integer and the reduction order is fixed, so a row lands on the same
// float32 the CPU produced.
//
// The weights are not read in the layout the file stores. A Q6_K superblock is
// 210 bytes, which is not a multiple of four, and a shader indexing a uint
// array cannot afford a row stride that walks off alignment on every
// superblock. Q6KHead pads the superblock to 212 bytes on upload: the same 210
// bytes, then two that are never read. It costs one percent of the tensor and
// buys every load its alignment.
//
// The shape of the work follows from that alignment. A team of sixteen threads
// takes one row, and each thread takes four consecutive positions of a half —
// four positions being exactly one uint of low nibbles, one uint of high pairs
// and one uint of activation.
//
// Four things were tried and only one moved the number. Reading uints instead
// of single bytes: nothing. Cutting the barriers down to one reduction a row,
// at the cost of the integer exactness: nothing, so the exact form stays.
// Staging the activation in shared memory, since it is the same few kilobytes
// for every one of a quarter of a million rows: eight percent worse, the
// caches were already holding it. What did move it was giving each of the
// sixteen lanes its own group of the recentring instead of leaving lane zero
// to walk all sixteen while the others waited — 5.6 ms to 4.8 ms. The lesson
// is the usual one: the serial tail, not the parallel body.

layout(local_size_x = 64) in;   // four teams of sixteen

layout(std430, binding = 0) readonly  buffer W  { uint  w[];   };
layout(std430, binding = 1) readonly  buffer A  { uint  a[];   };
layout(std430, binding = 2) readonly  buffer AS { float asc[]; };
layout(std430, binding = 3) readonly  buffer BS { int   bsum[]; };
layout(std430, binding = 4) writeonly buffer Y  { float y[];   };

layout(push_constant) uniform Push {
    uint rows;
    uint superblocks;
} p;

const uint BYTES = 212u;   // one padded superblock
const uint TEAMS = 4u;     // teams to a workgroup


// wsbyte reads one signed byte of the weights, which is what a group scale is.
int wsbyte(uint b) { return bitfieldExtract(int(w[b >> 2]), int((b & 3u) * 8u), 8); }

void main() {
    uint t    = gl_LocalInvocationID.x;
    uint team = t >> 4;
    uint lane = t & 15u;

    uint upper = lane >> 3;          // which half of the superblock
    uint i0    = (lane & 7u) * 4u;   // the first of four positions in it
    uint group = i0 >> 4;            // which group of sixteen scales it

    for (uint row = gl_WorkGroupID.x * TEAMS + team; row < p.rows;
         row += gl_NumWorkGroups.x * TEAMS) {

        float total = 0.0;

        for (uint sb = 0u; sb < p.superblocks; sb++) {
            uint base = (row * p.superblocks + sb) * BYTES;

            uint wl0 = w[(base + upper * 64u + i0) >> 2];
            uint wl1 = w[(base + upper * 64u + 32u + i0) >> 2];
            uint wh  = w[(base + 128u + upper * 32u + i0) >> 2];

            uint sbase = base + 192u + upper * 8u + group;
            int s0 = wsbyte(sbase);
            int s1 = wsbyte(sbase + 2u);
            int s2 = wsbyte(sbase + 4u);
            int s3 = wsbyte(sbase + 6u);

            uint ab = sb * 64u + upper * 32u + (i0 >> 2);
            uint a0 = a[ab];
            uint a1 = a[ab + 8u];
            uint a2 = a[ab + 16u];
            uint a3 = a[ab + 24u];

            // Four positions at a time rather than one. The four six-bit
            // weights a group wants are four nibbles of one word and four
            // two-bit pairs of another, and a mask on each puts all four in
            // the four bytes the card's dot product reads — one instruction
            // for what was four multiplies and four adds. The group scales
            // differ, so there are four accumulators and not one; the
            // arithmetic is integer, and it is the same integer.
            const uint LOW  = 0x0F0F0F0Fu;
            const uint PAIR = 0x03030303u;
            int d0 = dotPacked4x8AccSatEXT((wl0 & LOW) | ((wh & PAIR) << 4),               int(a0), 0);
            int d1 = dotPacked4x8AccSatEXT((wl1 & LOW) | (((wh >> 2) & PAIR) << 4),        int(a1), 0);
            int d2 = dotPacked4x8AccSatEXT(((wl0 >> 4) & LOW) | (((wh >> 4) & PAIR) << 4), int(a2), 0);
            int d3 = dotPacked4x8AccSatEXT(((wl1 >> 4) & LOW) | (((wh >> 6) & PAIR) << 4), int(a3), 0);
            int sum = s0 * d0 + s1 * d1 + s2 * d2 + s3 * d3;

            // The recentring, which the CPU kernel folds group by group after
            // the fact: the weights were read shifted by thirty-two, so the
            // product owes 32 x scale x sum(q) for each group of sixteen.
            // There are sixteen groups and sixteen lanes, so each lane carries
            // its own into the reduction instead of one lane walking all of
            // them while the other fifteen wait.
            sum -= 32 * wsbyte(base + 192u + lane) * bsum[sb * 16u + lane];

            // The team's sixteen partials, folded in the wave rather than
            // through shared memory. What was here was partial[t] = sum and a
            // tree of four strides, each with a barrier, and a fifth barrier
            // after lane zero had read the result: five barriers a superblock,
            // fifty-five a row. And a barrier syncs the whole workgroup, so
            // every one of them stopped the other three teams, which are
            // walking different rows and have nothing to say to this one.
            //
            // The fold may move because the thing folded is an integer. The
            // dot products, the group scales and the recentring are all
            // integer arithmetic; addition over them is associative and exact,
            // so a cluster reduction lands on the same int the tree did. The
            // float that follows is unchanged: the same product, in the same
            // order, of the same int by the same two scales.
            int folded = subgroupClusteredAdd(sum, 16u);

            if (lane == 0u) {
                float d = unpackHalf2x16(w[(base >> 2) + 52u]).x;
                total += float(folded) * d * asc[sb];
            }
        }

        if (lane == 0u) y[row] = total;
    }
}
