#version 450
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_shader_subgroup_basic : require

// Krea 2's linear layers: Y[col][row] = scale · Σ W[row][k] X[col][k] + bias,
// every column a token. The tile is shaders/nomic_mm_big.comp's, a hundred and
// twenty-eight rows by a hundred and twenty-eight columns, four waves of
// sixty-four by sixty-four; what differs is the weight, which is fp8 e4m3 and
// is widened to fp16 on its way into shared memory.
//
// That widening is exact and costs two operations. An e4m3 byte's seven low
// bits, put at bit seven of a half, are the same number times 2^-8 — its
// exponent is four bits under a bias of seven, the half's five under fifteen,
// and a subnormal lands on a subnormal — so a multiply by 256 finishes it.
//
// Without FP8 (the VAE), the weight is fp16 already, eight halves a uvec4.
//
// The operand is float32 and is rounded to fp16 as it is staged, clamped to
// fp16's range: ComfyUI feeds these products bf16, whose range is float32's,
// and a value past 65504 would otherwise become infinite here and not there.
//
// MODE, in the push constants: 0 writes Y, 1 adds to Y, 2 adds to Y times a
// gate vector read from the arena (ga) plus one read from the parameters (gb),
// which is the DiT's gated residual.

#define THREADS 256
#define BM 128
#define BN 128
#define BK 32
#define SA (BK + 8)
#define ST 20

layout(local_size_x = THREADS) in;

layout(std430, binding = 0) readonly buffer W { uvec4 w[]; };
layout(std430, binding = 1) buffer A { float a[]; };
layout(std430, binding = 2) readonly buffer P { float par[]; };

layout(push_constant) uniform Push {
    uint outputs;   // rows of W, entries of a column of Y
    uint inputs;    // the shared dimension, a multiple of 32
    uint cols;
    uint wAt;       // W's first byte, a multiple of 16
    uint x;         // X in the arena, floats
    uint xStride;
    uint y;         // Y in the arena, floats
    uint yStride;
    uint bias;      // in the parameters; ~0 for none
    float scale;
    uint mode;
    uint ga;        // gate in the arena (mode 2)
    uint gb;        // gate in the parameters (mode 2)
} p;

shared float16_t sa[BM * SA];
shared float16_t sb[BN * SA];
shared float stage[4 * 16 * ST];

#ifdef FP8
// Two e4m3 bytes, the low two of v, as a pair of halves.
f16vec2 widen(uint v) {
    uint h = ((v & 0x80u) << 8) | ((v & 0x7Fu) << 7) | ((v & 0x8000u) << 16) | ((v & 0x7F00u) << 15);
    return unpackFloat2x16(h) * float16_t(256.0);
}
#endif

void main() {
    uint t = gl_LocalInvocationID.x;
    // The tiles run down the rows first, so that neighbouring workgroups read
    // the same columns of X; the grid may have a second axis when there are
    // more tiles than one axis holds.
    uint tiles = (p.outputs + uint(BM) - 1u) / uint(BM);
    uint tile = gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x;
    uint row0 = (tile % tiles) * uint(BM);
    uint col0 = (tile / tiles) * uint(BN);
    if (col0 >= p.cols) return;
    uint wave = gl_SubgroupID;
    uint lane = gl_SubgroupInvocationID;
    uint wr = (wave & 1u) * 64u, wc = (wave >> 1) * 64u;

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc[4][4];
    [[unroll]] for (uint i = 0u; i < 4u; i++) {
        [[unroll]] for (uint j = 0u; j < 4u; j++) {
            acc[i][j] = coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
        }
    }

    for (uint k0 = 0u; k0 < p.inputs; k0 += uint(BK)) {
#ifdef FP8
        // A hundred and twenty-eight rows of thirty-two bytes: two uvec4 a
        // row, one a thread.
        {
            uint r = t >> 1, q = (t & 1u) * 16u;
            uint srow = row0 + r;
            uvec4 v = uvec4(0u);
            if (srow < p.outputs) v = w[(p.wAt + srow * p.inputs + k0 + q) >> 4];
            uint at = r * uint(SA) + q;
            f16vec2 h;
            h = widen(v.x);       sa[at]       = h.x; sa[at + 1u]  = h.y;
            h = widen(v.x >> 16); sa[at + 2u]  = h.x; sa[at + 3u]  = h.y;
            h = widen(v.y);       sa[at + 4u]  = h.x; sa[at + 5u]  = h.y;
            h = widen(v.y >> 16); sa[at + 6u]  = h.x; sa[at + 7u]  = h.y;
            h = widen(v.z);       sa[at + 8u]  = h.x; sa[at + 9u]  = h.y;
            h = widen(v.z >> 16); sa[at + 10u] = h.x; sa[at + 11u] = h.y;
            h = widen(v.w);       sa[at + 12u] = h.x; sa[at + 13u] = h.y;
            h = widen(v.w >> 16); sa[at + 14u] = h.x; sa[at + 15u] = h.y;
        }
#else
        [[unroll]] for (uint i = 0u; i < 2u; i++) {
            uint e = t + i * uint(THREADS);
            uint r = e >> 2, q = (e & 3u) * 8u;
            uint srow = row0 + r;
            uvec4 v = uvec4(0u);
            if (srow < p.outputs) v = w[(p.wAt + (srow * p.inputs + k0 + q) * 2u) >> 4];
            f16vec2 c0 = unpackFloat2x16(v.x), c1 = unpackFloat2x16(v.y);
            f16vec2 c2 = unpackFloat2x16(v.z), c3 = unpackFloat2x16(v.w);
            uint at = r * uint(SA) + q;
            sa[at]      = c0.x; sa[at + 1u] = c0.y; sa[at + 2u] = c1.x; sa[at + 3u] = c1.y;
            sa[at + 4u] = c2.x; sa[at + 5u] = c2.y; sa[at + 6u] = c3.x; sa[at + 7u] = c3.y;
        }
#endif
        // A hundred and twenty-eight columns of thirty-two floats, four a
        // thread-load, four loads a thread.
        [[unroll]] for (uint i = 0u; i < 4u; i++) {
            uint e = t + i * uint(THREADS);
            uint c = e >> 3, q = (e & 7u) * 4u;
            uint scol = col0 + c;
            vec4 v = vec4(0.0);
            if (scol < p.cols) {
                uint at = p.x + scol * p.xStride + k0 + q;
                v = vec4(a[at], a[at + 1u], a[at + 2u], a[at + 3u]);
            }
            v = clamp(v, vec4(-65504.0), vec4(65504.0));
            uint at = c * uint(SA) + q;
            sb[at]      = float16_t(v.x); sb[at + 1u] = float16_t(v.y);
            sb[at + 2u] = float16_t(v.z); sb[at + 3u] = float16_t(v.w);
        }
        barrier();

        [[unroll]] for (uint kk = 0u; kk < uint(BK); kk += 16u) {
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ma[4];
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> mb[4];
            [[unroll]] for (uint i = 0u; i < 4u; i++) {
                coopMatLoad(ma[i], sa, (wr + i * 16u) * uint(SA) + kk, uint(SA), gl_CooperativeMatrixLayoutRowMajor);
                coopMatLoad(mb[i], sb, (wc + i * 16u) * uint(SA) + kk, uint(SA), gl_CooperativeMatrixLayoutColumnMajor);
            }
            [[unroll]] for (uint i = 0u; i < 4u; i++) {
                [[unroll]] for (uint j = 0u; j < 4u; j++) acc[i][j] = coopMatMulAdd(ma[i], mb[j], acc[i][j]);
            }
        }
        barrier();
    }

    uint mine = wave * 16u * uint(ST);
    [[unroll]] for (uint i = 0u; i < 4u; i++) {
        [[unroll]] for (uint j = 0u; j < 4u; j++) {
            coopMatStore(acc[i][j], stage, mine, uint(ST), gl_CooperativeMatrixLayoutRowMajor);
            subgroupMemoryBarrierShared();
            subgroupBarrier();
            [[unroll]] for (uint u = 0u; u < 4u; u++) {
                uint r = lane & 15u, c = (lane >> 4) + u * 4u;
                uint row = row0 + wr + i * 16u + r;
                uint col = col0 + wc + j * 16u + c;
                if (row < p.outputs && col < p.cols) {
                    float v = stage[mine + r * uint(ST) + c] * p.scale;
                    if (p.bias != ~0u) v += par[p.bias + row];
                    uint to = p.y + col * p.yStride + row;
                    if (p.mode == 0u) {
                        a[to] = v;
                    } else if (p.mode == 1u) {
                        a[to] += v;
                    } else {
                        a[to] += (a[p.ga + row] + par[p.gb + row]) * v;
                    }
                }
            }
            subgroupBarrier();
        }
    }
}
