#version 450
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_clustered : require

// y = W * x for one Q4_0 matrix against one Q8_0 activation, and for Q4_1 under
// -DQ41, Q4_K under -DQ4K, Q5_K under -DQ5K, Q6_K under -DQ6K, Q3_K under
// -DQ3K and Q2_K under -DQ2K.
//
// Seven formats and one kernel, because the difference between them is where a
// block's scale lives and how many instructions its magnitudes take to unpack —
// thirty lines out of a hundred and fifty, and nothing outside the staging.
// What they share is the whole of the arithmetic: a packed integer dot against
// the activation's eight-bit form, and one correction term for whatever offset
// the format carries. vk/quantproduct.go is the door.
//
// It is shaders/moe_down.comp with the mixture taken out, and it turned out to
// be the kernel most of the model wants: the down projection of a shared
// branch, and the four projections of an attention. Nothing about it knows
// which.
//
// A workgroup takes sixteen outputs with eight threads to each, which keeps
// the reason the mixture's shape has — a lane walks the blocks of its row
// eight at a time, so the eight of them read a hundred and twenty-eight
// contiguous bytes at once — and gives up the wide workgroup that came with
// it. Sixteen outputs give 128 threads to a workgroup.
//
// Clustered subgroup reduction across the 8 consecutive lanes of a row replaces
// the shared memory array and barriers.

#ifndef COLUMNS
#define COLUMNS 1
#endif

// LANES is how many threads share one output row and OUTS how many rows a
// workgroup answers. The two multiply to the workgroup, and the pair is a
// shape rather than a law: a lane reads LANES*16 contiguous bytes with its
// neighbours and carries COLUMNS accumulators in registers, so raising LANES
// buys coalescing and costs a wider reduction, and raising OUTS buys rows in
// flight and costs occupancy. vk/matvecshape_test.go sweeps them.
#ifndef LANES
#define LANES 8u
#endif
#ifndef OUTS
#define OUTS 16u
#endif

layout(local_size_x = LANES * OUTS) in;

layout(std430, binding = 0) readonly  buffer W  { uint  w[];   };
layout(std430, binding = 1) readonly  buffer AQ { uint  aq[];  };  // the activation, Q8_0
layout(std430, binding = 2) readonly  buffer AS { float as_[]; };  // its scales, then its corrections
layout(std430, binding = 3) writeonly buffer Y  { float y[];   };

layout(push_constant) uniform Push {
    uint dim;   // outputs
    uint ffn;   // inputs
    uint used;  // one, and only here so that every kernel takes the same block
    uint act;   // the activation, which is spent before this kernel runs
    uint col;   // the first column of the pass this dispatch answers
} p;


#if defined(Q6K) || defined(Q3K)
// sbyte reads one signed byte of the weights, which is what a Q6_K or a Q3_K
// group scale is: the quantizer writes them as int8 and the sign carries
// meaning. Q3_K's six bits are unpacked and recentred by vk/split_q3k.go, so by
// the time they are here the two formats hold the same thing.
int sbyte(uint at) { return bitfieldExtract(int(w[at >> 2]), int((at & 3u) * 8u), 8); }
#endif

#ifdef Q2K
// ubyte is sbyte for a format whose scales are not signed. A Q2_K byte holds a
// four-bit scale and a four-bit minimum, both unsigned and neither biased —
// this is the one K-quant here with no offset anywhere.
uint ubyte(uint at) { return bitfieldExtract(w[at >> 2], int((at & 3u) * 8u), 8); }
#endif

// RECENTRE is what a magnitude of this format is offset by: a Q6_K weight is
// its magnitude less thirty-two and a Q3_K weight its magnitude less four.
// Neither can be folded into the block's own scale, because the two halves of
// a block carry different ones — so it is paid as a dot against a vector of
// ones over each half.
#if defined(Q3K)
#define RECENTRE 4
#else
#define RECENTRE 32
#endif

// lanePart is one lane's share of a row against every column.
void lanePart(uint rowBase, uint lane, out float answer[COLUMNS]) {
    uint nb  = p.ffn >> 5;
    uint aw  = p.ffn >> 2;   // one column of the activation, in uints
#if defined(Q2K)
    // Sixteen scale-and-minimum bytes and an fp16 pair to a superblock, both
    // already a whole number of words, so nothing here is rounded.
    // vk/split_q2k.go writes it.
    uint nsb  = p.ffn >> 8;
    uint magB = rowBase + 16u * nsb;
    uint nib  = rowBase + 20u * nsb;
#elif defined(Q6K) || defined(Q3K)
    // The same header both formats have: sixteen signed group scales and one
    // fp16 to a superblock. vk/split_q3k.go and vk/mixture.go's splitQ6_K
    // write it, and q3kBlockBase and q6kBlockBase are the same arithmetic.
    uint nsb  = p.ffn >> 8;
    uint magB = rowBase + 16u * nsb;
    uint nib  = rowBase + ((18u * nsb + 3u) & ~3u);
#elif defined(Q5K)
    // vk/mixture.go's splitQ5_K: an fp16 pair a block, then a word of fifth
    // bits a block, then the nibbles.
    uint highB = rowBase + 4u * nb;
    uint nib   = rowBase + 8u * nb;
#elif defined(Q41)
    // splitQ4_1: the scale and the minimum of every block, then the nibbles.
    uint nib = rowBase + 4u * nb;
#else
    // Q4_0 and Q4_K put their nibbles at the same offset: the one spends two
    // bytes a block on scales, the other sixteen a superblock on headers, and
    // sixteen times nb over eight is two times nb.
    uint nib = rowBase + 2u * nb;
#endif

    precise float sum[COLUMNS];
    precise float corr[COLUMNS];
    for (uint c = 0u; c < COLUMNS; c++) { sum[c] = 0.0; corr[c] = 0.0; }

    for (uint b = lane; b < nb; b += LANES) {
#if defined(Q4K)
        // The superblock header vk/mixture.go's splitQ4_K left at the front of
        // the row: eight blocks share it, so a lane striding by eight reads the
        // same one every time.
        uint hb = (rowBase + 16u * (b >> 3u)) >> 2u;
        vec2 dm = unpackHalf2x16(w[hb]);
        uint s0 = w[hb + 1u], s1 = w[hb + 2u], s2 = w[hb + 3u];
        uint sub = b & 7u;
        uint sc6, mn6;
        if (sub < 4u) {
            sc6 = bitfieldExtract(s0, int(8u * sub), 6);
            mn6 = bitfieldExtract(s1, int(8u * sub), 6);
        } else {
            uint j = sub - 4u;
            sc6 = bitfieldExtract(s2, int(8u * j), 4) | (bitfieldExtract(s0, int(8u * j + 6u), 2) << 4u);
            mn6 = bitfieldExtract(s2, int(8u * j + 4u), 4) | (bitfieldExtract(s1, int(8u * j + 6u), 2) << 4u);
        }
        float ws = dm.x * float(sc6);
        float wm = dm.y * float(mn6);
#elif defined(Q2K)
        // Four numbers a block, where every other format here has two: each
        // half of a block carries its own scale *and* its own minimum, and the
        // two halves share nothing but the superblock's pair of fp16.
        uint sbi = b >> 3u;
        vec2 dm = unpackHalf2x16(w[(magB + 4u * sbi) >> 2]);
        uint scLo = ubyte(rowBase + 16u * sbi + 2u * (b & 7u));
        uint scHi = ubyte(rowBase + 16u * sbi + 2u * (b & 7u) + 1u);
        float wsLo = dm.x * float(scLo & 15u);
        float wsHi = dm.x * float(scHi & 15u);
        float wmLo = dm.y * float(scLo >> 4u);
        float wmHi = dm.y * float(scHi >> 4u);
#elif defined(Q6K) || defined(Q3K)
        // ws is the low sixteen weights' scale and wm the high sixteen's. They
        // are not a scale and a minimum here, whatever the names say elsewhere
        // in this kernel: both formats are symmetric and carry no minimum.
        uint sbi = b >> 3u;
        float dd = unpackHalf2x16(w[(magB + 2u * sbi) >> 2])[sbi & 1u];
        float ws = dd * float(sbyte(rowBase + 16u * sbi + 2u * (b & 7u)));
        float wm = dd * float(sbyte(rowBase + 16u * sbi + 2u * (b & 7u) + 1u));
#elif defined(Q41) || defined(Q5K)
        // Both carry an fp16 pair a block and are read the same way. Q4_1's is
        // the file's own; Q5_K's is d*sc and dmin*m already multiplied out,
        // which splitQ5_K does once on the way to the card.
        vec2  dm = unpackHalf2x16(w[(rowBase + 4u * b) >> 2]);
        float ws = dm.x;
        float wm = dm.y;
#else
        vec2  pair = unpackHalf2x16(w[(rowBase + 2u * b) >> 2]);
        float ws   = pair[b & 1u];
#endif

#ifdef Q80
        // Thirty-two signed bytes to a block against the activation's thirty-two,
        // which is what the packed dot takes without unpacking anything. A Q8_0
        // weight carries no offset, so there is no correction term — see
        // splitQ6_K's note in vk/mixture.go, which is the same observation from
        // the other side of a K-quant.
        uint at = (nib + 32u * b) >> 2;
        uint ab = b * 8u;
        for (uint c = 0u; c < COLUMNS; c++) {
            uint ac = (p.col + c) * aw + ab;
            int acc = 0;
            for (uint u = 0u; u < 8u; u++) {
                acc = dotPacked4x8AccSatEXT(int(w[at + u]), int(aq[ac + u]), acc);
            }
            sum[c] += ws * float(acc) * as_[(p.col + c) * 2u * nb + b];
        }
#elif defined(Q6K)
        uint at = (nib + 24u * b) >> 2;
        uint h0 = w[at], h1 = w[at + 1u];
        uint ab = b * 8u;
        uint lo[4], hi[4];
        for (uint u = 0u; u < 4u; u++) {
            uint word = w[at + 2u + u];
            // The two high bits a weight, spread one pair to a byte with four
            // masked shifts. A multiply and a mask does this for one bit and
            // not for two: the shifted copies overlap and the addition carries
            // into the next byte. shaders/matmul_coop.comp says the same.
            uint x0 = (h0 >> (8u * u)) & 0xFFu;
            uint x1 = (h1 >> (8u * u)) & 0xFFu;
            uint p0 = ((x0 & 3u) | ((x0 & 12u) << 6u) | ((x0 & 48u) << 12u) | ((x0 & 192u) << 18u)) * 16u;
            uint p1 = ((x1 & 3u) | ((x1 & 12u) << 6u) | ((x1 & 48u) << 12u) | ((x1 & 192u) << 18u)) * 16u;
            lo[u] = (word & 0x0F0F0F0Fu) | p0;
            hi[u] = ((word >> 4) & 0x0F0F0F0Fu) | p1;
        }
#elif defined(Q2K)
        // Two loads a block against the activation's eight, which is the
        // narrowest weight this kernel reads. The spread is Q3_K's without the
        // third bit: four weights a byte at bits 0, 2, 4 and 6, one to a byte
        // with four masked shifts, because a multiply carries between copies.
        uint at = (nib + 8u * b) >> 2;
        uint q0w = w[at], q1w = w[at + 1u];
        uint ab = b * 8u;
        uint lo[4], hi[4];
        for (uint u = 0u; u < 4u; u++) {
            uint x0 = (q0w >> (8u * u)) & 0xFFu;
            uint x1 = (q1w >> (8u * u)) & 0xFFu;
            lo[u] = (x0 & 3u) | ((x0 & 12u) << 6u) | ((x0 & 48u) << 12u) | ((x0 & 192u) << 18u);
            hi[u] = (x1 & 3u) | ((x1 & 12u) << 6u) | ((x1 & 48u) << 12u) | ((x1 & 192u) << 18u);
        }
#elif defined(Q3K)
        // Three loads a block against the activation's eight: a word of low
        // bit pairs for the first sixteen weights, a word for the second
        // sixteen, and a word of third bits. vk/split_q3k.go writes them.
        uint at = (nib + 12u * b) >> 2;
        uint q0w = w[at], q1w = w[at + 1u], hw = w[at + 2u];
        uint ab = b * 8u;
        uint lo[4], hi[4];
        for (uint u = 0u; u < 4u; u++) {
            // Four weights a byte at bits 0, 2, 4 and 6, spread one to a byte
            // with four masked shifts — Q6_K's pairs above, at the same offsets
            // and for the same reason: a multiply carries between the copies.
            uint x0 = (q0w >> (8u * u)) & 0xFFu;
            uint x1 = (q1w >> (8u * u)) & 0xFFu;
            lo[u] = (x0 & 3u) | ((x0 & 12u) << 6u) | ((x0 & 48u) << 12u) | ((x0 & 192u) << 18u);
            hi[u] = (x1 & 3u) | ((x1 & 12u) << 6u) | ((x1 & 48u) << 12u) | ((x1 & 192u) << 18u);
            // And the third bit, one to a weight, four of them a nibble of the
            // high word — spread the way Q5_K spreads its fifth bit, times four
            // rather than sixteen because it lands at bit 2 and not bit 4.
            uint h0 = (hw >> (4u * u)) & 0xFu;
            uint h1 = (hw >> (16u + 4u * u)) & 0xFu;
            lo[u] |= ((h0 & 1u) | ((h0 & 2u) << 7u) | ((h0 & 4u) << 14u) | ((h0 & 8u) << 21u)) * 4u;
            hi[u] |= ((h1 & 1u) | ((h1 & 2u) << 7u) | ((h1 & 4u) << 14u) | ((h1 & 8u) << 21u)) * 4u;
        }
#else
        uint at = (nib + 16u * b) >> 2;
        uint ab = b * 8u;
        uint lo[4], hi[4];
#ifdef Q5K
        // The fifth bits, one to a weight, all thirty-two in a word: bit l for
        // weight l, which is what splitQ5_K writes so that a reader takes one
        // load where the format made it take thirty-two. Four of them are
        // spread one to a byte with three masked shifts, the same way
        // shaders/matmul_coop.comp spreads Q6_K's pairs and for the same
        // reason — a multiply carries between the copies.
        uint hbw = w[(highB + 4u * b) >> 2];
#endif
        for (uint u = 0u; u < 4u; u++) {
            uint word = w[at + u];
            lo[u] = word & 0x0F0F0F0Fu;
            hi[u] = (word >> 4) & 0x0F0F0F0Fu;
#ifdef Q5K
            uint x0 = (hbw >> (4u * u)) & 0xFu;
            uint x1 = (hbw >> (16u + 4u * u)) & 0xFu;
            lo[u] |= ((x0 & 1u) | ((x0 & 2u) << 7u) | ((x0 & 4u) << 14u) | ((x0 & 8u) << 21u)) * 16u;
            hi[u] |= ((x1 & 1u) | ((x1 & 2u) << 7u) | ((x1 & 4u) << 14u) | ((x1 & 8u) << 21u)) * 16u;
#endif
        }
#endif
#ifndef Q80
        for (uint c = 0u; c < COLUMNS; c++) {
            uint ac = (p.col + c) * aw + ab;
            uint sc = (p.col + c) * 2u * nb;
#if defined(Q2K)
            // A weight is its magnitude times a scale less a minimum, and both
            // are a group's — so the block's stored activation sum is no use
            // here for the reason it is no use to Q6_K and Q3_K, and for one
            // more besides: it covers thirty-two weights where the minima
            // change every sixteen. Q4_K can use it and does, because there
            // one minimum covers the whole block.
            //
            // The sum over each half is the same packed dot against a vector
            // of ones the recentring formats already pay. What differs is only
            // what it is multiplied by.
            int accLo = 0, accHi = 0, sumLo = 0, sumHi = 0;
            for (uint u = 0u; u < 4u; u++) {
                int alo = int(aq[ac + u]), ahi = int(aq[ac + u + 4u]);
                accLo = dotPacked4x8AccSatEXT(lo[u], alo, accLo);
                accHi = dotPacked4x8AccSatEXT(hi[u], ahi, accHi);
                sumLo = dotPacked4x8AccSatEXT(0x01010101, alo, sumLo);
                sumHi = dotPacked4x8AccSatEXT(0x01010101, ahi, sumHi);
            }
            sum[c] += (float(accLo) * wsLo + float(accHi) * wsHi
                     - float(sumLo) * wmLo - float(sumHi) * wmHi) * as_[sc + b];
#elif defined(Q6K) || defined(Q3K)
            // Two scales to a block, sixteen weights each, and lo[] is exactly
            // the first sixteen — so the halves of the loop are the groups and
            // no regrouping is needed. That is true of Q3_K only because
            // vk/split_q3k.go made it true: in the file a block's two halves
            // come from two windows of qs sixteen bytes apart.
            //
            // The recentring, thirty-two here and four under -DQ3K, cannot be
            // folded into the block's stored correction the way Q4_0's eight
            // is, because the two halves carry different scales. It is the
            // activation's own sum over each half instead, which is one more
            // packed dot against a vector of ones — and a magnitude of nought
            // to sixty-three, or to seven, is a positive signed byte, so the
            // dot itself needs no other change.
            int accLo = 0, accHi = 0, sumLo = 0, sumHi = 0;
            for (uint u = 0u; u < 4u; u++) {
                int alo = int(aq[ac + u]), ahi = int(aq[ac + u + 4u]);
                accLo = dotPacked4x8AccSatEXT(lo[u], alo, accLo);
                accHi = dotPacked4x8AccSatEXT(hi[u], ahi, accHi);
                sumLo = dotPacked4x8AccSatEXT(0x01010101, alo, sumLo);
                sumHi = dotPacked4x8AccSatEXT(0x01010101, ahi, sumHi);
            }
            sum[c] += (float(accLo - RECENTRE * sumLo) * ws + float(accHi - RECENTRE * sumHi) * wm) * as_[sc + b];
#else
            int acc = 0;
            for (uint u = 0u; u < 4u; u++) {
                acc = dotPacked4x8AccSatEXT(lo[u], int(aq[ac + u]),      acc);
                acc = dotPacked4x8AccSatEXT(hi[u], int(aq[ac + u + 4u]), acc);
            }
            sum[c]  += float(acc) * ws * as_[sc + b];
#if defined(Q4K) || defined(Q5K)
            // A Q4_K or Q5_K weight is q times a scale less a minimum, with no
            // offset of eight, so the second term is the minimum times the
            // activation's own sum. golem stores that sum as eight times it,
            // which is what Q4_0's offset wanted.
            corr[c] += wm * as_[sc + nb + b] * 0.125;
#elif defined(Q41)
            // Q4_1 adds its minimum where the two K-quants subtract theirs, and
            // the answer below is sum less corr, so this one goes the other
            // way. It is the sign llama.cpp's own dequantiser has: d*q + m.
            corr[c] -= wm * as_[sc + nb + b] * 0.125;
#else
            corr[c] += ws * as_[sc + nb + b];
#endif
#endif
        }
#endif
    }
    for (uint c = 0u; c < COLUMNS; c++) answer[c] = sum[c] - corr[c];
}

void main() {
    uint t    = gl_LocalInvocationID.x;
    uint lane = t % LANES;
    uint i    = gl_WorkGroupID.x * OUTS + t / LANES;

#if defined(Q6K)
    uint rowBytes = (((p.ffn >> 8) * 210u) + 3u) & ~3u;
#elif defined(Q3K)
    // Eighteen bytes of superblock header and ninety-six of magnitudes, on a
    // word for the reason Q6_K's two hundred and ten is rounded.
    uint rowBytes = (((p.ffn >> 8) * 114u) + 3u) & ~3u;
#elif defined(Q2K)
    // Twenty bytes of header and sixty-four of magnitudes, which is the file's
    // own eighty-four and already a whole number of words.
    uint rowBytes = (p.ffn >> 8) * 84u;
#elif defined(Q5K)
    uint rowBytes = (p.ffn >> 5) * 24u;
#elif defined(Q41)
    uint rowBytes = (p.ffn >> 5) * 20u;
#elif defined(Q80)
    // Two bytes of scale and thirty-two of signed weights to a block.
    uint rowBytes = (p.ffn >> 5) * 34u;
#else
    uint rowBytes = (p.ffn >> 5) * 18u;
#endif
    float part[COLUMNS];
    if (i < p.dim) {
        lanePart(i * rowBytes, lane, part);
    } else {
        for (uint c = 0u; c < COLUMNS; c++) part[c] = 0.0;
    }
    for (uint c = 0u; c < COLUMNS; c++) {
        float sum = subgroupClusteredAdd(part[c], LANES);
        if (lane == 0u && i < p.dim) {
            y[(p.col + c) * p.dim + i] = sum;
        }
    }
}
