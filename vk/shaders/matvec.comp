#version 450
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_clustered : require

// y = W * x for one Q4_0 matrix against one Q8_0 activation.
//
// It is shaders/moe_down.comp with the mixture taken out, and it turned out to
// be the kernel most of the model wants: the down projection of a shared
// branch, and the four projections of an attention. Nothing about it knows
// which.
//
// A workgroup takes sixteen outputs with eight threads to each, which keeps
// the reason the mixture's shape has — a lane walks the blocks of its row
// eight at a time, so the eight of them read a hundred and twenty-eight
// contiguous bytes at once — and gives up the wide workgroup that came with
// it. Sixteen outputs give 128 threads to a workgroup.
//
// Clustered subgroup reduction across the 8 consecutive lanes of a row replaces
// the shared memory array and barriers.

#ifndef COLUMNS
#define COLUMNS 1
#endif

layout(local_size_x = 128) in;   // sixteen outputs, eight lanes each

layout(std430, binding = 0) readonly  buffer W  { uint  w[];   };
layout(std430, binding = 1) readonly  buffer AQ { uint  aq[];  };  // the activation, Q8_0
layout(std430, binding = 2) readonly  buffer AS { float as_[]; };  // its scales, then its corrections
layout(std430, binding = 3) writeonly buffer Y  { float y[];   };

layout(push_constant) uniform Push {
    uint dim;   // outputs
    uint ffn;   // inputs
    uint used;  // one, and only here so that every kernel takes the same block
    uint act;   // the activation, which is spent before this kernel runs
    uint col;   // the first column of the pass this dispatch answers
} p;

const uint LANES = 8u;
const uint OUTS  = 16u;   // outputs to a workgroup, which is 128 / LANES

// lanePart is one lane's share of a Q4_0 row against every column.
void lanePart(uint rowBase, uint lane, out float answer[COLUMNS]) {
    uint nb  = p.ffn >> 5;
    uint nib = rowBase + 2u * nb;
    uint aw  = p.ffn >> 2;   // one column of the activation, in uints

    precise float sum[COLUMNS];
    precise float corr[COLUMNS];
    for (uint c = 0u; c < COLUMNS; c++) { sum[c] = 0.0; corr[c] = 0.0; }

    for (uint b = lane; b < nb; b += LANES) {
        vec2  pair = unpackHalf2x16(w[(rowBase + 2u * b) >> 2]);
        float ws   = pair[b & 1u];

        uint at = (nib + 16u * b) >> 2;
        uint ab = b * 8u;
        uint lo[4], hi[4];
        for (uint u = 0u; u < 4u; u++) {
            uint word = w[at + u];
            lo[u] = word & 0x0F0F0F0Fu;
            hi[u] = (word >> 4) & 0x0F0F0F0Fu;
        }
        for (uint c = 0u; c < COLUMNS; c++) {
            uint ac = (p.col + c) * aw + ab;
            int acc = 0;
            for (uint u = 0u; u < 4u; u++) {
                acc = dotPacked4x8AccSatEXT(lo[u], int(aq[ac + u]),      acc);
                acc = dotPacked4x8AccSatEXT(hi[u], int(aq[ac + u + 4u]), acc);
            }
            uint sc = (p.col + c) * 2u * nb;
            sum[c]  += float(acc) * ws * as_[sc + b];
            corr[c] += ws * as_[sc + nb + b];
        }
    }
    for (uint c = 0u; c < COLUMNS; c++) answer[c] = sum[c] - corr[c];
}

void main() {
    uint t    = gl_LocalInvocationID.x;
    uint lane = t & 7u;
    uint i    = gl_WorkGroupID.x * OUTS + (t >> 3);

    uint rowBytes = (p.ffn >> 5) * 18u;
    float part[COLUMNS];
    if (i < p.dim) {
        lanePart(i * rowBytes, lane, part);
    } else {
        for (uint c = 0u; c < COLUMNS; c++) part[c] = 0.0;
    }
    for (uint c = 0u; c < COLUMNS; c++) {
        float sum = subgroupClusteredAdd(part[c], LANES);
        if (lane == 0u && i < p.dim) {
            y[(p.col + c) * p.dim + i] = sum;
        }
    }
}
