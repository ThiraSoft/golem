#version 450
#extension GL_EXT_integer_dot_product : require

// y = W * x for one Q4_0 matrix against one Q8_0 activation.
//
// It is shaders/moe_down.comp with the mixture taken out, and it turned out to
// be the kernel most of the model wants: the down projection of a shared
// branch, and the four projections of an attention. Nothing about it knows
// which.
//
// A workgroup takes sixteen outputs with eight threads to each, which keeps
// the reason the mixture's shape has — a lane walks the blocks of its row
// eight at a time, so the eight of them read a hundred and twenty-eight
// contiguous bytes at once — and gives up the wide workgroup that came with
// it. Sixty-four outputs to a workgroup left the attention's output
// projection with forty-four workgroups for sixty-four compute units, and a
// fifth of the card idle for the length of the kernel. Sixteen gives it a
// hundred and seventy-six.
//
// COLUMNS is how many activations one pass answers, and it is the whole of why
// a prompt is not the same shape as a token. Generating reads every weight in
// the model to produce one column, and the card is at its memory ceiling doing
// it — measured, 350 gigabytes a second on this one. A prompt of sixty-four
// positions needs the same weights sixty-four times, and reading them once for
// eight columns instead of once for each is eight times less traffic for the
// same arithmetic. The weight word is loaded outside the column loop; that one
// line is the optimization.
//
// It is a compile-time constant rather than a push constant so that the
// accumulators stay in registers: an array indexed by a loop whose bound the
// compiler does not know goes to scratch memory, and the kernel would spend
// what it saved. The file is built twice, at one and at eight — vk/mixture.go
// names both — and a token drawn one at a time reads the same binary it
// always did.

#ifndef COLUMNS
#define COLUMNS 1
#endif

layout(local_size_x = 128) in;   // sixteen outputs, eight lanes each

layout(std430, binding = 0) readonly  buffer W  { uint  w[];   };
layout(std430, binding = 1) readonly  buffer AQ { uint  aq[];  };  // the activation, Q8_0
layout(std430, binding = 2) readonly  buffer AS { float as_[]; };  // its scales, then its corrections
layout(std430, binding = 3) writeonly buffer Y  { float y[];   };

layout(push_constant) uniform Push {
    uint dim;   // outputs
    uint ffn;   // inputs
    uint used;  // one, and only here so that every kernel takes the same block
    uint act;   // the activation, which is spent before this kernel runs
} p;

const uint LANES = 8u;
const uint OUTS  = 16u;   // outputs to a workgroup, which is 128 / LANES

shared float partial[128 * COLUMNS];

// lanePart is one lane's share of a Q4_0 row against every column.
void lanePart(uint rowBase, uint lane, out float answer[COLUMNS]) {
    uint nb  = p.ffn >> 5;
    uint nib = rowBase + 2u * nb;
    uint aw  = p.ffn >> 2;   // one column of the activation, in uints

    precise float sum[COLUMNS];
    precise float corr[COLUMNS];
    for (uint c = 0u; c < COLUMNS; c++) { sum[c] = 0.0; corr[c] = 0.0; }

    for (uint b = lane; b < nb; b += LANES) {
        vec2  pair = unpackHalf2x16(w[(rowBase + 2u * b) >> 2]);
        float ws   = pair[b & 1u];

        uint at = (nib + 16u * b) >> 2;
        uint ab = b * 8u;
        // The weight word is read here, once, and met by every column below.
        // Four products to an instruction. A Q4_0 word holds eight weights
        // as nibbles, and the two halves of it come out as two packed
        // quadruples with one mask each — which is the layout's gift: a mask
        // and a shift give four weights already sitting in the four bytes the
        // dot product wants. The accumulator is integer and exact, so this is
        // the same number the unpacked loop produced, in a quarter of the
        // instructions. vk/device.go says what the card is asked for.
        uint lo[4], hi[4];
        for (uint u = 0u; u < 4u; u++) {
            uint word = w[at + u];
            lo[u] = word & 0x0F0F0F0Fu;
            hi[u] = (word >> 4) & 0x0F0F0F0Fu;
        }
        for (uint c = 0u; c < COLUMNS; c++) {
            uint ac = c * aw + ab;
            int acc = 0;
            for (uint u = 0u; u < 4u; u++) {
                acc = dotPacked4x8AccSatEXT(lo[u], int(aq[ac + u]),      acc);
                acc = dotPacked4x8AccSatEXT(hi[u], int(aq[ac + u + 4u]), acc);
            }
            uint sc = c * 2u * nb;
            sum[c]  += float(acc) * ws * as_[sc + b];
            corr[c] += ws * as_[sc + nb + b];
        }
    }
    for (uint c = 0u; c < COLUMNS; c++) answer[c] = sum[c] - corr[c];
}

void main() {
    uint t    = gl_LocalInvocationID.x;
    uint lane = t & 7u;
    uint i    = gl_WorkGroupID.x * OUTS + (t >> 3);

    uint rowBytes = (p.ffn >> 5) * 18u;
    float part[COLUMNS];
    if (i < p.dim) {
        lanePart(i * rowBytes, lane, part);
    } else {
        for (uint c = 0u; c < COLUMNS; c++) part[c] = 0.0;
    }
    for (uint c = 0u; c < COLUMNS; c++) partial[t * COLUMNS + c] = part[c];
    barrier();
    for (uint stride = LANES >> 1; stride > 0u; stride >>= 1) {
        if (lane < stride) {
            for (uint c = 0u; c < COLUMNS; c++) {
                partial[t * COLUMNS + c] += partial[(t + stride) * COLUMNS + c];
            }
        }
        barrier();
    }
    if (lane == 0u && i < p.dim) {
        for (uint c = 0u; c < COLUMNS; c++) y[c * p.dim + i] = partial[t * COLUMNS + c];
    }
}
