#version 450

// What a calibration wants from a pass, and nothing else.
//
// The salience of a site is the per-column power of the activations that reach
// it — one number a column, over the whole corpus. Reading the activations
// back to work that out on the processor would be sixty-seven megabytes a
// block and four gigabytes a pass; this is a vector of the site's own width,
// accumulated where the activations already are.
//
// A thread a column, walking the pass. The sum is float and the corpus is
// thousands of rows of squares, which is well inside what a float holds for a
// quantity that is then square-rooted and raised to a half power.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer X   { float x[];   };
layout(std430, binding = 1)          buffer ACC { float acc[]; };

layout(push_constant) uniform Push {
    uint n;       // the site's width
    uint columns; // columns this pass carries
} p;

void main() {
    uint j = gl_GlobalInvocationID.x;
    if (j >= p.n) return;
    float s = 0.0;
    for (uint c = 0u; c < p.columns; c++) {
        float v = x[c * p.n + j];
        s += v * v;
    }
    acc[j] += s;
}
