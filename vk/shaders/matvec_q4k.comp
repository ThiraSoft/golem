#version 450
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_control_flow_attributes : enable

// y = W * x for a Q4_K matrix against float activations. Q4_K is most of what
// a K-quant mix is made of: in the 27B's Q4_K_M it is 11.42 of 15.65 GiB, and
// every projection of every block except the ones llama.cpp promoted to Q6_K.
//
// It reads vk/mixture.go's splitQ4_K and not the file's own superblocks. That
// packing leaves the sixteen-byte header where the file wrote it — d, dmin and
// twelve bytes of six-bit scales and minima — and only moves it to the front of
// the row, then lays the nibbles out sixteen contiguous bytes to a block of
// thirty-two in Q4_0's order. So this is matvec_q41.comp with the scale and the
// minimum found rather than read: one indexed load into a header region that a
// row of four thousand columns keeps under a kilobyte, and five instructions of
// unpacking.
//
// The header is not folded into an fp16 pair a block, which is what splitQ5_K
// does and what would make this kernel shorter. That costs two bytes a block —
// eleven percent on a format that is most of the model — and the header of
// vk/mixture.go's splitQ4_K says why there was nothing to trade.
//
// Workgroup: 128 threads -> 16 output rows, 8 lanes per row. COLUMNS is
// matvec_q40.comp's: how many activations one reading of the weights answers.

#ifndef COLUMNS
#define COLUMNS 1
#endif

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly  buffer W { uint  w[]; };
layout(std430, binding = 1) readonly  buffer X { float x[]; };
layout(std430, binding = 2) writeonly buffer Y { float y[]; };

layout(push_constant) uniform Push {
    uint dim; // outputs
    uint ffn; // inputs
    uint col; // the first column of the pass this dispatch answers
} p;

const uint LANES = 8u;
const uint OUTS  = 16u;

// byteOf is one byte of a word, which is how the six-bit scales are addressed.
uint byteOf(uint word, uint i) { return (word >> (i * 8u)) & 0xFFu; }

void main() {
    uint row = gl_WorkGroupID.x * OUTS + (gl_LocalInvocationID.x / LANES);
    uint lane = gl_LocalInvocationID.x % LANES;
    bool live = row < p.dim;
    if (!live) row = 0u;

    uint nb = p.ffn / 32u;
    uint rowBase = row * nb * 18u;
    uint nibBase = rowBase + nb * 2u;

    float sum[COLUMNS];
    [[unroll]] for (uint c = 0u; c < COLUMNS; c++) sum[c] = 0.0;

    for (uint b = lane; live && b < nb; b += LANES) {
        // The superblock this block belongs to, and its rank in it. Eight
        // blocks share a header, so a lane striding by eight reads the same one
        // every time and the load is a cache hit after the first.
        uint hb = (rowBase + 16u * (b >> 3u)) >> 2u;
        vec2 dm = unpackHalf2x16(w[hb]);
        uint s0 = w[hb + 1u];
        uint s1 = w[hb + 2u];
        uint s2 = w[hb + 3u];

        // ggml-quants.c's unpacking, which nn/dequant_q4_k.go carries in Go and
        // TestQ4_KMatchesGGML holds to the reference: the first four sub-blocks
        // take six whole bits, and the last four take four bits from the third
        // word and their top two from the first two.
        uint i = b & 7u;
        uint sc, mn;
        if (i < 4u) {
            sc = byteOf(s0, i) & 63u;
            mn = byteOf(s1, i) & 63u;
        } else {
            uint j = i - 4u;
            sc = (byteOf(s2, j) & 0xFu) | ((byteOf(s0, j) >> 6u) << 4u);
            mn = (byteOf(s2, j) >> 4u) | ((byteOf(s1, j) >> 6u) << 4u);
        }
        float d1 = dm.x * float(sc);
        float m1 = dm.y * float(mn);

        uint at = (nibBase + 16u * b) >> 2;
        uvec4 words = uvec4(w[at], w[at + 1u], w[at + 2u], w[at + 3u]);
        uint xOffset = b * 32u;

        [[unroll]] for (uint c = 0u; c < COLUMNS; c++) {
            uint xc = (p.col + c) * p.ffn + xOffset;
            float nibX = 0.0;
            float plainX = 0.0;
            [[unroll]] for (uint u = 0u; u < 4u; u++) {
                uint word = words[u];
                [[unroll]] for (uint k = 0u; k < 4u; k++) {
                    uint j = u * 4u + k;
                    uint byteVal = (word >> (k * 8u)) & 0xFFu;
                    float xL = x[xc + j];
                    float xH = x[xc + j + 16u];
                    nibX += float(byteVal & 0x0Fu) * xL + float(byteVal >> 4u) * xH;
                    plainX += xL + xH;
                }
            }
            // A Q4_K weight has no recentring by eight: it is q times a scale
            // less a minimum, both of which belong to this sub-block alone.
            sum[c] += nibX * d1 - plainX * m1;
        }
    }

    [[unroll]] for (uint c = 0u; c < COLUMNS; c++) {
        float total = subgroupClusteredAdd(sum[c], LANES);
        if (lane == 0u && live) y[(p.col + c) * p.dim + row] = total;
    }
}
