#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require

// One expert's routing logit to a workgroup, staged across BN columns.
//
// Built twice. With PICK the last workgroup to finish also chooses the eight
// experts, which shaders/router_pick.comp does in a dispatch of its own — and a
// dispatch of one workgroup costs six and a half microseconds to serialize
// whatever is inside it, measured, which is most of what that pick was worth.
// The counter is an atomic on a coherent buffer: every workgroup publishes its
// logit, adds one, and the one that finds it added the last reads all hundred
// and twenty-eight back and picks. It resets the counter on its way out, so
// the next block's dispatch starts from zero.
//
// PICK is for a single column alone. A prompt picks per column, and one
// workgroup doing that for every column of a pass in series is the opposite of
// what the pick is cheap for.
//
// The router matrix is float32 — the only one in this model that is — and a
// hundred and twenty-eight rows of it is 1.4 megabytes a block. For a wide
// pass of several hundred columns, evaluating it one column per workgroup read
// the weight hundreds of times over. Staging BN columns in registers inside one
// workgroup reads each element of the weight once for all BN columns, while
// preserving the exact scalar accumulation order and binary reduction tree.

#ifndef BN
#define BN 8
#endif

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly  buffer X { float x[];      };  // the router's normed input
layout(std430, binding = 1) readonly  buffer W { float w[];      };  // experts by dim, float32
#ifdef PICK
layout(std430, binding = 2) coherent  buffer L  { float logits[]; };
layout(std430, binding = 3) readonly  buffer DS { float dscale[]; };  // one scalar per expert
layout(std430, binding = 4) writeonly buffer ID { int   ids[];    };
layout(std430, binding = 5) writeonly buffer CW { float cw[];     };
layout(std430, binding = 6) coherent  buffer CN { uint  counter[]; };
#else
layout(std430, binding = 2) writeonly buffer L { float logits[]; };
#endif

layout(push_constant) uniform Push {
    uint n;
    uint experts;
    uint used;
    uint columns;
    float eps;
    float scalar;
} p;

shared float partial[BN * 8];

#ifdef PICK
shared uint  last;      // one, in the workgroup that added the hundred and twenty-eighth
shared float sl[256];   // the logits, read back
shared int   chosen[32];
shared float se[32];
#endif

void main() {
    uint e    = gl_WorkGroupID.x;
    uint col0 = gl_WorkGroupID.y * BN;
    uint t    = gl_LocalInvocationID.x;
    uint at   = e * p.n;
    uint wave = gl_SubgroupID;

    precise float sum[BN];
    for (uint c = 0u; c < BN; c++) sum[c] = 0.0;

    for (uint i = t; i < p.n; i += 256u) {
        float wi = w[at + i];
        for (uint c = 0u; c < BN; c++) {
            if (col0 + c < p.columns) {
                sum[c] += wi * x[(col0 + c) * p.n + i];
            }
        }
    }

    for (uint c = 0u; c < BN; c++) {
        float s = subgroupAdd(sum[c]);
        if (gl_SubgroupInvocationID == 0u) {
            partial[c * gl_NumSubgroups + wave] = s;
        }
    }

    barrier();

    if (wave == 0u) {
        for (uint c = 0u; c < BN; c++) {
            if (col0 + c < p.columns) {
                float s = (t < gl_NumSubgroups) ? partial[c * gl_NumSubgroups + t] : 0.0;
                s = subgroupAdd(s);
                if (t == 0u) logits[(col0 + c) * p.experts + e] = s;
            }
        }
    }

#ifdef PICK
    // Publish this workgroup's logit, then count. The one that counts last
    // has every logit of the column visible to it and does the choosing.
    memoryBarrierBuffer();
    barrier();
    if (t == 0u) {
        uint prev = atomicAdd(counter[0], 1u);
        last = (prev + 1u == p.experts) ? 1u : 0u;
        // The next block's dispatch wants it at zero, and nothing else is
        // still adding: this workgroup is the hundred and twenty-eighth.
        if (last == 1u) counter[0] = 0u;
    }
    barrier();
    if (last == 0u) return;
    memoryBarrierBuffer();

    // What follows is shaders/router_pick.comp, which is the other copy: by
    // rank rather than by rounds, a tie to the lower index so that two runs of
    // the same model choose the same experts, and the softmax over the chosen
    // few on eight lanes rather than one.
    if (t < p.experts) sl[t] = logits[t];
    barrier();

    if (t < p.experts) {
        float mine = sl[t];
        uint rank = 0u;
        for (uint x = 0u; x < p.experts; x++) {
            if (sl[x] > mine || (sl[x] == mine && x < t)) rank++;
        }
        if (rank < p.used) {
            chosen[rank] = int(t);
            ids[rank] = int(t);
        }
    }
    barrier();

    if (t < p.used) {
        se[t] = exp(sl[chosen[t]] - sl[chosen[0]]);
    }
    barrier();
    if (t < p.used) {
        float total = 0.0;
        for (uint k = 0u; k < p.used; k++) total += se[k];
        cw[t] = (se[t] / total) * dscale[chosen[t]];
    }
#endif
}
