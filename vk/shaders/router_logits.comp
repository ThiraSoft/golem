#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require

// One expert's routing logit to a workgroup, staged across BN columns.
//
// The router matrix is float32 — the only one in this model that is — and a
// hundred and twenty-eight rows of it is 1.4 megabytes a block. For a wide
// pass of several hundred columns, evaluating it one column per workgroup read
// the weight hundreds of times over. Staging BN columns in registers inside one
// workgroup reads each element of the weight once for all BN columns, while
// preserving the exact scalar accumulation order and binary reduction tree.

#ifndef BN
#define BN 8
#endif

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly  buffer X { float x[];      };  // the router's normed input
layout(std430, binding = 1) readonly  buffer W { float w[];      };  // experts by dim, float32
layout(std430, binding = 2) writeonly buffer L { float logits[]; };

layout(push_constant) uniform Push {
    uint n;
    uint experts;
    uint used;
    uint columns;
    float eps;
    float scalar;
} p;

shared float partial[BN * 8];

void main() {
    uint e    = gl_WorkGroupID.x;
    uint col0 = gl_WorkGroupID.y * BN;
    uint t    = gl_LocalInvocationID.x;
    uint at   = e * p.n;
    uint wave = gl_SubgroupID;

    precise float sum[BN];
    for (uint c = 0u; c < BN; c++) sum[c] = 0.0;

    for (uint i = t; i < p.n; i += 256u) {
        float wi = w[at + i];
        for (uint c = 0u; c < BN; c++) {
            if (col0 + c < p.columns) {
                sum[c] += wi * x[(col0 + c) * p.n + i];
            }
        }
    }

    for (uint c = 0u; c < BN; c++) {
        float s = subgroupAdd(sum[c]);
        if (gl_SubgroupInvocationID == 0u) {
            partial[c * gl_NumSubgroups + wave] = s;
        }
    }

    barrier();

    if (wave == 0u) {
        for (uint c = 0u; c < BN; c++) {
            if (col0 + c < p.columns) {
                float s = (t < gl_NumSubgroups) ? partial[c * gl_NumSubgroups + t] : 0.0;
                s = subgroupAdd(s);
                if (t == 0u) logits[(col0 + c) * p.experts + e] = s;
            }
        }
    }
}
