#version 450
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_control_flow_attributes : enable

// matvec_hyb.comp with every lane carrying ROWS rows, so that an activation
// block is loaded once and spent on all of them. Past one column the activation
// and not the weight is the traffic: a weight is three eighths of a byte and its
// activations are four bytes a column, read again for every row.
//
// LANES threads share a row group and walk its blocks; a workgroup of THREADS
// answers THREADS / LANES * ROWS rows.

#ifndef COLUMNS
#define COLUMNS 1
#endif
#ifndef ROWS
#define ROWS 2
#endif
#ifndef LANES
#define LANES 8
#endif
#ifndef LBITS
#define LBITS 14
#endif
#ifndef QBITS
#define QBITS 10
#endif
#ifndef HALF
#define HALF 1
#endif
// T3G decodes the old code with the same structure: a weight a window of
// twelve bits, three apart, through a 4096-float image of 1MAD.
#ifndef T3G
#define T3G 0
#endif
#define KBITS 3u
#if T3G
#undef LBITS
#define LBITS 12
#define ENTRIES 4096u
#undef HALF
#define HALF 0
#else
#define ENTRIES (2u << QBITS)
#endif

layout(local_size_x = 256, local_size_x_id = 0) in;
layout(constant_id = 1) const int TABLE = 1;
layout(constant_id = 2) const int PREFETCH = 0;
layout(constant_id = 3) const int COPIES = 1;

layout(std430, binding = 0) readonly  buffer W { uint  w[]; };
layout(std430, binding = 1) readonly  buffer T { float steps[]; };
layout(std430, binding = 2) readonly  buffer X { vec4 x4[]; };
layout(std430, binding = 3) writeonly buffer Y { float y[]; };

layout(push_constant) uniform Push {
    uint dim;
    uint ffn;
    uint col;
} p;

const uint SEQ   = 128u;
const uint BLOCK = 64u;
const uint PAIRS = BLOCK / 2u;
const uint STRIDE = 2u * KBITS;
#if LBITS == 14 || T3G
const uint SEQB  = T3G != 0 ? 50u : 49u;
#else
const uint SEQB  = 50u;
#endif
const uint HALFB = 24u;
#if T3G
const uint SD = ((BLOCK - 1u) * KBITS + 12u + 31u) / 32u;
#else
const uint SD = ((PAIRS - 1u) * STRIDE + LBITS + 31u) / 32u;
#endif

uint bswap(uint v) {
    return (v >> 24u) | ((v >> 8u) & 0xFF00u) | ((v << 8u) & 0xFF0000u) | (v << 24u);
}

#if T3G
shared float lds[ENTRIES];
#elif HALF
shared uint lds[ENTRIES];
#else
shared vec2 lds[ENTRIES];
#endif

float one(uint s[SD], uint t) {
    const uint o  = t * KBITS;
    const uint wi = o >> 5u;
    const uint bi = o & 31u;
    uint v;
    if (bi <= 20u) {
        v = bitfieldExtract(s[wi], int(20u - bi), 12);
    } else {
        v = ((s[wi] << bi) | (s[wi + 1u] >> (32u - bi))) >> 20u;
    }
    return lds[v];
}

uint seqOf(uint codeBase, uint b) {
    return codeBase + (b >> 1u) * SEQB + (b & 1u) * HALFB;
}

vec2 decode(uint s[SD], uint j) {
#if T3G
    return vec2(one(s, 2u * j), one(s, 2u * j + 1u));
#else
    const uint o  = j * STRIDE;
    const uint wi = o >> 5u;
    const uint bi = o & 31u;
    uint v;
    if (bi <= 32u - LBITS) {
        v = bitfieldExtract(s[wi], int(32u - LBITS - bi), LBITS);
    } else {
        v = ((s[wi] << bi) | (s[wi + 1u] >> (32u - bi))) >> (32u - LBITS);
    }
    uint h = v * (v + 1u);
    uint e = bitfieldExtract(h, 15 - QBITS, QBITS + 1);
#if HALF
    return unpackHalf2x16(lds[e]);
#else
    return lds[e];
#endif
#endif
}

void main() {
    for (uint i = gl_LocalInvocationID.x; i < ENTRIES; i += gl_WorkGroupSize.x) {
#if T3G
        lds[i] = steps[256u + i];
#else
        vec2 v = vec2(steps[256u + 2u * i], steps[256u + 2u * i + 1u]);
#endif
#if T3G
#elif HALF
        lds[i] = packHalf2x16(v);
#else
        lds[i] = v;
#endif
    }
    barrier();

    const uint GROUPS = gl_WorkGroupSize.x / LANES;
    uint lane  = gl_LocalInvocationID.x % LANES;
    uint first = (gl_WorkGroupID.x * GROUPS + gl_LocalInvocationID.x / LANES) * ROWS;

    uint nb = p.ffn / BLOCK;
    uint ns = p.ffn / SEQ;
    uint rowBytes = nb + ns * SEQB;
    uint rowBase[ROWS];
    [[unroll]] for (uint r = 0u; r < ROWS; r++) rowBase[r] = min(first + r, p.dim - 1u) * rowBytes;

    float sum[ROWS][COLUMNS];
    [[unroll]] for (uint r = 0u; r < ROWS; r++)
        [[unroll]] for (uint c = 0u; c < COLUMNS; c++) sum[r][c] = 0.0;

    for (uint b = lane; b < nb; b += LANES) {
        uint s[ROWS][SD];
        float step[ROWS];
        [[unroll]] for (uint r = 0u; r < ROWS; r++) {
            uint stepAt = rowBase[r] + b;
            step[r] = steps[(w[stepAt >> 2u] >> ((stepAt & 3u) * 8u)) & 0xFFu];
            uint seqAt = seqOf(rowBase[r] + nb, b);
            uint at = seqAt >> 2u;
            uint raw[SD + 1u];
            [[unroll]] for (uint j = 0u; j <= SD; j++) raw[j] = w[at + j];
            uint sh = (seqAt & 3u) * 8u;
            uint prev = bswap(raw[0]);
            [[unroll]] for (uint j = 0u; j < SD; j++) {
                uint next = bswap(raw[j + 1u]);
                s[r][j] = (prev << sh) | ((next >> 1u) >> (31u - sh));
                prev = next;
            }
        }
        float part[ROWS][COLUMNS];
        [[unroll]] for (uint r = 0u; r < ROWS; r++)
            [[unroll]] for (uint c = 0u; c < COLUMNS; c++) part[r][c] = 0.0;

        [[unroll]] for (uint g = 0u; g < PAIRS / 4u; g++) {
            vec4 xa[COLUMNS], xb[COLUMNS];
            [[unroll]] for (uint c = 0u; c < COLUMNS; c++) {
                uint at = ((p.col + c) * p.ffn + b * BLOCK + g * 8u) >> 2u;
                xa[c] = x4[at];
                xb[c] = x4[at + 1u];
            }
            [[unroll]] for (uint r = 0u; r < ROWS; r++) {
                vec2 w0 = decode(s[r], g * 4u);
                vec2 w1 = decode(s[r], g * 4u + 1u);
                vec2 w2 = decode(s[r], g * 4u + 2u);
                vec2 w3 = decode(s[r], g * 4u + 3u);
                [[unroll]] for (uint c = 0u; c < COLUMNS; c++) {
                    part[r][c] += dot(vec4(w0, w1), xa[c]) + dot(vec4(w2, w3), xb[c]);
                }
            }
        }
        [[unroll]] for (uint r = 0u; r < ROWS; r++)
            [[unroll]] for (uint c = 0u; c < COLUMNS; c++) sum[r][c] += part[r][c] * step[r];
    }

    [[unroll]] for (uint r = 0u; r < ROWS; r++) {
        [[unroll]] for (uint c = 0u; c < COLUMNS; c++) {
            float total = subgroupClusteredAdd(sum[r][c], LANES);
            if (lane == 0u && first + r < p.dim) y[(p.col + c) * p.dim + first + r] = total;
        }
    }
}
