#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_control_flow_attributes : enable

// attn_one.comp cut along the keys, for YuE2's AR half: a token reads a
// prompt of three thousand positions and then thousands of its own codes, and
// attn_one gives a head one workgroup, sixteen of them on a card of sixty-four
// compute units walking three thousand keys each. Measured at position 3006
// that was 12.4 of a token's 15.4 milliseconds.
//
// So the positions of the visible range are cut into SPLITS stretches, a
// workgroup to a head and a stretch, and each leaves its running maximum, its
// sum and its unnormalized mix in a scratch row; yue2_attn_merge.comp folds
// the stretches and writes the Q8_0 form attn_one writes. Everything inside a
// stretch is attn_one's, line for line: the cache addressing, the ring, the
// online softmax, the mix.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly  buffer QH { float qh[];     };
layout(std430, binding = 1) readonly  buffer CK { uint  ck[];     };
layout(std430, binding = 2) readonly  buffer CV { uint  cv[];     };
layout(std430, binding = 3) writeonly buffer PT { float part[];   };  // [column][head][split][headDim + 2]
layout(std430, binding = 4) readonly  buffer WH { uvec4 where_[]; };

layout(push_constant) uniform Push {
    uint heads;
    uint kvHeads;
    uint headDim;
    uint perKV;
    uint block;
    uint capacity;
    uint mask;
    uint columns;
    float scale;
    uint col0;
    uint splits;
} p;

const uint WHERE_COLUMNS = 512u;

// BRANCHES is where the branches start in the same buffer, past every block's
// columns: two entries a column, the same for every block. A column on a
// branch (cmd/golem-server/weigh.go writes every question's words and options
// after the state, each seeing the state, its own question and itself) is
// written where it stands in the cache and does not see two stretches of it:
// .y up to .z of the first entry and .x up to .y of the second, first and one
// past the last. A column on no branch has both empty. The first entry's .x
// is how far past its turn it stands, which only the angles read.
const uint BRANCHES = 128u * WHERE_COLUMNS;

bool hidden(uvec4 a, uvec4 b, uint pos) {
    return (pos >= a.y && pos < a.z) || (pos >= b.x && pos < b.y);
}

// LPP lanes to a position and PPI positions to a tile, which multiply to the
// workgroup. Eight and thirty-two, and both halves of that matter.
//
// Eight because a key row is read across them: lane l takes elements l, l+8,
// … of the row, so the eight of them read thirty-two consecutive words at
// once. One lane to a position would read a row per lane and stride the
// fetches by a whole head, which is the same bytes at a fraction of the rate.
// Eight is also a cluster a subgroup reduce can fold, which is how the dot
// becomes a score without shared memory.
//
// Thirty-two because it is what the tile of the wide kernel is, and because
// the mix below amortises the accumulator's rescale over it.
const uint LPP = 8u;
const uint PPI = 256u / LPP;

// UNROLL is how many positions of the mix a thread has in flight at once.
// Measured end to end on Qwen3-4B-Q4_K_M, a token: two gives 8.90 ms, four
// 8.78, eight 8.64, sixteen 8.67. Eight, and the shape of that curve is the
// argument: it is latency being covered and not work being saved.
const uint UNROLL = 8u;

// MAXD is attn_scores.comp's: Gemma 4's global blocks have heads of five
// hundred and twelve, and a kernel that assumed the workgroup was as wide as a
// head answered every sixth block with half of it.
const uint MAXD = 512u;
const uint DPT  = MAXD / 256u;
const uint MAXQ = MAXD / 8u;

#define QW (hd >> 3u)

// The one query row, whole, and the tile's probabilities. Two kilobytes and a
// hundred and twenty-eight bytes against the wide kernel's fifty kilobytes,
// which is the whole of why more than one workgroup fits on a compute unit.
shared uvec4 qs[MAXQ];
shared float ss[PPI];

uint slotBase;

uint entry(uint pos, uint head) {
    uint at = (p.mask != 0u) ? (pos & p.mask) : (pos % p.capacity);
    return ((slotBase + at) * p.kvHeads + head) * p.headDim;
}

void main() {
    uint h    = gl_WorkGroupID.x;
    uint sp   = gl_WorkGroupID.y;
    uint t    = gl_LocalInvocationID.x;
    uint hd   = p.headDim;
    uint kv   = h / p.perKV;
    uint base = p.col0;

    uvec4 mine = where_[p.block * WHERE_COLUMNS + base];
    uvec4 hole = where_[BRANCHES + base], hole2 = where_[BRANCHES + WHERE_COLUMNS + base];
    slotBase = mine.w * p.capacity;
    // This workgroup's stretch of the visible range. A stretch past the end
    // leaves an empty row: a maximum of minus infinity and a sum of zero.
    uint chunk = (((mine.z - mine.y + 1u + p.splits - 1u) / p.splits) + 31u) & ~31u;
    uint first = sp * chunk;
    uint lo = mine.y + first, hi = mine.z;
    uint total = first < (mine.z - mine.y + 1u) ? min(chunk, mine.z - mine.y + 1u - first) : 0u;

    // The query, read once and kept. Eight dimensions to an element, which is
    // one shared instruction in the dot below.
    for (uint j = t; j < QW; j += 256u) {
        uint qb = base * p.heads * hd + h * hd + (j << 3);
        qs[j] = uvec4(packHalf2x16(vec2(qh[qb],      qh[qb + 1u])),
                      packHalf2x16(vec2(qh[qb + 2u], qh[qb + 3u])),
                      packHalf2x16(vec2(qh[qb + 4u], qh[qb + 5u])),
                      packHalf2x16(vec2(qh[qb + 6u], qh[qb + 7u])));
    }
    barrier();

    uint lane = t % LPP;      // which eighth of the row this thread reads
    uint slotIn = t / LPP;    // which position of the tile it scores

    float acc[DPT];
    [[unroll]] for (uint u = 0u; u < DPT; u++) acc[u] = 0.0;
    float rowMax = -1.0 / 0.0, rowSum = 0.0;

    for (uint start = 0u; start < total; start += PPI) {
        uint got = min(PPI, total - start);
        uint pos = lo + start + slotIn;

        // The dot, folded over the lanes that share the position. A thread
        // reads the key straight from the cache: eight of them cover a row
        // between them and every element any of them wants is inside the
        // thirty-two words the eight fetch together.
        float partial = 0.0;
        if (slotIn < got) {
            uint o = entry(pos, kv) >> 1;
            for (uint j = lane; j < QW; j += LPP) {
                uvec4 q = qs[j];
                uint at = o + (j << 2);
                uvec4 k = uvec4(ck[at], ck[at + 1u], ck[at + 2u], ck[at + 3u]);
                [[unroll]] for (uint w = 0u; w < 4u; w++) {
                    partial += dot(unpackHalf2x16(q[w]), unpackHalf2x16(k[w]));
                }
            }
        }
        float d = subgroupClusteredAdd(partial, LPP);

        // Which positions this column's range admits. A sliding window moves
        // the first and its own position is the last.
        float inf = 1.0 / 0.0;
        float s = (slotIn < got && pos >= mine.y && pos <= mine.z && !hidden(hole, hole2, pos))
                  ? d * p.scale : -inf;
        barrier();
        if (lane == 0u) ss[slotIn] = s;
        barrier();

        // The tile's maximum and sum, computed by every thread out of the
        // thirty-two scores rather than reduced across them: thirty-two shared
        // reads against a barrier and a fold, and it leaves the answer in
        // every thread, which the mix below wants anyway.
        float tileMax = -inf;
        for (uint c = 0u; c < got; c++) tileMax = max(tileMax, ss[c]);
        float newMax = max(rowMax, tileMax);
        float rescale = (rowMax == newMax) ? 1.0 : exp(rowMax - newMax);
        float tileSum = 0.0;
        for (uint c = 0u; c < got; c++) {
            tileSum += isinf(newMax) ? 0.0 : exp(ss[c] - newMax);
        }
        rowSum = rowSum * rescale + tileSum;

        // The probabilities written over the scores they came from. One
        // exponential a position rather than one a position and a dimension,
        // which is what recomputing them inside the mix would have cost, and
        // the reads below are the same address in every thread, which shared
        // memory broadcasts.
        barrier();
        if (t < got) ss[t] = isinf(newMax) ? 0.0 : exp(ss[t] - newMax);
        barrier();

        // The mix, a thread to a dimension, four positions at a time.
        //
        // Four and not one, and this is the whole of what the kernel costs. A
        // thread's read of a value is four bytes out of the cache and the next
        // one is a thousand positions away in it; taken one at a time the loop
        // is a chain of dependent loads and a workgroup a head (thirty-two of
        // them on sixty-four compute units) has nothing else in flight to
        // cover the latency with. Measured: the whole scoring and mixing loop
        // took 42 microseconds a block against llama.cpp's 14 for the same
        // work, which is a twelve gigaflop rate on a card that does forty
        // thousand. Four independent loads issue together and the arithmetic
        // is unchanged.
        for (uint u = 0u; u < DPT; u++) {
            uint dim = t + u * 256u;
            if (dim >= hd) break;
            acc[u] *= rescale;
            uint half_ = dim >> 1;
            bool lowHalf = (dim & 1u) == 0u;
            float sum = 0.0;
            uint c = 0u;
            for (; c + UNROLL <= got; c += UNROLL) {
                float v[UNROLL];
                [[unroll]] for (uint m = 0u; m < UNROLL; m++) {
                    vec2 pair = unpackHalf2x16(cv[(entry(lo + start + c + m, kv) >> 1) + half_]);
                    v[m] = lowHalf ? pair.x : pair.y;
                }
                [[unroll]] for (uint m = 0u; m < UNROLL; m++) sum += ss[c + m] * v[m];
            }
            for (; c < got; c++) {
                vec2 v = unpackHalf2x16(cv[(entry(lo + start + c, kv) >> 1) + half_]);
                sum += ss[c] * (lowHalf ? v.x : v.y);
            }
            acc[u] += sum;
        }
        rowMax = newMax;
    }

    // The stretch's running maximum, its sum and its mix, unnormalized.
    uint row = ((base * p.heads + h) * p.splits + sp) * (hd + 2u);
    for (uint u = 0u; u < DPT; u++) {
        uint dim = t + u * 256u;
        if (dim >= hd) break;
        part[row + dim] = acc[u];
    }
    if (t == 0u) {
        part[row + hd] = rowMax;
        part[row + hd + 1u] = rowSum;
    }
}
