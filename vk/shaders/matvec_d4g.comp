#version 450
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_control_flow_attributes : enable

// y = W * x for a D4G matrix against float activations.
//
// A block is sixty-four weights: two eight-bit step codes, one per thirty-two,
// and sixteen twelve-bit codes
// naming points of the D4 lattice. Expanding a code is a lookup — which is the
// whole reason the lattice is D4 and not E8, whose shell at this rate would
// need two hundred megabytes of table where this one needs sixteen kibibytes,
// four signed bytes a point, small enough to stay in L2 for the life of the
// dispatch. The table is the lattice, so the same one serves every matrix of
// every model.
//
// The row is two planes, steps then codes, because a block of twenty-six bytes
// would otherwise start on a two-byte boundary and this reads words. A step
// code names a power of two a sixteenth apart, so expanding it is one exp2 and
// no table at all.
//
// Workgroup: 128 threads -> 16 output rows, 8 lanes per row, which is
// matvec_q5k.comp's shape. COLUMNS is how many activations one reading of the
// weights answers.

#ifndef COLUMNS
#define COLUMNS 1
#endif

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly  buffer W { uint  w[]; };
layout(std430, binding = 1) readonly  buffer T { uint  table[]; }; // four int8 a point
layout(std430, binding = 2) readonly  buffer X { float x[]; };
layout(std430, binding = 3) writeonly buffer Y { float y[]; };

layout(push_constant) uniform Push {
    uint dim; // outputs
    uint ffn; // inputs
    uint col; // the first column of the pass this dispatch answers
} p;

const uint LANES = 8u;
const uint OUTS  = 16u;

// sext8 sign-extends one of the four bytes of a packed point.
float sext8(uint word, uint i) {
    return float(int(bitfieldExtract(int(word), int(i * 8u), 8)));
}

void main() {
    uint row = gl_WorkGroupID.x * OUTS + (gl_LocalInvocationID.x / LANES);
    uint lane = gl_LocalInvocationID.x % LANES;
    bool live = row < p.dim;
    if (!live) row = 0u;

#ifdef BITS16
    const uint BLOCKBYTES = 34u;
#else
    const uint BLOCKBYTES = 26u;
#endif
    uint nb = p.ffn / 64u;
    uint rowBase   = row * nb * BLOCKBYTES; // bytes; nb is even, so this is a word
    uint stepBase  = rowBase;          // two step codes a block
    uint codeBase  = rowBase + nb * 2u; // nb runs of codes

    float sum[COLUMNS];
    [[unroll]] for (uint c = 0u; c < COLUMNS; c++) sum[c] = 0.0;

    for (uint b = lane; live && b < nb; b += LANES) {
        uint stepAt = stepBase + 2u * b;
        uint stepWord = w[stepAt >> 2u];
        uint sc0 = (stepWord >> ((stepAt & 3u) * 8u)) & 0xFFu;
        uint sc1 = (stepWord >> (((stepAt + 1u) & 3u) * 8u)) & 0xFFu;
        float stepLo = exp2((float(sc0) - 272.0) * 0.0625);
        float stepHi = exp2((float(sc1) - 272.0) * 0.0625);

#ifdef BITS16
        // Sixteen bits a code is two plain halfwords, so a word is two codes
        // and the run is eight words rather than six bytes at a time.
        uint at = (codeBase + 32u * b) >> 2;
        uint words[8] = uint[8](w[at], w[at + 1u], w[at + 2u], w[at + 3u],
                                w[at + 4u], w[at + 5u], w[at + 6u], w[at + 7u]);
#else
        uint at = (codeBase + 24u * b) >> 2;
        uint c0 = w[at], c1 = w[at + 1u], c2 = w[at + 2u];
        uint c3 = w[at + 3u], c4 = w[at + 4u], c5 = w[at + 5u];
        uint words[6] = uint[6](c0, c1, c2, c3, c4, c5);
#endif

        uint xOffset = b * 64u;

        [[unroll]] for (uint k = 0u; k < 8u; k++) {
#ifdef BITS16
            uint pair = words[k];
            uint codeA = pair & 0xFFFFu;
            uint codeB = pair >> 16u;
#else
            // Sixteen codes over twenty-four bytes, two codes to three bytes.
            uint o = k * 3u;
            uint b0 = (words[o >> 2u] >> ((o & 3u) * 8u)) & 0xFFu;
            uint o1 = o + 1u;
            uint b1 = (words[o1 >> 2u] >> ((o1 & 3u) * 8u)) & 0xFFu;
            uint o2 = o + 2u;
            uint b2 = (words[o2 >> 2u] >> ((o2 & 3u) * 8u)) & 0xFFu;

            uint codeA = b0 | ((b1 & 0x0Fu) << 8u);
            uint codeB = (b1 >> 4u) | (b2 << 4u);
#endif
            // Each turn of this loop is eight weights, so the first four turns
            // are the block's first thirty-two and the second four the rest.
            float step = (k < 4u) ? stepLo : stepHi;
#ifdef NOTABLE
            // Not a decoder: the same traffic in weights and the same
            // arithmetic, with the lookup replaced by nonsense of the right
            // shape. It exists only to price the lookup.
            uint ptA = codeA * 0x01010101u;
            uint ptB = codeB * 0x01010101u;
#else
            uint ptA = table[codeA];
            uint ptB = table[codeB];
#endif

            [[unroll]] for (uint c = 0u; c < COLUMNS; c++) {
                uint xc = (p.col + c) * p.ffn + xOffset + k * 8u;
                float acc = 0.0;
                [[unroll]] for (uint i = 0u; i < 4u; i++) {
                    acc += sext8(ptA, i) * x[xc + i];
                    acc += sext8(ptB, i) * x[xc + 4u + i];
                }
                sum[c] += acc * step;
            }
        }
    }

    [[unroll]] for (uint c = 0u; c < COLUMNS; c++) {
        float total = subgroupClusteredAdd(sum[c], LANES);
        if (lane == 0u && live) y[(p.col + c) * p.dim + row] = total;
    }
}
