#version 450

// The token embedding of a .golem, read on the card: nn/pair.go's H3G (KBITS
// 3) or H4G (KBITS 4).
//
// A row here is not the row anybody wants: the table is the logit head, stored
// the way the logit product wants it, so a row of it has to come back through
// the site's vector and the rotation before it is a token's embedding. Undoing
// them is not applying them again in the same order — the transform is its own
// inverse, the scaling is not, and the scaling went on first so it comes off
// last.
//
// The one thing that is neater here than in the lattice shader this replaced:
// a rotation group is 128 and so
// is a trellis sequence, so a workgroup is exactly one path and a thread is
// exactly one weight of it.

#ifndef GROUP
#define GROUP 128
#endif

#ifndef KBITS
#define KBITS 4
#endif

layout(local_size_x = GROUP) in;

layout(std430, binding = 0) readonly  buffer W  { uint  w[];     }; // the table
layout(std430, binding = 1) readonly  buffer T  { float steps[]; }; // the step grid, then the codebook
layout(std430, binding = 2) readonly  buffer ID { int   ids[];   };
layout(std430, binding = 3) readonly  buffer P  { float pre[];   };
layout(std430, binding = 4) writeonly buffer Y  { float y[];     };

layout(push_constant) uniform Push {
    uint cols;
} p;

shared float s[GROUP];

uint byteAt(uint at) { return (w[at >> 2u] >> ((at & 3u) * 8u)) & 0xFFu; }

void main() {
    uint perColumn = p.cols / GROUP;
    uint gid = gl_WorkGroupID.x;
    uint col = gid / perColumn;
    uint seq = gid - col * perColumn;
    int id = ids[col];
    uint t = gl_LocalInvocationID.x;
    if (id < 0) return;

#if KBITS == 4
    const uint SEQB = 65u;
#else
    const uint SEQB = 49u;
#endif
    uint nb = p.cols / 64u;
    uint ns = p.cols / 128u;
    uint rowBase = uint(id) * (nb + ns * SEQB);

    float step = steps[byteAt(rowBase + seq * 2u + (t >> 6u))];

    // nn/pair.go: weight t is half of the pair its state t/2 decodes, the
    // state being L bits at 2K·(t/2), and the pair is read out of the
    // codebook that follows the step grid in binding 1.
    const uint L = KBITS == 4 ? 15u : 14u;
    uint bit = (t >> 1u) * 2u * uint(KBITS);
    uint at = rowBase + nb + seq * SEQB + (bit >> 3u);
    // The last window's third byte would be the next sequence's, or past the
    // table; it holds no bit of this state either way.
    uint third = ((bit >> 3u) + 2u < SEQB) ? byteAt(at + 2u) : 0u;
    uint word = (byteAt(at) << 16u) | (byteAt(at + 1u) << 8u) | third;
    uint state = (word >> (24u - L - (bit & 7u))) & ((1u << L) - 1u);
    uint h = state * (state + 1u);
    uint e = KBITS == 4 ? ((h >> 4u) & 4095u) : ((h >> 5u) & 2047u);
    s[t] = steps[256u + 2u * e + (t & 1u)] * step;
    barrier();

    for (uint l = 1u; l < GROUP; l <<= 1u) {
        float mine = s[t];
        float other = s[t ^ l];
        barrier();
        s[t] = ((t & l) == 0u) ? (mine + other) : (other - mine);
        barrier();
    }

    y[col * p.cols + seq * GROUP + t] = s[t] * inversesqrt(float(GROUP)) * pre[seq * GROUP + t];
}
