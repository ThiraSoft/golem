#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

// The two elementwise steps of Laya's pass that no product or norm does on
// its way out:
//
//   0  split: A written into HL as a product reads its operand, the first
//      block's, which has no norm before its attention to do it
//   1  the kind of each position's question: its row of the type embedding,
//      from par, added to A

#define THREADS 256
layout(local_size_x = THREADS) in;

layout(std430, binding = 0) buffer A { float a[]; };
layout(std430, binding = 1) writeonly buffer HL { float16_t hl[]; };
layout(std430, binding = 2) readonly buffer PAR { float par[]; };
layout(std430, binding = 3) readonly buffer AUX { uint aux[]; };

layout(push_constant) uniform Push {
    uint count;
    uint op;
    uint width;
    uint at;   // the type embedding's rows in par, or the low plane in HL
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.count) return;
    if (p.op == 0u) {
        // shaders/laya_epi.glsl says why the high part is cut by a mask.
        float v = a[i];
        float top = uintBitsToFloat(floatBitsToUint(v) & 0xffffe000u);
        hl[i] = float16_t(top);
        hl[p.at + i] = float16_t(v - top);
    } else {
        uint t = i / p.width, j = i % p.width;
        a[i] += par[p.at + aux[t] * p.width + j];
    }
}
