#version 450
// Applies Sigmoid Gating to Attention Output: out = attnOut * sigmoid(gate)

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly  buffer Attn { float attn[]; }; // [6144]
layout(std430, binding = 1) readonly  buffer QIn  { float qIn[];  }; // [12288] (Gate is at offset 6144)
layout(std430, binding = 2) writeonly buffer Out  { float out_[]; }; // [6144]

layout(push_constant) uniform Push {
    uint n; // 6144
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;

    float val = attn[i];
    float g = qIn[6144u + i];
    float sigG = 1.0 / (1.0 + exp(-g));
    out_[i] = val * sigG;
}
