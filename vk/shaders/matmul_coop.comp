#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_EXT_control_flow_attributes : enable

// y = W * X on the matrix cores, for one Q4_0 matrix against a batch of Q8_0
// activations.
//
// **This is what the prompt pass runs on a card with matrix cores**, since
// 2026-08-26; the journal below is how it got there, and every claim in it is
// dated because several were overturned by the ones after them. llama.cpp's
// own Vulkan build on this card says
// `matrix cores: KHR_coopmat` in its log, and turning them off with
// GGML_VK_DISABLE_COOPMAT=1 takes its Qwen3 4B prompt from 2958 tokens a
// second to 1532. That factor of 1.93 is the largest single piece of the gap
// between golem's prompt and theirs, and this file is the attempt at it.
//
// RDNA's cores multiply a sixteen by sixteen block in one instruction. The
// trade they ask for is that both operands arrive as ordinary numbers, so this
// kernel dequantises the weights and the activation into shared memory as fp16
// and multiplies what it staged — which is what llama.cpp's own mul_mm does,
// and is why there is no correction term here where the integer kernels carry
// one: the weights are recentred by eight as they are unpacked rather than
// eight blocks later.
//
// It agrees with the CPU to a part in six thousand and it is slower than
// shaders/matmul.comp: 9.1 microseconds a column against 5.9 on the Qwen3 4B's
// ffn_down at thirty-two columns, 6.5 against nothing at all at two hundred
// and fifty-six. What that cost is made of was measured by compiling pieces of
// it away:
//
//   - **The cores are not the problem.** Repeating the multiply loop four and
//     sixteen times over the same staged tile costs 0.66 microseconds a column
//     each time, which puts the multiply at 76 TFLOP/s — the same order as
//     llama.cpp's own 70 on a 512-column product. Seven per cent of the pass.
//   - **The dequantising is not the problem either.** Compiled with the
//     unpacking replaced by a store that still depends on the block, the pass
//     goes from 9.1 to 7.8. Fourteen per cent.
//   - So about eighty per cent of it is the staging: the global reads, the
//     shared writes, and the barriers between them. That is the same eighty
//     per cent shaders/matmul.comp spends, and neither kernel has found it.
//
// What was tried against that and measured worse, so that it is not tried
// again:
//
//   - **A bigger BK.** Sixty-four, a hundred and twenty-eight and two hundred
//     and fifty-six all lose, monotonically, and the reason is that the staged
//     tile is what decides how many workgroups a compute unit holds. At BK=32
//     this kernel is under eight kilobytes and the card runs eight of them.
//     *Overturned twice below: BK 128 wins once a thread stages a whole
//     block, and BK 32 wins again once the waves are a grid.*
//   - **A bigger BM.** A hundred and twenty-eight and two hundred and
//     fifty-six lose the same way and for the same reason. *Overturned below:
//     BM 128 wins once WAVE_M stops being every wave.*
//   - **Interleaving the weights by tile** so that a workgroup's read of one
//     block is one contiguous run instead of BM sixteen-byte pieces a row
//     apart — vk/mixture.go's tileQ4_0. It changed nothing measurable, which
//     says the level two cache was already absorbing the waste. *That layout
//     has since been deleted: this kernel reads the ordinary row-major
//     splitQ4_0 that every other kernel here reads.*
//   - **Reading the activation as fp16 straight from a buffer** instead of
//     staging it, so that forty workgroups stop dequantising the same twelve
//     million values into forty copies. Thirty-two columns got worse (11.1
//     against 9.1) and only a hundred and twenty-eight got better.
//
// **Splitting the shared dimension, and blocking the columns, were then tried,
// and they are what the sweeps above were missing.** With p.split slices of
// the shared dimension and BN columns to a workgroup rather than all of them —
// which is llama.cpp's own shape, and neither of golem's two products had it —
// this kernel reaches 2.66 microseconds a column on ffn_down at a hundred and
// twenty-eight columns, against the integer product's 4.24 at thirty-two. That
// is the first time the cores have been ahead of the dot products.
//
// **Measured again once the harness stopped lying about it, it is at parity
// and not ahead.** vk/matmul.go used to force this kernel's split to one and
// pass it no BN at all, so every number the benchmark had ever printed for it
// was of a kernel without the two things that put it ahead — and the dispatch
// did not count its column groups either, which for a kernel nothing binds is
// a bug waiting rather than a bug. With all three fixed, on the 12B at two
// hundred and fifty-six columns, which is the width the stack now carries:
// ffn_down 4.76 microseconds a column against the integer product's 4.69, and
// ffn_gate 9.01 against 8.90. The cores are level with the dot products and
// marginally behind, which is what this file's own analysis predicted — eighty
// per cent of the pass is the staging, and the staging is the same.
//
// **Its own geometry was then swept again through the fixed harness**, since
// every earlier sweep of it went through the broken one. On the 12B at two
// hundred and fifty-six columns, microseconds a column, ffn_down then
// ffn_gate: 64/32/32 gives 4.76 and 9.03, 64/64/32 gives **4.40** and 9.24,
// 128/64/32 gives 4.74 and 9.55, 64/32/64 gives 4.84 and 9.08, 128/32/32
// gives 4.52 and 9.40, 64/64/64 gives 4.87 and 9.73, 128/128/32 gives 5.85
// and 9.71. The best of them is six per cent ahead of the integer product on
// ffn_down and four per cent behind it on ffn_gate. Six per cent is not the
// 1.93 that turning coopmat off costs llama.cpp, and no geometry here finds
// it.
//
// It is still not bound in, and now for one reason rather than two. It wanted
// a pass of at least a hundred and twenty-eight columns, and the stack carries
// two hundred and fifty-six now, so that objection is gone; what remains is
// that there is nothing to win. And **ffn_gate does not move**. That shape — many rows, a
// short shared dimension, which is what every gate, up and qkv projection is —
// sits at six microseconds a column under every combination of BM, BN, BK,
// split and width measured, integer or cooperative, while ffn_down's shape
// goes to 2.66. Nothing in the arithmetic of the two is different: the same
// weights, the same activations, the same multiply count, the same staging.
// Naming that asymmetry is what the next pass at this is for.
//
// **Three things landed against that, 2026-08-26, and they are worth 15% on
// ffn_down and 3% on ffn_gate.** On the 12B at two hundred and fifty-six
// columns: ffn_down 7.04 microseconds a column to **5.99**, ffn_gate 9.62 to
// **9.41**.
//
//   - **A whole block a thread.** The staging read four bytes of nibbles a
//     thread and read the same scale word four times over. It now reads one
//     Q4_0 block — a dwordx4 — and one scale, and the same for the Q8_0
//     activation. On its own, at BK 32, this *loses* (8.38 and 9.98): only BM
//     of the threads have anything to stage.
//   - **BK 128, which now wins where it used to lose.** Wide loads and a deep
//     step are one change, not two: the step is what gives every thread a
//     block of its own to read. 6.33 at BK 128 against 7.04 at 32.
//   - **The column group as the fast dispatch index.** The CGROUPS
//     workgroups that answer different columns of the same rows read the same
//     weight tile, and whether that tile is read once or CGROUPS times
//     depends on whether they are in flight together. See the comment in
//     main().
//
// **And ffn_gate still does not move.** 9.4 to 10.9 microseconds a column
// under every one of the twenty-odd combinations measured since, against
// llama.cpp's 1.99 on that exact shape — which is *their* fastest, 59.4
// TFLOP/s, where their transpose is 46.8. The asymmetry is upside down on
// their side, so it is a property of this kernel and not of the shape, and
// nothing in the geometry, the accumulator width, the shared-store width or
// the load width has found it.
//
// **The final disassembly, at last, and what it says.** RADV_DEBUG=shaders
// does print the post-register-allocation code -- it is under `disasm:`, after
// the ACO IR. Nothing in it is called `s_waitcnt`: GFX12 splits the counter
// into `s_wait_dscnt`, `s_wait_loadcnt`, `s_wait_kmcnt` and `s_wait_alu`, so a
// search for the old name finds nothing and the wrong conclusion follows.
//
// The hot block, read side by side with llama.cpp's, settles two things and
// opens one.
//
//   - **The wave tile.** At BM 64, BN 32 the inner block is sixteen
//     `v_wmma_f32_16x16x16_f16` fed by twenty-four `ds_load_b64`: one and a
//     half shared loads per multiply, because a wave owns two accumulator
//     fragments and every pair of multiplies needs a fresh operand. Theirs is
//     thirty-two multiplies on sixteen loads -- half a load per multiply, a
//     four-by-four accumulator grid. Ours reaches that ratio exactly at BM
//     256, BN 64: sixteen loads, thirty-two multiplies, no scratch. ffn_gate
//     measures 9.96 there against 9.26 at the wasteful geometry. The wave tile
//     is not it either.
//
//   - **The staging never overlaps the multiplying.** Their loop is one basic
//     block: the global loads, the dequantisation, the shared stores and the
//     thirty-two matrix multiplies, with four `s_wait_loadcnt` sitting among
//     the multiplies. Memory for the next step is in flight while the cores
//     work. Ours is three blocks with barriers between them -- stage, barrier,
//     multiply -- and the multiply block contains no load of any kind. This is
//     a real difference and it is worth fixing, but it is not the wall: see
//     below.
//
// The activation's sign extension was three instructions a magnitude (extract,
// compare, subtract) and there are thirty-two magnitudes a thread a step. As
// one `v_bfe_i32` it is now one. ffn_down went 5.46 to 4.95 microseconds a
// column. **ffn_gate went 9.26 to 9.20**, which is noise.
//
// That is the shape of every result on this shape. Doubling BM halves how
// often the activation is re-staged: 9.36. Their exact wave tile: 9.96. Their
// exact instruction budget per multiply: unchanged. Removing sixty-four VALU a
// thread a step: unchanged. **ffn_gate does not respond to work removed**,
// which means it is not spending its time working.
//
// What it is spending it on is legible in the throughput the benchmark already
// prints. Cold, streaming thirty-three megabytes of weights: ffn_down reads at
// 26.2 GB/s and ffn_gate at 14.1, on a card that does about 640. llama.cpp on
// the same shape is near 49. The wall is on the way to memory -- the order the
// weight tile is walked in, and what the caches make of it -- and the ISA now
// says the arithmetic side is at parity, so that is the only place left for it
// to be.
//
// **It was not in this kernel at all.** Strip the loop body one piece at a
// time and ffn_gate answers the same thing to everything: without the sixteen
// matrix multiplies, 9.13; without the staging, 9.58; without the barriers,
// 9.13; with the whole K loop gone, so that the kernel does nothing whatever,
// **8.70 of the 9.20**. Then remove only the final store and it collapses to
// 4.36 -- below ffn_down's 4.48, which is what two products of the same shape
// and the same count of multiplications should measure.
//
// The store was writing into host-visible memory. vk/matmul.go allocated the
// benchmark's answer with Readback, so the shader put its result across PCIe
// at about twelve gigabytes a second instead of into VRAM at hundreds. ffn_gate
// writes fifteen megabytes a pass where ffn_down writes four, and that ratio is
// the whole of the shape asymmetry this comment has been chasing: it was never
// in the geometry, the accumulators, the wave layout, the element type, the
// wait counts or the tile. It was the benchmark's own output buffer, and
// llama.cpp's twin never had it -- that harness writes to device memory and
// copies afterwards.
//
// With the two harnesses finally alike, at two hundred and fifty-six columns:
//
//   |          | golem | llama.cpp |
//   | ffn_down |  4.48 |      3.45 |
//   | ffn_gate |  4.34 |      2.68 |
//
// and at sixty-four columns golem is ahead on both -- 5.26 against 13.48 on
// ffn_down, 5.02 against 5.62 on ffn_gate. The engine never had this problem:
// vk/mixture.go has always kept every intermediate in Local.
//
// **The wave grid, 2026-08-26, and it is what bound this kernel in.** Every
// geometry above was swept with one shape of wave: WAVE_M waves each owning
// RSUB row blocks and *every* column block, which is the 4/1 the defaults
// still give. The disassembly entry above already named the cost -- one and a
// half shared loads per multiply, where llama.cpp's four-by-four accumulator
// grid pays half -- but it looked for the fix in a bigger BM alone, and a
// bigger BM alone is what the sweep had already refused.
//
// Splitting the waves in both directions is what that entry was missing. At
// WAVE_M 2, WAVE_N 2 a wave owns a four-by-four grid of accumulators, which is
// their ratio exactly, and BM 128 with BN 128 now fits four waves without
// scratch. That is why vk/matmul.go's generate lines read as they do: BM 128,
// BN 128, BK 32 from a hundred and twenty-eight columns up, and the old 64/32
// kept only at thirty-two columns, where BN cannot exceed the pass.
//
// Measured end to end rather than per kernel, which is the number that
// matters: prompt tokens a second, before against after. Gemma 26B A4B:
// 1085 -> 1174 at sixty-four columns, 1443 -> 1659 at two hundred and
// fifty-six, 1677 -> 1979 at five hundred and twelve. Gemma 12B at two hundred
// and fifty-six: 1093 -> 1723. Qwen3 0.6B at five hundred and twelve:
// 7609 -> 11034, and that width used to be a regression against its own two
// hundred and fifty-six.
//
// **What this does not fix.** llama.cpp's Vulkan build on the same prompts is
// 2886 at two hundred and fifty-six and 4037 at five hundred and twelve on the
// 26B, against golem's 1659 and 1979. golem is ahead at sixty-four columns and
// level at a hundred and twenty-eight, and then it plateaus where they keep
// climbing. This kernel is no longer the reason: what is left is above it.

#ifndef COLUMNS
#define COLUMNS 32
#endif

// BM rows to a workgroup, BK of the shared dimension at a time. BK is a
// multiple of thirty-two because a Q4_0 block is thirty-two values and a block
// is the unit a scale belongs to.
#ifndef BM
#define BM 64
#endif
#ifndef BK
#define BK 128
#endif
#ifndef THREADS
#define THREADS 256
#endif

// BN is how many of the pass's columns one workgroup answers. Giving a
// workgroup every column is the shape both kernels started with, and it is the
// wrong one for a matrix with many rows and a short shared dimension: there is
// nothing left to divide but the rows, and the tile wants those. Cutting the
// columns as well multiplies the workgroups without the reduction a split of
// the shared dimension needs — each one writes outputs nobody else writes. It
// costs reading the weights COLUMNS/BN times.
#ifndef BN
#define BN COLUMNS
#endif

// The waves of a workgroup as a WAVE_M by WAVE_N grid, so that a wave owns
// RSUB row blocks by CSUB column blocks rather than every column block of its
// rows. WAVE_M * WAVE_N has to be THREADS divided by the subgroup width
// vk/device.go asks the driver for -- sixty-four here, and the reason it has
// to be asked for rather than taken.
//
// Both counts have to divide their side of the tile exactly. RSUB and CSUB are
// then compile-time constants, and that is not a detail: an accumulator array
// indexed by anything the compiler cannot fold is not in registers at all. It
// is in scratch memory, and a cooperative matrix in scratch memory is the
// difference between a kernel that runs at the cores' speed and one that runs
// at a fifth of it.
//
// A square-ish grid is what makes the shared loads pay: at 2 by 2, over a
// four-by-four grid of accumulators, a wave issues half a shared load per
// multiply against one and a half at 4 by 1. See the journal above.
#ifndef WAVE_M
#define WAVE_M 4
#endif
#ifndef WAVE_N
#define WAVE_N 1
#endif

#define TILE 16
#define RSUB ((BM / TILE) / WAVE_M)
#define CSUB ((BN / TILE) / WAVE_N)

#define SA_STRIDE (BK + 8)
#define SB_STRIDE (BK + 8)

layout(local_size_x = THREADS) in;

layout(std430, binding = 0) readonly  buffer W  { uint  w[];   };
layout(std430, binding = 1) readonly  buffer AQ { uint  aq[];  };  // the activation, Q8_0
layout(std430, binding = 2) readonly  buffer AS { float as_[]; };  // its scales, then its corrections
layout(std430, binding = 3) writeonly buffer Y  { float y[];   };

layout(push_constant) uniform Push {
    uint dim;   // outputs
    uint ffn;   // inputs
    uint used;  // one, and only here so that every kernel takes the same block
    uint act;   // the activation, which is spent before this kernel runs
    uint col;   // the gate kernel's, and not read here
    uint split; // slices of the shared dimension, one for the whole of it
} p;

shared float16_t sa[BM * SA_STRIDE];
shared float16_t sb[BN * SB_STRIDE];

// The answer goes straight out. A cooperative matrix is stored to a stride the
// whole sixteen-row tile has to exist for, which is why vk/matmul.go refuses a
// matrix whose row count is not a multiple of sixteen: with that, a block of
// TILE rows is either wholly inside the matrix or wholly outside it, and the
// store at the end skips the outside ones. BM itself need not divide the row
// count -- that guard is per tile, not per workgroup.

void main() {
    uint t    = gl_LocalInvocationID.x;
    uint nb   = p.ffn >> 5;          // blocks of the shared dimension
    // The slice of the shared dimension this workgroup answers. A tile this
    // wide leaves a row-poor matrix few workgroups against the card's compute
    // units; p.split is what puts them back.
    uint wgs  = (p.dim + uint(BM) - 1u) / uint(BM);
    const uint CGROUPS = uint(COLUMNS) / uint(BN);
    // The column group is the fast index and the row group the slow one, and
    // that ordering is worth a factor on the shapes with many rows.
    //
    // The CGROUPS workgroups that answer different columns of the same rows
    // read the same weight tile. Whether that tile is read once from memory
    // or CGROUPS times depends entirely on whether those workgroups are in
    // flight together, which depends on how far apart they are in dispatch
    // order. With the row group fast they are wgs apart: sixty on ffn_down,
    // which is inside what the card runs at once, and two hundred and forty
    // on ffn_gate, which is not -- so ffn_down was reading its matrix out of
    // cache and ffn_gate was reading it eight times out of DRAM.
    uint ic   = gl_WorkGroupID.x % CGROUPS;
    uint ir   = (gl_WorkGroupID.x / CGROUPS) % wgs;
    uint ik   = gl_WorkGroupID.x / (wgs * CGROUPS);
    uint row0 = ir * uint(BM);
    uint col0 = ic * uint(BN);
    uint aw   = p.ffn >> 2;          // one column of the activation, in uints
    uint rowBytes = nb * 18u;
    const uint KB = uint(BK) >> 5;   // Q4_0 blocks in one step
    uint per  = ((nb + p.split - 1u) / p.split + KB - 1u) & ~(KB - 1u);
    uint kb0  = ik * per;
    uint kbn  = min(nb, kb0 + per);

    uint wave_id = gl_SubgroupID;
    uint wave_r  = wave_id % uint(WAVE_M);
    uint wave_c  = wave_id / uint(WAVE_M);
    uint rbase   = wave_r * uint(RSUB);
    uint cbase   = wave_c * uint(CSUB);

    coopmat<float, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator> acc[RSUB][CSUB];
    [[unroll]] for (uint r = 0u; r < RSUB; r++) {
        [[unroll]] for (uint c = 0u; c < CSUB; c++) {
            acc[r][c] = coopmat<float, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseAccumulator>(0.0);
        }
    }

    for (uint kb = kb0; kb < kbn; kb += KB) {
        barrier();

        // The weights, dequantised.
        //
        // The layout is vk/mixture.go's splitQ4_0, which every kernel here
        // reads: a row is all of its fp16 scales and then all of its nibbles,
        // so both halves are four-byte aligned where the file's own eighteen-
        // byte blocks would not be. A row is nb * 18 bytes and this workgroup
        // owns the BM rows from row0.
        //
        // The tile-interleaved layout this kernel was written for is gone. It
        // made a workgroup's read of one block contiguous, it measured no
        // faster, and a second layout on the device is a second thing to keep
        // true.
        // A thread takes a whole Q4_0 block — sixteen bytes of nibbles, one
        // scale — rather than a quarter of one. The narrow form issued four
        // four-byte loads for the same sixteen bytes and four loads of the
        // same scale word, and the count of loads in flight is what a kernel
        // that is eighty per cent staging is made of. Sixteen bytes is one
        // dwordx4 and the run is aligned: BM * 18 is a multiple of sixteen
        // for every BM this kernel is built at, and so is BM * 2.
        for (uint idx = t; idx < BM * KB; idx += uint(THREADS)) {
            uint r    = idx & (uint(BM) - 1u);
            uint k    = idx / uint(BM);
            uint b    = kb + k;
            uvec4 words = uvec4(0u);
            float ws = 0.0;
            if (row0 + r < p.dim && b < nb) {
                uint base = (row0 + r) * rowBytes;
                uint at4  = (base + 2u * nb + 16u * b) >> 2;
                words = uvec4(w[at4], w[at4 + 1u], w[at4 + 2u], w[at4 + 3u]);
                ws    = unpackHalf2x16(w[(base + 2u * b) >> 2])[b & 1u];
            }
            uint at = r * uint(SA_STRIDE) + k * 32u;
            [[unroll]] for (uint u = 0u; u < 4u; u++) {
                uint w0 = words[u] & 0x0F0F0F0Fu;
                uint w1 = (words[u] >> 4u) & 0x0F0F0F0Fu;
                vec4 v0 = (unpackUnorm4x8(w0) * 255.0 - 8.0) * ws;
                vec4 v1 = (unpackUnorm4x8(w1) * 255.0 - 8.0) * ws;

                sa[at + u * 4u     ] = float16_t(v0.x);
                sa[at + u * 4u + 1u] = float16_t(v0.y);
                sa[at + u * 4u + 2u] = float16_t(v0.z);
                sa[at + u * 4u + 3u] = float16_t(v0.w);

                sa[at + 16u + u * 4u     ] = float16_t(v1.x);
                sa[at + 16u + u * 4u + 1u] = float16_t(v1.y);
                sa[at + 16u + u * 4u + 2u] = float16_t(v1.z);
                sa[at + 16u + u * 4u + 3u] = float16_t(v1.w);
            }
        }

        // The activation, dequantised. A thread takes one uint, four
        // magnitudes, signed. This one does pass through shared memory: read
        // straight from a buffer instead, as fp16 written once by the kernel
        // upstream, a thirty-two column pass measured worse and only a
        // hundred-and-twenty-eight column pass measured better.
        // The same for the activation: one Q8_0 block a thread, thirty-two
        // magnitudes read as two dwordx4 rather than eight dwords, and one
        // scale read once instead of eight times.
        for (uint idx = t; idx < BN * KB; idx += uint(THREADS)) {
            uint k    = idx % KB;
            uint c    = idx / KB;
            uint b    = kb + k;
            uvec4 lo = uvec4(0u), hi = uvec4(0u);
            float as = 0.0;
            if (b < nb) {
                uint at8 = (col0 + c) * aw + b * 8u;
                lo = uvec4(aq[at8],      aq[at8 + 1u], aq[at8 + 2u], aq[at8 + 3u]);
                hi = uvec4(aq[at8 + 4u], aq[at8 + 5u], aq[at8 + 6u], aq[at8 + 7u]);
                as = as_[(col0 + c) * 2u * nb + b];
            }
            uint base = c * uint(SB_STRIDE) + k * 32u;
            [[unroll]] for (uint u = 0u; u < 8u; u++) {
                uint word = (u < 4u) ? lo[u] : hi[u - 4u];
                int q0 = bitfieldExtract(int(word), 0, 8);
                int q1 = bitfieldExtract(int(word), 8, 8);
                int q2 = bitfieldExtract(int(word), 16, 8);
                int q3 = bitfieldExtract(int(word), 24, 8);
                sb[base + u * 4u     ] = float16_t(float(q0) * as);
                sb[base + u * 4u + 1u] = float16_t(float(q1) * as);
                sb[base + u * 4u + 2u] = float16_t(float(q2) * as);
                sb[base + u * 4u + 3u] = float16_t(float(q3) * as);
            }
        }

        barrier();

        // The cores.
        //
        // The order of these three loops is the kernel. A cooperative load and
        // a cooperative multiply cost about the same, so a loop that loads
        // both operands for every multiply spends half its time loading and
        // reaches a fraction of what the cores can do. The K step is outermost
        // and the column fragments are loaded once into registers there; then
        // each row block loads its own fragment once and meets all of them.
        // That is CB + RB loads for RB * CB multiplies instead of two for one.
        [[unroll]] for (uint kk = 0u; kk < uint(BK) / uint(TILE); kk++) {
            coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseB> B[CSUB];
            [[unroll]] for (uint c = 0u; c < CSUB; c++) {
                // The activation is one column after another, so a K by N
                // block of it is column major.
                coopMatLoad(B[c], sb, (cbase + c) * uint(TILE) * uint(SB_STRIDE) + kk * uint(TILE),
                            uint(SB_STRIDE), gl_CooperativeMatrixLayoutColumnMajor);
            }
            [[unroll]] for (uint r = 0u; r < RSUB; r++) {
                coopmat<float16_t, gl_ScopeSubgroup, TILE, TILE, gl_MatrixUseA> A;
                coopMatLoad(A, sa, (rbase + r) * uint(TILE) * uint(SA_STRIDE) + kk * uint(TILE),
                            uint(SA_STRIDE), gl_CooperativeMatrixLayoutRowMajor);
                [[unroll]] for (uint c = 0u; c < CSUB; c++) {
                    acc[r][c] = coopMatMulAdd(A, B[c], acc[r][c]);
                }
            }
        }
    }

    [[unroll]] for (uint r = 0u; r < RSUB; r++) {
        uint row = row0 + (rbase + r) * uint(TILE);
        if (row >= p.dim) continue;
        [[unroll]] for (uint c = 0u; c < CSUB; c++) {
            coopMatStore(acc[r][c], y, (ik * uint(COLUMNS) + col0 + (cbase + c) * uint(TILE)) * p.dim + row,
                         p.dim, gl_CooperativeMatrixLayoutColumnMajor);
        }
    }
}
