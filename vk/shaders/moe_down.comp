#version 450
#extension GL_EXT_integer_dot_product : require

// The second half of the expert branch: the down projection of all eight
// chosen experts, and their weighted sum.
//
// A workgroup takes thirty-two outputs across eight experts, with two threads
// to each of those two hundred and fifty-six dot products. No atomics, because
// every thread that contributes to an output is in the same workgroup — that
// is the point of the shape: eight experts writing into one vector would
// otherwise need either an atomic add on floats or eight partial vectors and a
// third pass.
//
// Two lanes to a row, where shaders/moe_gateup.comp gives eight, because the
// rows are not the same length. This projection's rows are the feed-forward
// width, seven hundred and four, which is twenty-two Q4_0 blocks; eight lanes
// left each of them with under three blocks to walk, and a loop that short is
// a reduction and a launch with a little arithmetic between them. It ran at a
// hundred and fifty gigabytes a second against the other kernel's two hundred
// and fifty. Two lanes walk eleven blocks each, which is the same loop the
// wider kernel got its number with.
//
// The routing weight and the per-expert scale arrive already multiplied
// together: llama.cpp applies the scale just before the weight, so one
// multiplication does both. gemma/block.go folds them on the way in.

layout(local_size_x = 512) in;   // thirty-two outputs, eight experts, two lanes

layout(std430, binding = 0) readonly  buffer W  { uint  w[];   };  // Q4_0, every expert
layout(std430, binding = 1) readonly  buffer AQ { uint  aq[];  };  // the activation, Q8_0
layout(std430, binding = 2) readonly  buffer AS { float as_[]; };  // its scales, then its corrections
layout(std430, binding = 3) readonly  buffer ID { int   ids[]; };  // the chosen experts
layout(std430, binding = 4) readonly  buffer CW { float cw[];  };  // routing weight times expert scale
layout(std430, binding = 5) writeonly buffer Y  { float y[];   };

layout(push_constant) uniform Push {
    uint dim;   // outputs
    uint ffn;   // inputs
    uint used;  // experts to sum, which the workgroup's shape fixes at eight
    uint act;   // the gate kernel's, and not read here
    uint col;   // the column of the pass this dispatch answers
} p;

const uint LANES = 8u;
const uint OUTS  = 8u;    // outputs to a workgroup, which is 512 / (8 x LANES)

shared float partial[512];

// pairOf is where one column's kth chosen expert sits in the buffers between
// the two halves: they hold a row for every pair of a column and one of its
// eight slots, which is the layout shaders/moe_gateup.comp writes.
uint pairOf(uint k) { return p.col * p.used + k; }

// abyte reads one signed byte of expert k's activation.
int abyte(uint k, uint b) {
    uint at = pairOf(k) * p.ffn + b;
    return bitfieldExtract(int(aq[at >> 2]), int((at & 3u) * 8u), 8);
}

// lanePart is one lane's share of a row against expert k's activation, Q4_0 or
// Q8_0 as the build says.
// The layout is the one shaders/moe_gateup.comp describes: a row's scales,
// then its nibbles.
float lanePart(uint rowBase, uint k, uint lane) {
    uint nb  = p.ffn >> 5;
    uint nib = rowBase + 2u * nb;

    precise float sum = 0.0;
    precise float corr = 0.0;
    for (uint b = lane; b < nb; b += LANES) {
        vec2  pair = unpackHalf2x16(w[(rowBase + 2u * b) >> 2]);
        float ws   = pair[b & 1u];

        int acc = 0;
#ifdef Q80
        // Thirty-two signed bytes against thirty-two signed bytes, and no
        // offset in either, so the correction the Q4_0 branch carries is not
        // written here rather than being computed and found to be nought.
        uint at = (nib + 32u * b) >> 2;
        uint ab = ((pairOf(k) * p.ffn) >> 2) + b * 8u;
        for (uint u = 0u; u < 8u; u++) {
            acc = dotPacked4x8AccSatEXT(int(w[at + u]), int(aq[ab + u]), acc);
        }
        sum += float(acc) * ws * as_[p.col * 2u * p.used * nb + k * nb + b];
#else
        uint at = (nib + 16u * b) >> 2;
        uint ab = ((pairOf(k) * p.ffn) >> 2) + b * 8u;
        // Four products to an instruction. A Q4_0 word holds eight weights
        // as nibbles, and the two halves of it come out as two packed
        // quadruples with one mask each — which is the layout's gift: a mask
        // and a shift give four weights already sitting in the four bytes the
        // dot product wants. The accumulator is integer and exact, so this is
        // the same number the unpacked loop produced, in a quarter of the
        // instructions. vk/device.go says what the card is asked for.
        for (uint u = 0u; u < 4u; u++) {
            uint word = w[at + u];
            acc = dotPacked4x8AccSatEXT(word & 0x0F0F0F0Fu,        int(aq[ab + u]),      acc);
            acc = dotPacked4x8AccSatEXT((word >> 4) & 0x0F0F0F0Fu, int(aq[ab + u + 4u]), acc);
        }
        // A column's scales come first and its corrections after, one pair
        // of runs a column, which is why the stride is twice the pairs.
        uint sb = p.col * 2u * p.used * nb + k * nb + b;
        sum  += float(acc) * ws * as_[sb];
        corr += ws * as_[sb + p.used * nb];
#endif
    }
    return sum - corr;
}

void main() {
    uint t    = gl_LocalInvocationID.x;
    uint j    = t / (8u * LANES);  // which of the outputs
    uint k    = (t / LANES) & 7u;  // which of the eight experts
    uint lane = t % LANES;
    uint i    = gl_WorkGroupID.x * OUTS + j;

    uint nb       = p.ffn >> 5;
#ifdef Q80
    uint rowBytes = nb * 34u;
#else
    uint rowBytes = nb * 18u;
#endif
    uint expert   = uint(ids[pairOf(k)]) * p.dim * rowBytes;

    partial[t] = (i < p.dim) ? lanePart(expert + i * rowBytes, k, lane) : 0.0;
    barrier();
    for (uint stride = LANES >> 1; stride > 0u; stride >>= 1) {
        if (lane < stride) partial[t] += partial[t + stride];
        barrier();
    }

    if (lane == 0u && k == 0u && i < p.dim) {
        precise float sum = 0.0;
        for (uint e = 0u; e < 8u; e++) sum += partial[t + e * LANES] * cw[pairOf(e)];
        y[p.col * p.dim + i] = sum;
    }
}
