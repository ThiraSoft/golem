#version 450
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_control_flow_attributes : enable

// y = W * x for a trellis matrix whose code yields two weights a state.
//
// This is QTIP's HYB code (Tseng et al., arXiv:2406.11235, and
// lib/codebook/bitshift.py's quantlut_sym): the state is a window of the code
// stream, and one state reconstructs a pair of weights, so the stream moves by
// 2·KBITS bits a pair and a window is cut, hashed and looked up once for two
// weights instead of once for each. matvec_t4g.comp spends about nine tenths of
// its time on exactly that cut and that lookup, which is what this halves.
//
// The row is laid out as T3G's: steps then codes, a step a sixty-four weights,
// and a path of 128 weights a sequence — sixty-four states here.
//
// MODE picks how a state becomes two numbers:
//
//   1  HYB as QTIP ships it. L is sixteen; h = s·(s+1) mod 2^32; bits 6..14 of
//      h pick one of 512 pairs, bit 15 flips the sign of the first. The sign is
//      folded into the table here — bits 6..15 index 1024 pairs, the upper half
//      being the lower with its first component negated — which is the same
//      function and costs no instruction to apply.
//   2  A plain table of every state, at L of twelve: 4096 pairs. No hash at
//      all; the price is a table eight times the size.
#ifndef MODE
#define MODE 1
#endif

#ifndef COLUMNS
#define COLUMNS 1
#endif

#ifndef KBITS
#define KBITS 3
#endif

// HALF stores the table as half2, four bytes a pair, against float2's eight.
#ifndef HALF
#define HALF 0
#endif

// STEPOUT multiplies a block's partial sum by its step once, instead of every
// weight by it.
#ifndef HABLATE
#define HABLATE 0
#endif

#ifndef STEPOUT
#define STEPOUT 0
#endif

#if MODE == 1
#ifndef LBITS
#define LBITS 16
#endif
#ifndef QBITS
#define QBITS 9
#endif
// The table index is bits 16-QBITS-1 .. 14 of the hash and the sign bit 15.
#define ENTRIES (2u << QBITS)
#else
#define LBITS 12
#define ENTRIES 4096u
#endif

#define LANES_PER_ROW 8

layout(local_size_x = 256, local_size_x_id = 0) in;
layout(constant_id = 1) const int TABLE = 1;     // unused; kept for the spec block
layout(constant_id = 2) const int PREFETCH = 1;
layout(constant_id = 3) const int COPIES = 1;

layout(std430, binding = 0) readonly  buffer W { uint  w[]; };
// Binding 1: the 256 step floats, then the codebook as ENTRIES pairs.
layout(std430, binding = 1) readonly  buffer T { float steps[]; };
layout(std430, binding = 2) readonly  buffer X { float x[]; };
layout(std430, binding = 3) writeonly buffer Y { float y[]; };

layout(push_constant) uniform Push {
    uint dim;
    uint ffn;
    uint col;
} p;

const uint LANES = uint(LANES_PER_ROW);
const uint SEQ   = 128u;
const uint BLOCK = 64u;
const uint PAIRS = BLOCK / 2u;
const uint STRIDE = 2u * KBITS;          // bits the stream moves a pair
#if KBITS == 3 && LBITS == 14
const uint SEQB  = 49u;  // 14 + 63·6 = 392 bits
const uint HALFB = 24u;
#elif KBITS == 3
const uint SEQB  = 50u;  // 16 + 63·6 = 394 bits, rounded up
const uint HALFB = 24u;  // 32·6 = 192 bits
#else
const uint SEQB  = 65u;
const uint HALFB = 32u;
#endif

// Words of stream a block's thirty-two windows reach into.
const uint SD = ((PAIRS - 1u) * STRIDE + LBITS + 31u) / 32u;

uint bswap(uint v) {
    return (v >> 24u) | ((v >> 8u) & 0xFF00u) | ((v << 8u) & 0xFF0000u) | (v << 24u);
}

#if HALF
shared uint lds[ENTRIES * uint(COPIES)];
#else
shared vec2 lds[ENTRIES * uint(COPIES)];
#endif

uint seqOf(uint codeBase, uint b) {
    return codeBase + (b >> 1u) * SEQB + (b & 1u) * HALFB;
}

void readRaw(uint seqAt, out uint raw[SD + 1u]) {
    uint at = seqAt >> 2u;
    [[unroll]] for (uint j = 0u; j <= SD; j++) raw[j] = w[at + j];
}

void main() {
    for (uint i = gl_LocalInvocationID.x; i < ENTRIES * uint(COPIES); i += gl_WorkGroupSize.x) {
        uint e = i % ENTRIES;
        vec2 v = vec2(steps[256u + 2u * e], steps[256u + 2u * e + 1u]);
#if HALF
        lds[i] = packHalf2x16(v);
#else
        lds[i] = v;
#endif
    }
    barrier();

    const uint OUTS = gl_WorkGroupSize.x / LANES;
    uint row = gl_WorkGroupID.x * OUTS + (gl_LocalInvocationID.x / LANES);
    uint lane = gl_LocalInvocationID.x % LANES;
    uint copy = (gl_LocalInvocationID.x % uint(COPIES)) * ENTRIES;
    bool live = row < p.dim;
    if (!live) row = 0u;

    uint nb  = p.ffn / BLOCK;
    uint ns  = p.ffn / SEQ;
    uint rowBase  = row * (nb + ns * SEQB);
    uint codeBase = rowBase + nb;

    float sum[COLUMNS];
    [[unroll]] for (uint c = 0u; c < COLUMNS; c++) sum[c] = 0.0;

    uint raw[SD + 1u];
    if (PREFETCH != 0 && live && lane < nb) readRaw(seqOf(codeBase, lane), raw);
    for (uint b = lane; live && b < nb; b += LANES) {
        uint stepAt = rowBase + b;
        float step = steps[(w[stepAt >> 2u] >> ((stepAt & 3u) * 8u)) & 0xFFu];
        uint seqAt = seqOf(codeBase, b);
        uint xOffset = b * BLOCK;

        uint cur[SD + 1u];
        if (PREFETCH != 0) {
            cur = raw;
            if (b + LANES < nb) readRaw(seqOf(codeBase, b + LANES), raw);
        } else {
            readRaw(seqAt, cur);
        }
        uint s[SD];
        {
            uint sh = (seqAt & 3u) * 8u;
            uint prev = bswap(cur[0]);
            [[unroll]] for (uint j = 0u; j < SD; j++) {
                uint next = bswap(cur[j + 1u]);
                s[j] = (prev << sh) | ((next >> 1u) >> (31u - sh));
                prev = next;
            }
        }

        // Every window of the block, then every table index.
        uint vv[PAIRS];
        [[unroll]] for (uint j = 0u; j < PAIRS; j++) {
            const uint o  = j * STRIDE;
            const uint wi = o >> 5u;
            const uint bi = o & 31u;
            uint v;
            if (bi <= 32u - LBITS) {
                v = bitfieldExtract(s[wi], int(32u - LBITS - bi), LBITS);
            } else {
                v = ((s[wi] << bi) | (s[wi + 1u] >> (32u - bi))) >> (32u - LBITS);
            }
#if MODE == 1
            // s·(s+1) fits thirty-two bits for a sixteen-bit s, and both
            // factors fit the twenty-four bits of v_mul_u32_u24.
            uint h = v * (v + 1u);
            vv[j] = copy + bitfieldExtract(h, 15 - QBITS, QBITS + 1);
#else
            vv[j] = copy + v;
#endif
        }

#if STEPOUT
        float part[COLUMNS];
        [[unroll]] for (uint c = 0u; c < COLUMNS; c++) part[c] = 0.0;
#define ACC part
#define SCALE
#else
#define ACC sum
#define SCALE * step
#endif
        // Groups of four pairs, eight weights; the next group's four reads are
        // issued before this group's multiplies.
        vec2 nxt[4];
        [[unroll]] for (uint j = 0u; j < 4u; j++) {
#if HABLATE
            nxt[j] = vec2(float(vv[j]), float(vv[j] ^ 5u));
#elif HALF
            nxt[j] = unpackHalf2x16(lds[vv[j]]);
#else
            nxt[j] = lds[vv[j]];
#endif
        }
        [[unroll]] for (uint g = 0u; g < PAIRS / 4u; g++) {
            vec2 wv[4];
            [[unroll]] for (uint j = 0u; j < 4u; j++) wv[j] = nxt[j] SCALE;
            if (g + 1u < PAIRS / 4u) {
                [[unroll]] for (uint j = 0u; j < 4u; j++) {
#if HABLATE
                    nxt[j] = vec2(float(vv[(g + 1u) * 4u + j]), float(vv[(g + 1u) * 4u + j] ^ 5u));
#elif HALF
                    nxt[j] = unpackHalf2x16(lds[vv[(g + 1u) * 4u + j]]);
#else
                    nxt[j] = lds[vv[(g + 1u) * 4u + j]];
#endif
                }
            }
            float xv[COLUMNS][8];
            [[unroll]] for (uint c = 0u; c < COLUMNS; c++) {
                uint xb = (p.col + c) * p.ffn + xOffset + g * 8u;
                [[unroll]] for (uint j = 0u; j < 8u; j++) xv[c][j] = x[xb + j];
            }
            [[unroll]] for (uint j = 0u; j < 4u; j++) {
                [[unroll]] for (uint c = 0u; c < COLUMNS; c++) {
                    ACC[c] += wv[j].x * xv[c][2u * j];
                    ACC[c] += wv[j].y * xv[c][2u * j + 1u];
                }
            }
        }
#if STEPOUT
        [[unroll]] for (uint c = 0u; c < COLUMNS; c++) sum[c] += part[c] * step;
#endif
    }

    [[unroll]] for (uint c = 0u; c < COLUMNS; c++) {
        float total = subgroupClusteredAdd(sum[c], LANES);
        if (lane == 0u && live) y[(p.col + c) * p.dim + row] = total;
    }
}
