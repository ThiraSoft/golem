#version 450
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#ifdef COOP
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
#endif

// The attention itself: one query head against everything it can see, the
// softmax over that, and the values mixed by it. FlashAttention, which here
// means one thing above all the others — a workgroup answers BR columns at
// once rather than one.
//
// The kernel this replaces gave a workgroup to every (head, column) pair, so
// every column read the whole key and value cache for itself: twenty-five
// gigabytes over a forty-eight block pass at the 12B's geometry, which on a
// card that gives six hundred and forty a second is about the twenty-seven
// milliseconds it measured. That arithmetic is what this rewrite was started
// on and it is not what the rewrite found. Sixteen columns to a workgroup
// divides the traffic by sixteen and, on its own, measured twenty-eight —
// slower. The wall was never the cache; it is the shared-memory reads of the
// score loop, and every millisecond since has come from removing one:
//
//   tiling alone, values staged in shared memory   28.1 ms
//   values read straight from the cache instead    (frees sixteen kilobytes)
//   two dimensions to a shared read, padded rows   17.9
//   eight dimensions to a shared read              14.2
//
// The ablation is flat: strike either of the loop's two reads and the kernel
// runs at half the time, strike both and it runs at the mix alone. It is
// bound by how many shared-memory instructions it issues and by nothing else
// — not bandwidth, since sixteen lanes of every wave read the same address,
// and not arithmetic, which the conversions and the multiplies together do
// not fill. What is left to take is register tiling: give a thread a two by
// two block of scores and the same four reads answer four times the work.
// That wants more shared memory than the 12B's global blocks leave, whose
// heads are twice as wide as its window blocks', so it wants a binary per
// head width — which is where this stops for now.
//
// Everything else follows from the tiling. The scores of sixteen columns
// against a tile of sixteen positions do not fit anywhere but in the
// workgroup, so the softmax has to run online — a running maximum and a
// running sum per row, the accumulator rescaled whenever the maximum moves —
// and once it does, the scratch buffer the old kernel wrote its scores to and
// read back four times is not needed at all. The row of output lives in
// registers from the first tile to the last: thread t owns dimension t of all
// BR rows.
//
// Two thread geometries, one per phase. The scores are a sixteen by sixteen
// grid, thread t answering row t/16 against position t%16, which puts a row
// inside one cluster of sixteen lanes and lets the row's maximum and sum fold
// with a clustered subgroup reduce instead of shared memory and a barrier.
// The mix is one thread to a dimension, and it is the cheap half precisely
// because one value read serves all sixteen rows. The two geometries meet
// through pr, which is the only array either writes.
//
// One rounding to fp16 that used to be two. The keys and values are halves
// because llama.cpp holds its cache that way. The probabilities are not
// rounded any more: the old kernel handed the mix halves because it had
// materialised them, and an online softmax never materialises a probability
// outside a register.
//
// No 1/sqrt(head_dim) anywhere. Gemma 4 scales by one, and the query norm is
// what keeps the scores in range.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly  buffer QH { float qh[];     };  // the queries, fp16-exact
layout(std430, binding = 1) readonly  buffer CK { uint  ck[];     };  // the key cache
layout(std430, binding = 2) readonly  buffer CV { uint  cv[];     };  // the value cache
layout(std430, binding = 3) buffer          SC { float scores[];  };  // unused; the online softmax has no scratch
layout(std430, binding = 4) writeonly buffer AQ { uint  aq[];     };  // the mixed values, Q8_0
layout(std430, binding = 5) writeonly buffer AS { float as_[];    };  // their scales, then corrections
layout(std430, binding = 6) readonly  buffer WH { uvec4 where_[]; };  // one per block and column: position, first, last, slot

layout(push_constant) uniform Push {
    uint heads;
    uint kvHeads;
    uint headDim;
    uint perKV;     // query heads to a key-value head
    uint block;     // which entry of where_ holds the visible range
    uint capacity;
    uint mask;      // capacity - 1 when that is a mask, and zero otherwise
    uint columns;   // one past the last column of the run, so the last tile can mask
    float scale;    // 1/sqrt(head_dim), or one where a query norm holds the range
    uint col0;      // the first column of the run this dispatch answers
} p;

// WHERE_COLUMNS is vk/attention.go's maxColumns, and the two have to agree.
const uint WHERE_COLUMNS = 512u;

// BR columns to a workgroup against BC positions at a time, both thirty-two,
// answered by a sixteen by sixteen grid of threads — so a thread carries a two
// by two block of scores rather than one. That is register tiling and it is
// the whole of why the tile is not sixteen: the score loop is bound by its
// shared reads, and the same two query reads and two key reads answer four
// scores instead of one. Four times the work for twice the reads.
//
// The grid stays sixteen wide because a row has to lie inside one cluster of
// sixteen lanes for the softmax to fold there. A thread answers rows sr and
// sr + 16 against positions sc and sc + 16, and the two rows fold as two
// clustered reduces over the same cluster.
const uint BR = 32u;
const uint BC = 32u;

// MAXD is the widest head this kernel is built for, and DPT is how many
// dimensions of it a thread carries. Gemma 4 is why this is not one: its
// window blocks have heads of two hundred and fifty-six and its global blocks
// have heads of five hundred and twelve, and a kernel that assumed the
// workgroup was as wide as a head answered every sixth block with the first
// half of it. Narrower heads idle threads in the mix phase and not in the
// scores.
const uint MAXD = 512u;
const uint DPT  = MAXD / 256u;

// QW is a row of one head in units of uvec4 — eight halves, eight dimensions,
// one shared-memory instruction. The score loop is what asks for that width:
// read a dimension at a time and it issues one LDS instruction per multiply,
// which is a ratio no amount of occupancy hides.
//
// The stride is QW + 1 and the extra element is not padding for alignment, it
// is the whole of what makes the score loop fast. Sixteen threads of a wave
// read sixteen different rows of ks at the same offset; at a stride of QW
// those sixteen addresses are a multiple of thirty-two words apart and land in
// one bank, and the read serialises sixteen ways. One element of slack turns
// the sixteen into sixteen different banks.
//
// Values are not staged here at all. Every element of a value is read by
// exactly one thread of the mix — the geometry gives a thread a dimension —
// so putting it through shared memory buys no reuse and costs the occupancy
// that the sixteen kilobytes would have taken.
#define QW  (hd >> 3u)
#define QST (QW + 1u)
const uint MAXQ = MAXD / 8u;

// The keys are held a chunk of dimensions at a time and the queries whole.
// Thirty-two rows of a five-hundred-and-twelve-wide head is thirty-three
// kilobytes; two of those do not fit in a workgroup's shared memory at all, so
// one of the two has to be chunked. It is the keys, because they are the ones
// read once — chunking the queries instead would mean reading them from the
// card for every tile of the cache, which is more traffic than the whole
// kernel otherwise moves.
const uint CW  = 32u;               // dimensions of a chunk, in uvec4: 128 of them
#define CST (CW + 1u)

#ifdef COOP
// The same two tiles, as halves rather than as packed pairs, because that is
// what a cooperative load reads. The strides are the same — a row is its
// dimensions and then eight of slack — so the shared memory is unchanged; only
// the element type is.
shared float16_t ks[BC * CST * 8u];
shared float16_t qs[BR * (MAXQ + 1u) * 8u];
#else
shared uvec4 ks[BC * CST];          // a chunk of a tile of keys, four halves to an element
shared uvec4 qs[BR * (MAXQ + 1u)];  // the queries of this tile's columns, whole
#endif
// The probabilities, the only thing the two phases share. Under COOP the
// cores' answer lands here first: a thread reads the four scores it owns out
// of this array, masks them, and writes the four probabilities back over them.
// Same index, same thread, so the two uses need no barrier between them and no
// second tile. The mix reads each
// of them once per dimension under a geometry where the address is
// wave-uniform, and packing four to a vec4 to make that one read per four
// multiplies was tried and measured slower — the driver spends more on
// gathering the four values than the shared reads cost.
shared float pr[BR * BC];
shared float corr[BR];              // and the rescale the maximum's move asks of the accumulator
shared float sums[BR];              // the softmax denominators, handed from one geometry to the other

uint floatToHalf(float f) {
    uint bits     = floatBitsToUint(f);
    uint sign     = (bits >> 16) & 0x8000u;
    int  exponent = int((bits >> 23) & 0xFFu) - 127 + 15;
    uint mantissa = bits & 0x7FFFFFu;

    if ((bits & 0x7FFFFFFFu) == 0u) return sign;
    if (exponent >= 0x1F) {
        if ((bits & 0x7F800000u) == 0x7F800000u && mantissa != 0u) return sign | 0x7E00u;
        return sign | 0x7C00u;
    }
    if (exponent <= 0) {
        if (exponent < -10) return sign;
        mantissa |= 0x800000u;
        uint shift = uint(14 - exponent);
        uint value = mantissa >> shift;
        uint rest  = mantissa & ((1u << shift) - 1u);
        uint mid   = 1u << (shift - 1u);
        if (rest > mid || (rest == mid && (value & 1u) == 1u)) value++;
        return sign | value;
    }
    uint value = (uint(exponent) << 10) | (mantissa >> 13);
    uint rest  = mantissa & 0x1FFFu;
    if (rest > 0x1000u || (rest == 0x1000u && (value & 1u) == 1u)) value++;
    return sign | value;
}

int nearestInt(float f) {
    return (floatBitsToInt(f + 12582912.0) & 0x007fffff) - 0x00400000;
}

// slotBase is where this tile's conversation starts in the cache, in entries.
// The cache is one buffer holding as many rings as the model was given slots,
// laid end to end; a column's .w names which of them it belongs to.
//
// It is a workgroup-wide value rather than a per-row one, and it can be
// because the host never puts two conversations in one tile: vk/attention.go's
// Record dispatches a tile per run of columns that share a slot. That is the
// whole of what a mixed pass costs — a prompt is one run and tiles as it
// always did, and a token from each of four conversations is four runs of one
// column, which is the shape generation has anyway.
uint slotBase;

// entry locates one head at one position, in units of one half.
uint entry(uint pos, uint head) {
    uint at = (p.mask != 0u) ? (pos & p.mask) : (pos % p.capacity);
    return ((slotBase + at) * p.kvHeads + head) * p.headDim;
}

void main() {
    uint h    = gl_WorkGroupID.x;
    uint t    = gl_LocalInvocationID.x;
    uint hd   = p.headDim;
    uint sh   = findMSB(QW);        // hd is a power of two, so this divides by QW
    uint kv   = h / p.perKV;
    uint base = p.col0 + gl_WorkGroupID.y * BR;
    slotBase  = where_[p.block * WHERE_COLUMNS + base].w * p.capacity;

    // This tile's rows, and the stretch of the cache they see between them.
    // Every column of a batch sees a different range — its own position is the
    // last of them, and a sliding window moves the first — so the tile walks
    // the union and masks each row against its own.
    uint rows = min(BR, p.columns - base);
    uint lo = 0xFFFFFFFFu, hi = 0u;
    for (uint r = 0u; r < rows; r++) {
        uvec4 w = where_[p.block * WHERE_COLUMNS + base + r];
        lo = min(lo, w.y);
        hi = max(hi, w.z);
    }
    uint total = hi - lo + 1u;

#ifdef COOP
    // My row within the score grid. The cores answer the whole thirty-two by
    // thirty-two block, so what is left for a thread is masking four of its
    // cells and folding its row: eight lanes to a row, which keeps the fold
    // inside one cluster and is the widest cluster that gives every thread
    // work.
    uint r0 = t >> 3, cl = t & 7u;
    uvec4 mine = where_[p.block * WHERE_COLUMNS + base + min(r0, rows - 1u)];
    bool live = r0 < rows;
    uint qst = hd + 8u;   // a query row and its slack, in halves
#else
    // My rows and my positions within the score grid. A thread answers the
    // two rows sr and sr + 16 against the two positions sc and sc + 16.
    uint sr = t >> 4, sc = t & 15u;
    uint r0 = sr, r1 = sr + 16u;
    uvec4 mine0 = where_[p.block * WHERE_COLUMNS + base + min(r0, rows - 1u)];
    uvec4 mine1 = where_[p.block * WHERE_COLUMNS + base + min(r1, rows - 1u)];
    bool live0 = r0 < rows, live1 = r1 < rows;
#endif

    // The queries of this tile, as halves. They are fp16-exact already, so the
    // packing costs nothing but the space it saves.
    for (uint idx = t; idx < rows * QW; idx += 256u) {
        uint r = idx >> sh, j = idx & (QW - 1u);
        uint qb = (base + r) * p.heads * hd + h * hd + (j << 3);
#ifdef COOP
        uint qat = r * qst + (j << 3);
        [[unroll]] for (uint u = 0u; u < 8u; u++) qs[qat + u] = float16_t(qh[qb + u]);
#else
        qs[r * QST + j] = uvec4(packHalf2x16(vec2(qh[qb],      qh[qb + 1u])),
                                packHalf2x16(vec2(qh[qb + 2u], qh[qb + 3u])),
                                packHalf2x16(vec2(qh[qb + 4u], qh[qb + 5u])),
                                packHalf2x16(vec2(qh[qb + 6u], qh[qb + 7u])));
#endif
    }

    // The accumulator: thread t carries dimension t of every row, from the
    // first tile to the last, and never writes it to memory in between.
    float acc[BR][DPT];
    for (uint r = 0u; r < BR; r++)
        for (uint u = 0u; u < DPT; u++) acc[r][u] = 0.0;
#ifdef COOP
    float rowMax = -1.0 / 0.0, rowSum = 0.0;
#else
    float rowMax0 = -1.0 / 0.0, rowSum0 = 0.0;
    float rowMax1 = -1.0 / 0.0, rowSum1 = 0.0;
#endif

    uint chunk = min(CW, QW);       // a whole head at a time when it is narrow enough
    uint csh   = findMSB(chunk);
#ifdef COOP
    uint kst  = (chunk + 1u) << 3;  // a key row of one chunk, in halves
    // The four sixteen-by-sixteen tiles of the block, one to a wave.
    uint wave = gl_SubgroupID;
    uint wtr  = wave & 1u, wtc = wave >> 1;
#endif

#ifdef COOP
    for (uint start = 0u; start < total; start += BC) {
        uint got = min(BC, total - start);

        // Q against the keys, on the matrix cores. A wave owns one sixteen by
        // sixteen tile of the block and meets every chunk of the head in it,
        // which is one cooperative multiply for what the scalar form spent a
        // hundred and twenty-eight shared reads on. The keys are staged one
        // row of the cache after another, which is K; the multiply wants K
        // transposed, and a column-major read of the same rows is that.
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> S =
            coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
        for (uint off = 0u; off < QW; off += chunk) {
            barrier();
            for (uint idx = t; idx < got * chunk; idx += 256u) {
                uint c = idx >> csh, j = idx & (chunk - 1u);
                uint o = (entry(lo + start + c, kv) >> 1) + ((off + j) << 2);
                uvec4 raw = uvec4(ck[o], ck[o + 1u], ck[o + 2u], ck[o + 3u]);
                uint at = c * kst + (j << 3);
                [[unroll]] for (uint u = 0u; u < 4u; u++) {
                    vec2 hv = unpackHalf2x16(raw[u]);
                    ks[at + (u << 1)]      = float16_t(hv.x);
                    ks[at + (u << 1) + 1u] = float16_t(hv.y);
                }
            }
            barrier();
            for (uint kk = 0u; kk < (chunk >> 1); kk++) {
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> A;
                coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> B;
                coopMatLoad(A, qs, (wtr << 4) * qst + (off << 3) + (kk << 4), qst,
                            gl_CooperativeMatrixLayoutRowMajor);
                coopMatLoad(B, ks, (wtc << 4) * kst + (kk << 4), kst,
                            gl_CooperativeMatrixLayoutColumnMajor);
                S = coopMatMulAdd(A, B, S);
            }
        }

        // The scores land in pr, which the mix of the tile before is still
        // reading. A thread then owns four cells of one row — its own, and no
        // other thread's — so it can read them, mask them and write the
        // probabilities back over them without a barrier in between.
        barrier();
        coopMatStore(S, pr, (wtr << 4) * BC + (wtc << 4), BC,
                     gl_CooperativeMatrixLayoutRowMajor);
        barrier();

        float sv[4];
        float peak = -1.0 / 0.0;
        [[unroll]] for (uint i = 0u; i < 4u; i++) {
            uint c   = cl + (i << 3);
            uint pos = lo + start + c;
            float v  = (live && c < got && pos >= mine.y && pos <= mine.z)
                        ? pr[r0 * BC + c] * p.scale : -1.0 / 0.0;
            sv[i] = v;
            peak  = max(peak, v);
        }
        float newMax = max(rowMax, subgroupClusteredMax(peak, 8u));
        float mine_  = 0.0;
        [[unroll]] for (uint i = 0u; i < 4u; i++) {
            float pv = isinf(newMax) ? 0.0 : exp(sv[i] - newMax);
            pr[r0 * BC + cl + (i << 3)] = pv;
            mine_ += pv;
        }
        float tileSum = subgroupClusteredAdd(mine_, 8u);
        float rescale = (rowMax == newMax) ? 1.0 : exp(rowMax - newMax);
        if (cl == 0u) corr[r0] = rescale;
        rowSum = rowSum * rescale + tileSum;
        rowMax = newMax;
        barrier();

#else
    for (uint start = 0u; start < total; start += BC) {
        uint got = min(BC, total - start);

        // The four scores this thread carries, accumulated a chunk of
        // dimensions at a time because that is all of the keys that fits.
        float d00 = 0.0, d01 = 0.0, d10 = 0.0, d11 = 0.0;
        for (uint off = 0u; off < QW; off += chunk) {
            barrier();
            for (uint idx = t; idx < got * chunk; idx += 256u) {
                uint c = idx >> csh, j = idx & (chunk - 1u);
                uint o = (entry(lo + start + c, kv) >> 1) + ((off + j) << 2);
                ks[c * CST + j] = uvec4(ck[o], ck[o + 1u], ck[o + 2u], ck[o + 3u]);
            }
            barrier();
            for (uint j = 0u; j < chunk; j++) {
                uvec4 q0 = qs[r0 * QST + off + j];
                uvec4 q1 = qs[r1 * QST + off + j];
                uvec4 k0 = ks[sc * CST + j];
                uvec4 k1 = ks[(sc + 16u) * CST + j];
                [[unroll]] for (uint w = 0u; w < 4u; w++) {
                    vec2 a0 = unpackHalf2x16(q0[w]), a1 = unpackHalf2x16(q1[w]);
                    vec2 b0 = unpackHalf2x16(k0[w]), b1 = unpackHalf2x16(k1[w]);
                    d00 += dot(a0, b0);
                    d01 += dot(a0, b1);
                    d10 += dot(a1, b0);
                    d11 += dot(a1, b1);
                }
            }
        }

        // Which of the four the row's own range admits.
        uint pos0 = lo + start + sc, pos1 = pos0 + 16u;
        float inf = 1.0 / 0.0;
        float s00 = (live0 && sc        < got && pos0 >= mine0.y && pos0 <= mine0.z) ? d00 * p.scale : -inf;
        float s01 = (live0 && sc + 16u  < got && pos1 >= mine0.y && pos1 <= mine0.z) ? d01 * p.scale : -inf;
        float s10 = (live1 && sc        < got && pos0 >= mine1.y && pos0 <= mine1.z) ? d10 * p.scale : -inf;
        float s11 = (live1 && sc + 16u  < got && pos1 >= mine1.y && pos1 <= mine1.z) ? d11 * p.scale : -inf;

        // The online softmax, one clustered fold per row. The two rows a
        // thread carries fold over the same sixteen lanes, one after the other.
        float tileMax0 = subgroupClusteredMax(max(s00, s01), 16u);
        float tileMax1 = subgroupClusteredMax(max(s10, s11), 16u);
        float newMax0  = max(rowMax0, tileMax0);
        float newMax1  = max(rowMax1, tileMax1);
        float p00 = isinf(newMax0) ? 0.0 : exp(s00 - newMax0);
        float p01 = isinf(newMax0) ? 0.0 : exp(s01 - newMax0);
        float p10 = isinf(newMax1) ? 0.0 : exp(s10 - newMax1);
        float p11 = isinf(newMax1) ? 0.0 : exp(s11 - newMax1);
        float tileSum0 = subgroupClusteredAdd(p00 + p01, 16u);
        float tileSum1 = subgroupClusteredAdd(p10 + p11, 16u);
        float rescale0 = (rowMax0 == newMax0) ? 1.0 : exp(rowMax0 - newMax0);
        float rescale1 = (rowMax1 == newMax1) ? 1.0 : exp(rowMax1 - newMax1);

        barrier();
        pr[r0 * BC + sc]        = p00;
        pr[r0 * BC + sc + 16u]  = p01;
        pr[r1 * BC + sc]        = p10;
        pr[r1 * BC + sc + 16u]  = p11;
        if (sc == 0u) { corr[r0] = rescale0; corr[r1] = rescale1; }
        rowSum0 = rowSum0 * rescale0 + tileSum0;
        rowSum1 = rowSum1 * rescale1 + tileSum1;
        rowMax0 = newMax0;
        rowMax1 = newMax1;
        barrier();

#endif
        // The mix, a thread to a dimension. One value read serves all BR rows,
        // which is the other half of what the tiling bought.
        for (uint u = 0u; u < DPT; u++) {
            uint d = t + u * 256u;
            if (d >= hd) break;
            [[unroll]] for (uint r = 0u; r < BR; r++) acc[r][u] *= corr[r];
            uint half_ = d >> 1;
            bool lowHalf = (d & 1u) == 0u;
            [[unroll]] for (uint c = 0u; c < got; c++) {
                vec2 v = unpackHalf2x16(cv[(entry(lo + start + c, kv) >> 1) + half_]);
                float val = lowHalf ? v.x : v.y;
                [[unroll]] for (uint r = 0u; r < BR; r++) acc[r][u] += pr[r * BC + c] * val;
            }
        }
    }

    // The denominators belong to the threads that computed the rows, and the
    // mix runs under the other geometry, so they cross through shared memory
    // once — the only row-wide number of the whole kernel that has to.
    barrier();
#ifdef COOP
    if (cl == 0u && live) sums[r0] = rowSum;
#else
    if (sc == 0u) {
        if (live0) sums[r0] = rowSum0;
        if (live1) sums[r1] = rowSum1;
    }
#endif
    barrier();

    // The Q8_0 form the output projection reads, a block of thirty-two to
    // thirty-two threads. A head is a whole number of blocks, so no block
    // spans two heads, and the fold and the packing are both clustered
    // subgroup reduces — nothing here touches shared memory or takes a
    // barrier. A head wider than the workgroup takes two passes of this, and
    // whether it does is uniform across the workgroup, which is what lets the
    // clustered reduces stand inside the branch.
    uint blocks = (p.heads * hd) >> 5;
    float invSum[BR];
    for (uint r = 0u; r < rows; r++) {
        invSum[r] = (sums[r] > 0.0) ? (1.0 / sums[r]) : 0.0;
    }
    for (uint u = 0u; u < DPT; u++) {
        uint d = t + u * 256u;
        if (d >= hd) break;
        uint slot = ((h * hd) >> 5) + (d >> 5);
        for (uint r = 0u; r < rows; r++) {
            float value = acc[r][u] * invSum[r];

            float peak = subgroupClusteredMax(abs(value), 32u);
            float scale = 0.0;
            int   q = 0;
            if (peak > 0.0) {
                scale = unpackHalf2x16(floatToHalf(peak * (1.0 / 127.0))).x;
                precise float scaled = value * (127.0 / peak);
                q = clamp(nearestInt(scaled), -128, 127);
            }
            int count = subgroupClusteredAdd(q, 32u);

            uint word = subgroupClusteredOr(uint(q & 0xFF) << ((d & 3u) * 8u), 4u);
            uint dest = (((base + r) * p.heads * hd + h * hd) >> 2) + (d >> 2);
            if ((d & 3u) == 0u) aq[dest] = word;

            if ((d & 31u) == 0u) {
                // Scales first, then corrections, which is the layout every
                // kernel here reads an activation in.
                uint cbase = (base + r) * 2u * blocks;
                as_[cbase + slot]          = scale;
                as_[cbase + blocks + slot] = 8.0 * scale * float(count);
            }
        }
    }
}
