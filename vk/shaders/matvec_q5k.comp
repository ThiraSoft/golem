#version 450
#extension GL_KHR_shader_subgroup_clustered : require
#extension GL_EXT_control_flow_attributes : enable

// y = W * x for a Q5_K matrix against float activations. Qwen3.5 quantises the
// delta net's output projection this way, which is the largest single thing in
// the model after the feed forward.
//
// It reads vk/mixture.go's splitQ5_K and not the file's own superblocks. That
// packing gives every block of thirty-two weights a scale, a minimum and a
// word of fifth bits of its own, so this kernel is matvec_q41.comp with one
// more bit a weight — where the format itself bit-slices the fifth bits across
// a superblock and made every reader walk thirty-two bytes to find thirty-two
// of them. The header of splitQ5_K says why that mattered.
//
// Workgroup: 128 threads -> 16 output rows, 8 lanes per row. COLUMNS is
// matvec_q40.comp's: how many activations one reading of the weights answers.

#ifndef COLUMNS
#define COLUMNS 1
#endif

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly  buffer W { uint  w[]; };
layout(std430, binding = 1) readonly  buffer X { float x[]; };
layout(std430, binding = 2) writeonly buffer Y { float y[]; };

layout(push_constant) uniform Push {
    uint dim; // outputs
    uint ffn; // inputs
    uint col; // the first column of the pass this dispatch answers
} p;

const uint LANES = 8u;
const uint OUTS  = 16u;

void main() {
    uint row = gl_WorkGroupID.x * OUTS + (gl_LocalInvocationID.x / LANES);
    uint lane = gl_LocalInvocationID.x % LANES;
    bool live = row < p.dim;
    if (!live) row = 0u;

    uint nb = p.ffn / 32u;
    uint rowBase  = row * nb * 24u;
    uint highBase = rowBase + nb * 4u;
    uint nibBase  = rowBase + nb * 8u;

    float sum[COLUMNS];
    [[unroll]] for (uint c = 0u; c < COLUMNS; c++) sum[c] = 0.0;

    for (uint b = lane; live && b < nb; b += LANES) {
        vec2 dm = unpackHalf2x16(w[(rowBase + 4u * b) >> 2]);
        float d1 = dm.x;
        float m1 = dm.y;
        uint hb = w[(highBase + 4u * b) >> 2];

        uint at = (nibBase + 16u * b) >> 2;
        uvec4 words = uvec4(w[at], w[at + 1u], w[at + 2u], w[at + 3u]);
        uint xOffset = b * 32u;

        [[unroll]] for (uint c = 0u; c < COLUMNS; c++) {
            uint xc = (p.col + c) * p.ffn + xOffset;
            float nibX = 0.0;
            float plainX = 0.0;
            [[unroll]] for (uint u = 0u; u < 4u; u++) {
                uint word = words[u];
                [[unroll]] for (uint i = 0u; i < 4u; i++) {
                    uint j = u * 4u + i;
                    uint byteVal = (word >> (i * 8u)) & 0xFFu;
                    float xL = x[xc + j];
                    float xH = x[xc + j + 16u];
                    float qL = float(byteVal & 0x0Fu) + float((hb >> j) & 1u) * 16.0;
                    float qH = float(byteVal >> 4u)   + float((hb >> (j + 16u)) & 1u) * 16.0;
                    nibX += qL * xL + qH * xH;
                    plainX += xL + xH;
                }
            }
            sum[c] += nibX * d1 - plainX * m1;
        }
    }

    [[unroll]] for (uint c = 0u; c < COLUMNS; c++) {
        float total = subgroupClusteredAdd(sum[c], LANES);
        if (lane == 0u && live) y[(p.col + c) * p.dim + row] = total;
    }
}
