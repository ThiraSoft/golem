#version 450

// Gate-add: x[row][col] += out[row][col] * gate[col],
// where gate is in the arena (the block's gate modulation for this span).

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer W { uint w[]; };
layout(std430, binding = 1) buffer A { float a[]; };
layout(std430, binding = 2) readonly buffer P { float par[]; };

layout(push_constant) uniform Push {
    uint x, xStride;
    uint outIdx, outStride;
    uint gate;
    uint n, rows;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * gl_NumWorkGroups.x * 256u;
    if (i >= p.n * p.rows) return;
    uint row = i / p.n, col = i % p.n;
    uint xi = p.x + row * p.xStride + col;
    uint oi = p.outIdx + row * p.outStride + col;
    a[xi] += a[oi] * a[p.gate + col];
}
