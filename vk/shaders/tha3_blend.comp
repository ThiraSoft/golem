#version 450

// The three blends of tha3/blend.go. Mode 0 is applyColorChange, where an
// alpha of one channel applies to every channel and one of as many channels
// as the image applies channel to channel. Mode 1 is applyRGBChange, which
// keeps the image's alpha channel. Mode 2 is mode 1 with the alpha taken from
// the change's own fourth channel as (a+1)/2, the eyebrow combiner's output 2.

layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer Arena { float a[]; };
layout(std430, binding = 1) readonly buffer Weights { float w[]; };
layout(std430, binding = 2) readonly buffer Pose { float pose[]; };

layout(push_constant) uniform Push {
    uint dst, image, change, alpha, plane, alphaC, mode;
} p;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.plane) return;
    uint c = gl_WorkGroupID.y;
    float im = a[p.image + c * p.plane + i];
    if (p.mode != 0u && c == 3u) {
        a[p.dst + c * p.plane + i] = im;
        return;
    }
    float ch = a[p.change + c * p.plane + i];
    float al;
    if (p.mode == 2u) {
        al = (a[p.change + 3u * p.plane + i] + 1.0) / 2.0;
    } else {
        al = a[p.alpha + (p.alphaC > 1u ? c : 0u) * p.plane + i];
    }
    a[p.dst + c * p.plane + i] = ch * al + im * (1.0 - al);
}
